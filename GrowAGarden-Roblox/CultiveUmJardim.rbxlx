	<Item class="StarterPlayer" referent="RBX00000012">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX00000013">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
