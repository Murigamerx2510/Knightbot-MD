	<Item class="ServerScriptService" referent="RBX00000006">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
		<Item class="Script" referent="RBX00000007">
			<Properties>
				<string name="Name">GardenServer</string>
				<ProtectedString name="Source"><![CDATA[-- GardenServer: script principal do servidor.
-- Cria o mapa, liga os servicos e cuida da entrada/saida dos jogadores.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = require(script.Remotes)
local DataService = require(script.DataService)
local MapBuilder = require(script.MapBuilder)
local Sync = require(script.Sync)
local PetService = require(script.PetService)
local QuestService = require(script.QuestService)
local GardenService = require(script.GardenService)
local ShopService = require(script.ShopService)
local DayNightService = require(script.DayNightService)
local WeatherService = require(script.WeatherService)
local StealService = require(script.StealService)

local map = MapBuilder.build()
GardenService.init(map)
ShopService.init(map)

-- ligacoes entre servicos
GardenService.hooks.steal = StealService.trySteal
GardenService.hooks.bonk = StealService.bonk
GardenService.hooks.snipe = StealService.snipe
GardenService.hooks.consume = StealService.consume
GardenService.hooks.weatherTrigger = function(weatherId)
	WeatherService.trigger(weatherId)
end
PetService.onChanged(GardenService.invalidateBonuses)
Sync.addProvider(function(player, snapshot)
	local data = DataService.get(player)
	if data then
		QuestService.ensure(player, data)
		snapshot.quests = QuestService.snapshot(data)
	end
end)

Sync.start()
GardenService.start()
ShopService.start()
DayNightService.start(map)
WeatherService.start()
StealService.start()

---------------------------------------------------------------------
-- Jogadores
---------------------------------------------------------------------

local function moveCharacter(player: Player, cf: CFrame?)
	local character = player.Character
	if cf and character and character.Parent and character:FindFirstChild("HumanoidRootPart") then
		character:PivotTo(cf)
	end
end

local function onCharacterAdded(player: Player, character: Model)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not root then
		return
	end
	-- CharacterAdded dispara antes do personagem entrar no Workspace
	local start = os.clock()
	while not character.Parent and os.clock() - start < 5 do
		task.wait()
	end
	task.wait(0.1)
	moveCharacter(player, GardenService.getGardenCFrame(player))
	Sync.markDirty(player) -- recria as ferramentas na mochila nova
end

-- Os comandos aceitam nomes sem acento e sem espaco ("luadesangue", "unicornio")
local ACCENTS = {
	["á"] = "a", ["à"] = "a", ["â"] = "a", ["ã"] = "a", ["é"] = "e", ["ê"] = "e", ["í"] = "i",
	["ó"] = "o", ["ô"] = "o", ["õ"] = "o", ["ú"] = "u", ["ç"] = "c",
	["Á"] = "a", ["À"] = "a", ["Â"] = "a", ["Ã"] = "a", ["É"] = "e", ["Ê"] = "e", ["Í"] = "i",
	["Ó"] = "o", ["Ô"] = "o", ["Õ"] = "o", ["Ú"] = "u", ["Ç"] = "c",
}

local function plain(text: string): string
	text = string.lower(text)
	for accented, letter in ACCENTS do
		text = string.gsub(text, accented, letter)
	end
	return (string.gsub(text, "[%s%-]", ""))
end

local function findWeather(name: string)
	name = plain(name)
	for _, weather in Config.WeatherList do
		if plain(weather.id) == name or plain(weather.name) == name then
			return weather
		end
	end
	return nil
end

local function findPet(name: string)
	name = plain(name)
	for _, pet in Config.PetList do
		if plain(pet.id) == name or plain(pet.name) == name then
			return pet
		end
	end
	return nil
end

local function findPetVariant(name: string?): string?
	if not name then
		return nil
	end
	name = plain(name)
	for _, variant in Config.PetVariants do
		if plain(variant.id) == name or (variant.name ~= "" and plain(variant.name) == name) then
			return variant.id
		end
	end
	return nil
end

local function handleCommand(player: Player, message: string)
	local data = DataService.get(player)
	if not data then
		return
	end
	local words = string.split(string.lower(message), " ")
	local command = words[1]
	if command == "/sheckles" or command == "/dinheiro" then
		local amount = tonumber(words[2]) or 100000
		data.sheckles += math.floor(amount)
		Sync.notify(player, "[Teste] +" .. amount .. " Sheckles", "info")
	elseif command == "/clima" then
		local wanted = table.concat(words, "", 2)
		if wanted == "parar" then
			WeatherService.stopEvent()
		else
			local weather = findWeather(wanted)
			if weather then
				WeatherService.startEvent(weather.id)
			else
				Sync.notify(player, "[Teste] Clima não encontrado. Ex.: /clima chuva, /clima luadesangue, /clima eclipse", "error")
			end
		end
	elseif command == "/noite" then
		DayNightService.skipTo("Night")
		Sync.notify(player, "[Teste] Virou noite!", "info")
	elseif command == "/dia" then
		DayNightService.skipTo("Day")
		Sync.notify(player, "[Teste] Virou dia!", "info")
	elseif command == "/crescer" then
		GardenService.growAll(player)
		Sync.notify(player, "[Teste] Todas as plantas cresceram!", "info")
	elseif command == "/estoque" then
		ShopService.fillStock(data)
		Sync.notify(player, "[Teste] Estoque das lojas cheio!", "info")
	elseif command == "/pet" then
		-- "/pet libelula dourada mega": a ultima palavra pode ser a variante
		local variantId = findPetVariant(words[#words])
		local last = if variantId and #words > 2 then #words - 1 else #words
		local pet = findPet(table.concat(words, "", 2, last))
		if pet then
			PetService.addPet(player, data, pet.id, variantId)
			Sync.notify(player, "[Teste] Pet " .. pet.name .. " adicionado!", "info")
		else
			Sync.notify(player, "[Teste] Pet não encontrado. Ex.: /pet unicornio, /pet dragao mega", "error")
		end
	end
	Sync.markDirty(player)
end

local function onPlayerAdded(player: Player)
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	-- ao renascer o Roblox cria uma mochila nova: recria as ferramentas
	player.ChildAdded:Connect(function(child)
		if child:IsA("Backpack") then
			Sync.markDirty(player)
		end
	end)

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local sheckles = Instance.new("IntValue")
	sheckles.Name = "Sheckles"
	sheckles.Value = 0
	sheckles.Parent = leaderstats
	leaderstats.Parent = player

	local data, canSave = DataService.load(player)
	if not player.Parent then
		DataService.release(player)
		return
	end
	ShopService.ensureStock(data)
	PetService.setup(player, data)
	QuestService.ensure(player, data)
	if not GardenService.assignPlot(player, data) then
		DataService.release(player)
		player:Kick("Este servidor está cheio (máximo de 6 jardins). Tente outro servidor!")
		return
	end
	Sync.markDirty(player)
	Sync.notify(player, "Bem-vindo(a) ao " .. Config.GameName .. "! Compre sementes com o Sam e plante no seu jardim.", "info")
	if not canSave then
		Sync.notify(player, "⚠️ Salvamento indisponível: seu progresso NÃO será salvo nesta sessão.", "error")
	end
	if RunService:IsStudio() then
		Sync.notify(player, "Modo Studio: /sheckles 1000, /crescer, /estoque, /noite, /dia, /clima chuva, /pet unicornio", "info")
		player.Chatted:Connect(function(message)
			handleCommand(player, message)
		end)
	end
	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
	end
end

local function onPlayerRemoving(player: Player)
	DataService.save(player)
	DataService.release(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

-- salvamento automatico
task.spawn(function()
	while true do
		task.wait(Config.AutoSaveInterval)
		for _, player in DataService.getPlayers() do
			task.spawn(DataService.save, player)
		end
	end
end)

game:BindToClose(function()
	DataService.saveAll(25)
end)

---------------------------------------------------------------------
-- Pedidos do cliente
---------------------------------------------------------------------

local function safe(handler: (...any) -> (boolean, string))
	return function(...)
		local ok, success, message = pcall(handler, ...)
		if ok then
			return success, message
		end
		warn("[Jardim] Erro: " .. tostring(success))
		return false, "Erro no servidor. Tente novamente."
	end
end

Remotes.Buy.OnServerInvoke = safe(ShopService.buy)
Remotes.Sell.OnServerInvoke = safe(ShopService.sell)
Remotes.PetAction.OnServerInvoke = safe(PetService.handleAction)
Remotes.QuestAction.OnServerInvoke = safe(QuestService.claim)

Remotes.UseItem.OnServerEvent:Connect(function(player, kind, id, position)
	GardenService.useItem(player, kind, id, position)
end)

local lastTeleport: { [Player]: number } = {}
Remotes.Teleport.OnServerEvent:Connect(function(player, place)
	if type(place) ~= "string" then
		return
	end
	if StealService.isCarrying(player) then
		Sync.notify(player, "Você não pode se teletransportar carregando um fruto roubado!", "error")
		return
	end
	local now = os.clock()
	if lastTeleport[player] and now - lastTeleport[player] < 0.8 then
		return
	end
	lastTeleport[player] = now
	local cf = if place == "Garden" then GardenService.getGardenCFrame(player) else map.locations[place]
	moveCharacter(player, cf)
end)

Players.PlayerRemoving:Connect(function(player)
	lastTeleport[player] = nil
end)

print("[Jardim] Servidor pronto!")
]]></ProtectedString>
			</Properties>
			<Item class="ModuleScript" referent="RBX00000008">
				<Properties>
					<string name="Name">DataService</string>
					<ProtectedString name="Source"><![CDATA[-- DataService: carrega e salva o progresso dos jogadores com DataStore.
-- Se o DataStore nao estiver disponivel (ex.: Studio sem acesso a API),
-- o jogo continua funcionando, apenas sem salvar.

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local DataService = {}

type Profile = {
	data: { [string]: any },
	key: string,
	canSave: boolean,
	saving: boolean,
	userId: number,
}

local profiles: { [Player]: Profile } = {}

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[Jardim] DataStore indisponível, o progresso não será salvo: " .. tostring(result))
	end
end

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end

function DataService.defaultData()
	return {
		version = 2,
		sheckles = Config.StartingSheckles,
		seeds = deepCopy(Config.StartingSeeds),
		gear = {},
		eggs = {},
		fruits = {},
		plants = {},
		sprinklers = {},
		props = {},
		placedEggs = {},
		pets = {},
		equippedPets = {},
		stock = { window = -1, seeds = {}, gear = {}, eggs = {} },
		quests = { day = -1, list = {} },
		nextId = 1,
		stats = { harvested = 0, earned = 0, planted = 0, sold = 0, stolen = 0, stolenFrom = 0, hatched = 0, merged = 0 },
	}
end

-- Troca ids antigos (de versoes anteriores) pelos novos
local function migrateIds(map: { [string]: any }, legacy: { [string]: string })
	for oldId, newId in legacy do
		local count = map[oldId]
		if type(count) == "number" then
			map[oldId] = nil
			map[newId] = (map[newId] or 0) + count
		end
	end
end

-- Garante que dados antigos tenham todos os campos novos
-- e remove itens que nao existem mais na Config.
local function reconcile(data)
	local template = DataService.defaultData()
	for key, value in template do
		if data[key] == nil or type(data[key]) ~= type(value) then
			data[key] = deepCopy(value)
		end
	end
	for _, key in { "stock", "stats", "quests" } do
		for subKey, value in template[key] do
			if data[key][subKey] == nil then
				data[key][subKey] = deepCopy(value)
			end
		end
	end
	migrateIds(data.gear, Config.LegacyIds.gear)
	migrateIds(data.seeds, Config.LegacyIds.seeds)
	for _, key in { "seeds", "gear", "eggs" } do
		for id, count in data[key] do
			if type(count) ~= "number" or count <= 0 then
				data[key][id] = nil
			end
		end
	end
	for id in data.seeds do
		if not Config.Seeds[id] then
			data.seeds[id] = nil
		end
	end
	for id in data.gear do
		if not Config.Gear[id] then
			data.gear[id] = nil
		end
	end
	for id in data.eggs do
		if not Config.Eggs[id] then
			data.eggs[id] = nil
		end
	end
	for i = #data.plants, 1, -1 do
		local plant = data.plants[i]
		if type(plant) == "table" and Config.LegacyIds.seeds[plant.s] then
			plant.s = Config.LegacyIds.seeds[plant.s]
		end
		local seed = type(plant) == "table" and Config.Seeds[plant.s]
		local valid = seed
			and type(plant.x) == "number"
			and type(plant.z) == "number"
			and type(plant.p) == "number"
			and (if seed.multiHarvest then type(plant.slots) == "table" else type(plant.f) == "table")
		if not valid then
			table.remove(data.plants, i)
		else
			plant.b = if type(plant.b) == "number" then plant.b else 0
			if plant.v ~= nil and type(plant.v) ~= "string" then
				plant.v = nil
			end
			local fruits = if seed.multiHarvest then plant.slots else { plant.f }
			for _, fruit in fruits do
				if type(fruit.m) ~= "table" then
					fruit.m = {}
				end
				if type(fruit.w) ~= "number" then
					fruit.w = seed.baseWeight
				end
				if type(fruit.a) ~= "number" then
					fruit.a = 0
				end
			end
		end
	end
	for i = #data.fruits, 1, -1 do
		local fruit = data.fruits[i]
		if type(fruit) == "table" and Config.LegacyIds.seeds[fruit.s] then
			fruit.s = Config.LegacyIds.seeds[fruit.s]
		end
		if type(fruit) ~= "table" or not Config.Seeds[fruit.s] or type(fruit.w) ~= "number" then
			table.remove(data.fruits, i)
		elseif type(fruit.m) ~= "table" then
			fruit.m = {}
		end
	end
	for i = #data.sprinklers, 1, -1 do
		local sprinkler = data.sprinklers[i]
		if type(sprinkler) == "table" and Config.LegacyIds.gear[sprinkler.g] then
			sprinkler.g = Config.LegacyIds.gear[sprinkler.g]
		end
		if type(sprinkler) ~= "table" or not Config.Gear[sprinkler.g] then
			table.remove(data.sprinklers, i)
		end
	end
	for i = #data.props, 1, -1 do
		local prop = data.props[i]
		if type(prop) ~= "table" or not Config.Gear[prop.g] then
			table.remove(data.props, i)
		end
	end
	for i = #data.placedEggs, 1, -1 do
		local egg = data.placedEggs[i]
		if type(egg) ~= "table" or not Config.Eggs[egg.e] then
			table.remove(data.placedEggs, i)
		end
	end
	for i = #data.pets, 1, -1 do
		local pet = data.pets[i]
		if type(pet) == "table" and Config.LegacyIds.pets[pet.p] then
			pet.p = Config.LegacyIds.pets[pet.p]
		end
		if type(pet) ~= "table" or not Config.Pets[pet.p] then
			table.remove(data.pets, i)
		else
			pet.xp = if type(pet.xp) == "number" then pet.xp else 0
			if pet.v ~= nil and type(pet.v) ~= "string" then
				pet.v = nil
			end
		end
	end
	if type(data.quests.list) ~= "table" then
		data.quests.list = {}
	end
	-- o maior id em uso define o proximo id livre
	local maxId = 0
	for _, list in { data.plants, data.sprinklers, data.props, data.placedEggs, data.pets } do
		for _, item in list do
			if type(item.id) == "number" then
				maxId = math.max(maxId, item.id)
			end
		end
	end
	data.nextId = math.max(data.nextId, maxId + 1)
	data.version = 2
	return data
end

-- Erro de "Studio sem acesso a API": nao adianta tentar de novo
local function isStudioAccessError(message: string): boolean
	return string.find(message, "StudioAccessToApisNotAllowed", 1, true) ~= nil
		or string.find(message, "403", 1, true) ~= nil
end

-- Carrega os dados do jogador (pode demorar alguns segundos)
function DataService.load(player: Player): ({ [string]: any }, boolean)
	local key = "Jogador_" .. player.UserId
	local data = nil
	local loaded = false
	if store then
		for attempt = 1, 3 do
			local ok, result = pcall(function()
				return store:GetAsync(key)
			end)
			if ok then
				data = result
				loaded = true
				break
			end
			warn(string.format("[Jardim] Falha ao carregar dados de %s (tentativa %d): %s", player.Name, attempt, tostring(result)))
			if isStudioAccessError(tostring(result)) then
				break
			end
			task.wait(attempt * 1.5)
		end
	end
	if type(data) == "table" then
		data = reconcile(data)
	else
		data = DataService.defaultData()
	end
	profiles[player] = {
		data = data,
		key = key,
		canSave = loaded and store ~= nil,
		saving = false,
		userId = player.UserId,
	}
	return data, loaded and store ~= nil
end

function DataService.get(player: Player): { [string]: any }?
	local profile = profiles[player]
	return if profile then profile.data else nil
end

function DataService.save(player: Player): boolean
	local profile = profiles[player]
	if not profile or not profile.canSave or not store then
		return false
	end
	while profile.saving do
		task.wait(0.1)
	end
	profile.saving = true
	local success = false
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			store:SetAsync(profile.key, profile.data, { profile.userId })
		end)
		if ok then
			success = true
			break
		end
		warn(string.format("[Jardim] Falha ao salvar dados de %s (tentativa %d): %s", player.Name, attempt, tostring(err)))
		task.wait(attempt)
	end
	profile.saving = false
	return success
end

function DataService.release(player: Player)
	profiles[player] = nil
end

function DataService.getPlayers(): { Player }
	local list = {}
	for player in profiles do
		table.insert(list, player)
	end
	return list
end

-- Salva todos quando o servidor fecha
function DataService.saveAll(timeout: number)
	local pending = 0
	for player in profiles do
		pending += 1
		task.spawn(function()
			DataService.save(player)
			pending -= 1
		end)
	end
	local start = os.clock()
	while pending > 0 and os.clock() - start < timeout do
		task.wait(0.1)
	end
end

return DataService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000009">
				<Properties>
					<string name="Name">DayNightService</string>
					<ProtectedString name="Source"><![CDATA[-- DayNightService: ciclo de dia (7,5 min), por do sol (30 s) e noite (2 min), igual ao GAG2.
-- A noite libera os roubos, acende os postes e deixa frutos Lunares.
-- O ciclo usa os.time(), entao e o mesmo em todos os servidores.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Formulas = require(Shared:WaitForChild("Formulas"))
local GardenService = require(script.Parent.GardenService)
local Sync = require(script.Parent.Sync)

local DayNightService = {}

local offset = 0 -- usado pelos comandos de teste para pular de fase
local currentPhase = ""
local currentIndex = -1
local listeners: { (string, number) -> () } = {}
local lights: { PointLight } = {}

function DayNightService.now(): number
	return os.time() + offset
end

function DayNightService.getPhase(): (string, number, number, number)
	return Formulas.dayPhase(DayNightService.now())
end

function DayNightService.isNight(): boolean
	return (DayNightService.getPhase()) == "Night"
end

-- callback(fase, numeroDoCiclo) quando a fase muda
function DayNightService.onPhaseChanged(callback: (string, number) -> ())
	table.insert(listeners, callback)
end

-- Comando de teste: pula para o inicio de uma fase
function DayNightService.skipTo(phaseName: string)
	local dn = Config.DayNight
	local cycle = dn.dayLength + dn.sunsetLength + dn.nightLength
	local target = if phaseName == "Night" then dn.dayLength + dn.sunsetLength elseif phaseName == "Sunset" then dn.dayLength else 0
	local t = DayNightService.now() % cycle
	local delta = (target - t) % cycle
	offset += delta + 0.01
end

local function update()
	local phase, remaining, clockTime, index = DayNightService.getPhase()
	Lighting.ClockTime = clockTime
	workspace:SetAttribute("Phase", phase)
	workspace:SetAttribute("PhaseEnds", os.time() + remaining)
	if phase ~= currentPhase or index ~= currentIndex then
		local previous = currentPhase
		currentPhase = phase
		currentIndex = index
		GardenService.setPhase(phase, index)
		for _, light in lights do
			light.Enabled = phase ~= "Day"
		end
		if previous ~= "" then
			if phase == "Night" then
				Sync.notifyAll("🌙 A noite chegou! Ladrões podem roubar jardins sem o dono por perto. Fique no seu jardim ou use defesas!", "rare")
			elseif phase == "Day" then
				Sync.notifyAll("☀️ Amanheceu! Os jardins estão seguros de novo.", "info")
			end
		end
		for _, callback in listeners do
			task.spawn(callback, phase, index)
		end
	end
	return phase
end

function DayNightService.start(map)
	lights = map.lights or {}
	workspace:SetAttribute("StealingEnabled", Config.Stealing.enabled)
	update()
	task.spawn(function()
		local elapsed = 0
		while true do
			task.wait(0.5)
			elapsed += 0.5
			local ok, result = pcall(update)
			if not ok then
				warn("[Jardim] Erro no ciclo do dia: " .. tostring(result))
			elseif result == "Night" and elapsed >= 1 then
				elapsed = 0
				GardenService.applyWeatherMutation("Moonlit", Config.DayNight.moonlitChance)
			end
		end
	end)
end

return DayNightService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000A">
				<Properties>
					<string name="Name">GardenService</string>
					<ProtectedString name="Source"><![CDATA[-- GardenService: jardins dos jogadores, plantio, crescimento, colheita, itens
-- (regador, pa, espatula, sprinklers, lanternas, gnomos, ovos) e habilidades dos pets.
--
-- O crescimento usa os.time(), entao as plantas continuam crescendo
-- mesmo com o jogador offline.
--   idade da planta = agora - plantadaEm + bonus
-- Clima, sprinklers, regador, lanternas e pets aumentam o "bonus".
--
-- Crescimento visivel: broto na terra -> planta jovem que vai crescendo -> adulta.
-- Os frutos nascem pequenos e verdes, crescem e mudam para a cor final ao amadurecer.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Formulas = require(Shared:WaitForChild("Formulas"))
local MapBuilder = require(script.Parent.MapBuilder)
local PetService = require(script.Parent.PetService)
local QuestService = require(script.Parent.QuestService)
local Sync = require(script.Parent.Sync)
local Visuals = require(script.Parent.Visuals)

local GardenService = {}

-- Ganchos ligados pelo script principal (evita dependencias circulares)
GardenService.hooks = {
	steal = nil :: ((Player, any, any, number?) -> ())?,
	bonk = nil :: ((Player) -> boolean)?,
	snipe = nil :: ((Player, any, Vector3?) -> ())?,
	consume = nil :: ((Player, any) -> boolean)?,
	weatherTrigger = nil :: ((string) -> ())?,
}

local L = MapBuilder.Layout
local rng = Random.new()
local plots = {}
local gardens: { [Player]: any } = {}
local weather = { growthBonus = 0, goldBoost = 1, rainbowBoost = 1, sizeBoost = 0 }
local phase = "Day"
local nightIndex = 0

local function round2(n: number): number
	return math.floor(n * 100 + 0.5) / 100
end

local function plantAge(plant, now: number): number
	return now - plant.p + plant.b
end

local function weightScale(seed, weight: number): number
	return math.clamp((weight / seed.baseWeight) ^ (1 / 3), 0.7, 1.8)
end

local function fruitLabel(seed, weight: number, mutations: { string }, variantId: string?): string
	local text = string.format("%s (%s)", Formulas.fruitName(seed.id, variantId), Formulas.formatWeight(weight))
	local names = Formulas.mutationNames(mutations)
	if names ~= "" then
		text = "[" .. names .. "] " .. text
	end
	return text
end

local function makePrompt(parent: Instance, action: string, objectText: string, ownerId: number, kind: string): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = objectText
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt:SetAttribute("OwnerUserId", ownerId)
	prompt:SetAttribute("Kind", kind)
	prompt.Parent = parent
	return prompt
end

local function primaryOf(model: Model): BasePart?
	if model.PrimaryPart then
		return model.PrimaryPart
	end
	return model:FindFirstChildWhichIsA("BasePart", true)
end

local function inBeds(lx: number, lz: number): boolean
	local ax = math.abs(lx)
	return ax >= L.bedInner + 0.4 and ax <= L.bedOuter - 0.4 and lz >= L.bedZMin + 0.4 and lz <= L.bedZMax - 0.4
end

local function inPlot(lx: number, lz: number): boolean
	return math.abs(lx) <= L.plotHalfX - 1 and math.abs(lz) <= L.plotHalfZ - 1
end

local function groundHeight(lx: number, lz: number): number
	return if inBeds(lx, lz) then L.bedTop else 0.15
end

local function isValidVector(value: any): boolean
	return typeof(value) == "Vector3"
		and value.X == value.X
		and value.Y == value.Y
		and value.Z == value.Z
		and value.Magnitude < 100000
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

-- Converte a posicao clicada para coordenadas locais do jardim.
-- Se o clique for invalido, tenta a posicao na frente do personagem.
local function resolvePosition(garden, position: any, check: (number, number) -> boolean): (number?, number?)
	if isValidVector(position) then
		local localPos = garden.plot.cframe:PointToObjectSpace(position)
		if check(localPos.X, localPos.Z) then
			return localPos.X, localPos.Z
		end
	end
	local root = rootOf(garden.player)
	if root then
		local front = root.Position + root.CFrame.LookVector * 2.5
		local localPos = garden.plot.cframe:PointToObjectSpace(front)
		if check(localPos.X, localPos.Z) then
			return localPos.X, localPos.Z
		end
	end
	return nil, nil
end

local function isFarFromEverything(garden, lx: number, lz: number, plantSpacing: number, eggSpacing: number, ignorePlantId: number?): boolean
	local plantMin = plantSpacing * plantSpacing
	for _, plant in garden.data.plants do
		if plant.id ~= ignorePlantId then
			local dx, dz = plant.x - lx, plant.z - lz
			if dx * dx + dz * dz < plantMin then
				return false
			end
		end
	end
	local eggMin = eggSpacing * eggSpacing
	for _, list in { garden.data.placedEggs, garden.data.props } do
		for _, item in list do
			local dx, dz = item.x - lx, item.z - lz
			if dx * dx + dz * dz < eggMin then
				return false
			end
		end
	end
	return true
end

local function bonusesOf(garden)
	if not garden.bonuses then
		garden.bonuses = Formulas.petBonuses(garden.data.pets, garden.data.equippedPets)
	end
	return garden.bonuses
end

local function luckOf(garden): number
	local bonuses = bonusesOf(garden)
	return bonuses.Luck + (if phase == "Night" then bonuses.NightLuck else 0)
end

-- Bonus de tamanho para frutos novos (pets, clima e sprinklers por perto)
local function sizeBonusFor(garden, plant): number
	local bonus = bonusesOf(garden).Size + weather.sizeBoost
	local best = 0
	for _, entry in garden.data.sprinklers do
		local gear = Config.Gear[entry.g]
		if gear and gear.size then
			local dx, dz = plant.x - entry.x, plant.z - entry.z
			if dx * dx + dz * dz <= gear.radius * gear.radius then
				best = math.max(best, gear.size)
			end
		end
	end
	return bonus + best
end

local function newFruit(garden, plant, seed, startAge: number?)
	local luck = luckOf(garden)
	local bonuses = bonusesOf(garden)
	local mutations = Formulas.rollGrowthMutations(
		rng,
		luck,
		(1 + bonuses.Gold) * weather.goldBoost,
		(1 + bonuses.Rainbow) * weather.rainbowBoost
	)
	local special = seed.special or {}
	if special.alwaysMutation then
		Formulas.addMutation(mutations, special.alwaysMutation)
	end
	if special.fruitMutations then
		for id, chance in special.fruitMutations do
			if rng:NextNumber() < chance * (1 + luck) then
				Formulas.addMutation(mutations, id)
			end
		end
	end
	return {
		a = startAge or 0,
		w = Formulas.rollWeight(seed, rng, sizeBonusFor(garden, plant)),
		m = mutations,
	}
end

-- Executa callback(listaDeMutacoes) para cada fruto visivel da planta
local function forEachVisibleFruit(plant, now: number, callback: ({ string }) -> ())
	local seed = Config.Seeds[plant.s]
	if not seed then
		return
	end
	if not seed.multiHarvest then
		callback(plant.f.m)
		return
	end
	local age = plantAge(plant, now)
	if age < seed.growTime then
		return
	end
	for _, slot in plant.slots do
		if age - slot.a > 0 then
			callback(slot.m)
		end
	end
end

local function applyChanceToPlant(plant, mutationId: string, chance: number, now: number)
	forEachVisibleFruit(plant, now, function(list)
		if rng:NextNumber() < chance then
			Formulas.addMutation(list, mutationId)
		end
	end)
end

local function capacityOf(garden): number
	return Config.MaxFruitsInInventory + math.max(0, bonusesOf(garden).Inventory)
end

---------------------------------------------------------------------
-- Visual das plantas
---------------------------------------------------------------------

local onPromptTriggered: (Player, any, any, number?) -> ()

local function destroyFruitView(view, index: number)
	local fruitView = view.fruits[index]
	if fruitView then
		fruitView.model:Destroy()
		view.fruits[index] = nil
	end
end

local function createFruitView(view, index: number, slot)
	local seed = view.seed
	local model = Visuals.buildFruit(seed)
	model.Name = "Fruto" .. index
	Visuals.applyVariant(Visuals.produceParts(model), seed, view.plant.v)
	local offset = view.offsets[index] or Vector3.new(0, seed.height * 0.5, 0)
	model:PivotTo(view.baseCF * CFrame.new(offset))
	model:SetAttribute("Weight", slot.w)
	model:SetAttribute("Size", Formulas.sizeClass(seed.id, slot.w))
	model.Parent = view.container
	local fruitView = { model = model, step = -1, signature = nil, prompt = nil, slot = slot }
	view.fruits[index] = fruitView
	return fruitView
end

local function updatePlantView(garden, view, now: number)
	local plant, seed = view.plant, view.seed
	local age = plantAge(plant, now)
	local growth = math.clamp(age / seed.growTime, 0, 1)
	local sproutUntil = Config.Growth.sproutUntil

	-- 1) broto
	if growth < sproutUntil then
		if not view.sprout then
			view.sprout = Visuals.buildSprout(seed)
			view.sprout:PivotTo(view.baseCF)
			view.sprout.Parent = view.container
			view.sproutStep = -1
		end
		if view.body.Parent then
			view.body.Parent = nil
		end
		local sproutStep = math.floor(growth / sproutUntil * 5)
		if sproutStep ~= view.sproutStep then
			view.sproutStep = sproutStep
			view.sprout:ScaleTo(0.5 + 0.1 * sproutStep)
			view.container:SetAttribute("Progress", math.floor(growth * 100))
		end
		return
	end
	if view.sprout then
		view.sprout:Destroy()
		view.sprout = nil
	end
	if not view.body.Parent then
		view.body.Parent = view.container
	end

	-- 2) planta crescendo
	local steps = Config.Growth.steps
	local step = math.floor(growth * steps)
	if step ~= view.scaleStep then
		view.scaleStep = step
		local scale = 0.2 + 0.8 * step / steps
		if not seed.multiHarvest then
			scale *= weightScale(seed, plant.f.w)
		end
		view.body:ScaleTo(scale)
		view.container:SetAttribute("Progress", math.floor(growth * 100))
		if not seed.multiHarvest and view.signature == "" then
			Visuals.setRipeness(Visuals.produceParts(view.body), growth)
		end
	end

	if not seed.multiHarvest then
		local signature = table.concat(plant.f.m, ",")
		if signature ~= view.signature then
			view.signature = signature
			local parts = Visuals.produceParts(view.body)
			Visuals.applyMutations(parts, plant.f.m)
			if signature == "" then
				Visuals.setRipeness(parts, growth)
			end
			view.container:SetAttribute("Mutations", Formulas.mutationNames(plant.f.m))
			if view.prompt then
				view.prompt.ObjectText = fruitLabel(seed, plant.f.w, plant.f.m, plant.v)
			end
		end
		if growth >= 1 and not view.prompt then
			local target = Visuals.produceParts(view.body)[1] or primaryOf(view.body)
			if target then
				local prompt = makePrompt(target, "Colher", fruitLabel(seed, plant.f.w, plant.f.m, plant.v), garden.player.UserId, "Harvest")
				prompt.Triggered:Connect(function(who)
					onPromptTriggered(who, garden, view, nil)
				end)
				view.prompt = prompt
				view.container:SetAttribute("Ripe", true)
			end
		end
		return
	end

	-- 3) frutos das plantas de varias colheitas
	if growth < 1 then
		return
	end
	local fruitSteps = Config.Growth.fruitSteps
	for index, slot in plant.slots do
		local progress = (age - slot.a) / seed.fruitTime
		local fruitView = view.fruits[index]
		if fruitView and fruitView.slot ~= slot then
			destroyFruitView(view, index)
			fruitView = nil
		end
		if progress <= 0 then
			if fruitView then
				destroyFruitView(view, index)
			end
		else
			if not fruitView then
				fruitView = createFruitView(view, index, slot)
			end
			local signature = table.concat(slot.m, ",")
			local fruitStep = math.floor(math.clamp(progress, 0, 1) * fruitSteps)
			if fruitStep ~= fruitView.step then
				fruitView.step = fruitStep
				fruitView.model:ScaleTo(weightScale(seed, slot.w) * (0.25 + 0.75 * fruitStep / fruitSteps))
				if signature == "" then
					Visuals.setRipeness(Visuals.produceParts(fruitView.model), fruitStep / fruitSteps)
				end
			end
			if signature ~= fruitView.signature then
				fruitView.signature = signature
				local parts = Visuals.produceParts(fruitView.model)
				Visuals.applyMutations(parts, slot.m)
				if signature == "" then
					Visuals.setRipeness(parts, fruitStep / fruitSteps)
				end
				fruitView.model:SetAttribute("Mutations", Formulas.mutationNames(slot.m))
				if fruitView.prompt then
					fruitView.prompt.ObjectText = fruitLabel(seed, slot.w, slot.m, plant.v)
				end
			end
			if progress >= 1 and not fruitView.prompt then
				local target = primaryOf(fruitView.model)
				if target then
					local slotIndex = index
					local prompt = makePrompt(target, "Colher", fruitLabel(seed, slot.w, slot.m, plant.v), garden.player.UserId, "Harvest")
					prompt.Triggered:Connect(function(who)
						onPromptTriggered(who, garden, view, slotIndex)
					end)
					fruitView.prompt = prompt
					fruitView.model:SetAttribute("Ripe", true)
				end
			end
		end
	end
end

local function createPlantView(garden, plant)
	local seed = Config.Seeds[plant.s]
	if not seed then
		return
	end
	local plot = garden.plot
	local yaw = (plant.id * 2.399) % (math.pi * 2)
	local baseCF = plot.cframe * CFrame.new(plant.x, L.bedTop, plant.z) * CFrame.Angles(0, yaw, 0)
	local container = Instance.new("Model")
	container.Name = Formulas.fruitName(seed.id, plant.v)
	container:SetAttribute("PlantId", plant.id)
	container:SetAttribute("SeedId", seed.id)
	container:SetAttribute("OwnerUserId", garden.player.UserId)
	if plant.v then
		container:SetAttribute("Variant", plant.v)
	end
	if not seed.multiHarvest then
		container:SetAttribute("Weight", plant.f.w)
		container:SetAttribute("Size", Formulas.sizeClass(seed.id, plant.f.w))
	end
	if seed.defense then
		container:SetAttribute("Defense", seed.defense.kind)
	end
	local body = Visuals.buildPlant(seed)
	Visuals.applyVariant(Visuals.produceParts(body), seed, plant.v)
	body:PivotTo(baseCF)
	container.Parent = plot.plantsFolder
	local view = {
		plant = plant,
		seed = seed,
		container = container,
		body = body,
		sprout = nil,
		sproutStep = -1,
		baseCF = baseCF,
		scaleStep = -1,
		signature = nil,
		prompt = nil,
		fruits = {},
		offsets = Visuals.fruitOffsets(seed),
		destroyed = false,
	}
	garden.plantViews[plant.id] = view
	updatePlantView(garden, view, os.time())
end

local function destroyPlantView(garden, plantId: number)
	local view = garden.plantViews[plantId]
	if view then
		view.destroyed = true
		view.container:Destroy()
		if view.body then
			view.body:Destroy()
		end
		garden.plantViews[plantId] = nil
	end
end

local function removePlant(garden, plantId: number)
	local plants = garden.data.plants
	for i = #plants, 1, -1 do
		if plants[i].id == plantId then
			table.remove(plants, i)
		end
	end
	destroyPlantView(garden, plantId)
end

---------------------------------------------------------------------
-- Colheita
---------------------------------------------------------------------

local function isFruitRipe(view, slotIndex: number?, now: number): boolean
	if view.destroyed then
		return false
	end
	local plant, seed = view.plant, view.seed
	local age = plantAge(plant, now)
	if slotIndex == nil then
		return not seed.multiHarvest and age >= seed.growTime
	end
	local slot = plant.slots[slotIndex]
	return seed.multiHarvest and slot ~= nil and age >= seed.growTime and age - slot.a >= seed.fruitTime
end

-- Tira o fruto da planta (colheita ou roubo). Retorna o fruto ou nil.
function GardenService.takeFruit(garden, view, slotIndex: number?)
	local now = os.time()
	if not isFruitRipe(view, slotIndex, now) then
		return nil
	end
	local plant, seed = view.plant, view.seed
	local fruit
	if slotIndex == nil then
		fruit = { s = seed.id, w = plant.f.w, m = table.clone(plant.f.m), v = plant.v }
		removePlant(garden, plant.id)
	else
		local slot = plant.slots[slotIndex]
		fruit = { s = seed.id, w = slot.w, m = table.clone(slot.m), v = plant.v }
		plant.slots[slotIndex] = newFruit(garden, plant, seed, plantAge(plant, now))
		destroyFruitView(view, slotIndex)
	end
	return fruit
end

-- Coloca um fruto no inventario (false se a mochila estiver cheia)
function GardenService.addFruit(player: Player, fruit): boolean
	local garden = gardens[player]
	if not garden then
		return false
	end
	if #garden.data.fruits >= capacityOf(garden) then
		return false
	end
	table.insert(garden.data.fruits, fruit)
	Sync.markDirty(player)
	return true
end

-- Colheita pelo dono (ou pelos pets do dono)
local function ownerHarvest(garden, view, slotIndex: number?, source: string?): any
	local player = garden.player
	local data = garden.data
	if #data.fruits >= capacityOf(garden) then
		if not source then
			Sync.notify(player, "Sua mochila está cheia! Venda seus frutos para o Steven.", "error")
		end
		return nil
	end
	local seed = view.seed
	local fruit = GardenService.takeFruit(garden, view, slotIndex)
	if not fruit then
		return nil
	end
	table.insert(data.fruits, fruit)
	data.stats.harvested += 1
	QuestService.progress(player, "harvest", 1)
	if #fruit.m > 0 then
		QuestService.progress(player, "mutated", 1)
	end
	Sync.markDirty(player)
	local label = fruitLabel(seed, fruit.w, fruit.m, fruit.v)
	if source then
		Sync.notify(player, source .. " colheu: " .. label, "info")
	else
		Sync.notify(player, "+ " .. label, if #fruit.m > 0 or fruit.v then "rare" else "success")
	end
	local special = seed.special or {}
	if special.triggersWeather and GardenService.hooks.weatherTrigger then
		GardenService.hooks.weatherTrigger(special.triggersWeather)
	end
	return fruit
end

onPromptTriggered = function(who: Player, garden, view, slotIndex: number?)
	if gardens[garden.player] ~= garden or view.destroyed then
		return
	end
	if who ~= garden.player then
		if GardenService.hooks.steal then
			GardenService.hooks.steal(who, garden, view, slotIndex)
		end
		return
	end
	ownerHarvest(garden, view, slotIndex, nil)
end

-- Frutos maduros do jardim: { {view, slot, value} }
local function ripeFruits(garden, now: number)
	local list = {}
	local sellBonus = bonusesOf(garden).Sell
	for _, view in garden.plantViews do
		if not view.destroyed then
			local plant, seed = view.plant, view.seed
			if seed.multiHarvest then
				for index, slot in plant.slots do
					if isFruitRipe(view, index, now) then
						table.insert(list, { view = view, slot = index, value = Formulas.fruitValue(seed.id, slot.w, slot.m, sellBonus, plant.v) })
					end
				end
			elseif isFruitRipe(view, nil, now) then
				table.insert(list, { view = view, slot = nil, value = Formulas.fruitValue(seed.id, plant.f.w, plant.f.m, sellBonus, plant.v) })
			end
		end
	end
	return list
end
GardenService.ripeFruits = ripeFruits

function GardenService.fruitWorldPosition(view, slotIndex: number?): Vector3
	if slotIndex and view.fruits[slotIndex] then
		return view.fruits[slotIndex].model:GetPivot().Position
	end
	return view.baseCF.Position + Vector3.new(0, view.seed.height * 0.5, 0)
end

---------------------------------------------------------------------
-- Sprinklers, lanternas, gnomos e ovos
---------------------------------------------------------------------

local function createSprinklerView(garden, entry)
	local gear = Config.Gear[entry.g]
	if not gear then
		return
	end
	local model = Visuals.buildSprinkler(gear)
	model:PivotTo(garden.plot.cframe * CFrame.new(entry.x, groundHeight(entry.x, entry.z), entry.z))
	model.Parent = garden.plot.plantsFolder
	garden.sprinklerViews[entry.id] = model
end

local function createPropView(garden, entry)
	local gear = Config.Gear[entry.g]
	if not gear then
		return
	end
	local model, label
	if gear.kind == "lantern" then
		model = Visuals.buildLantern(gear)
	else
		model, label = Visuals.buildGnome(gear)
	end
	model:PivotTo(garden.plot.cframe * CFrame.new(entry.x, groundHeight(entry.x, entry.z), entry.z) * CFrame.Angles(0, math.pi, 0))
	model:SetAttribute("OwnerUserId", garden.player.UserId)
	model.Parent = garden.plot.plantsFolder
	garden.propViews[entry.id] = { model = model, label = label, entry = entry }
end

local function removeProp(garden, propId: number)
	local props = garden.data.props
	for i = #props, 1, -1 do
		if props[i].id == propId then
			table.remove(props, i)
		end
	end
	local view = garden.propViews[propId]
	if view then
		view.model:Destroy()
		garden.propViews[propId] = nil
	end
end

local hatchEgg: (Player, any, any) -> ()

local function updateEggView(garden, view, now: number)
	local remaining = view.entry.t - now
	local text
	if remaining > 0 then
		text = view.egg.name .. "\n" .. Formulas.formatTime(remaining)
	else
		text = view.egg.name .. "\nPronto para chocar!"
		if not view.prompt then
			local target = primaryOf(view.model)
			if target then
				local prompt = makePrompt(target, "Chocar", view.egg.name, garden.player.UserId, "Hatch")
				prompt.Triggered:Connect(function(who)
					hatchEgg(who, garden, view)
				end)
				view.prompt = prompt
			end
		end
	end
	if view.label.Text ~= text then
		view.label.Text = text
	end
end

local function createEggView(garden, entry)
	local egg = Config.Eggs[entry.e]
	if not egg then
		return
	end
	local model, label = Visuals.buildEgg(egg)
	model:PivotTo(garden.plot.cframe * CFrame.new(entry.x, groundHeight(entry.x, entry.z), entry.z))
	model:SetAttribute("OwnerUserId", garden.player.UserId)
	model.Parent = garden.plot.plantsFolder
	local view = { entry = entry, egg = egg, model = model, label = label, prompt = nil, destroyed = false }
	garden.eggViews[entry.id] = view
	updateEggView(garden, view, os.time())
end

local function removeEgg(garden, eggId: number)
	local eggs = garden.data.placedEggs
	for i = #eggs, 1, -1 do
		if eggs[i].id == eggId then
			table.remove(eggs, i)
		end
	end
	local view = garden.eggViews[eggId]
	if view then
		view.destroyed = true
		view.model:Destroy()
		garden.eggViews[eggId] = nil
	end
end

hatchEgg = function(player: Player, garden, view)
	if player ~= garden.player or gardens[player] ~= garden or view.destroyed then
		return
	end
	if os.time() < view.entry.t then
		return
	end
	local data = garden.data
	if #data.pets >= Config.MaxPetsOwned then
		Sync.notify(player, string.format("Você já tem %d pets (máximo).", Config.MaxPetsOwned), "error")
		return
	end
	local pick = Formulas.weightedPick(view.egg.pets, rng)
	local variant = Formulas.weightedPick(Config.PetVariants, rng)
	removeEgg(garden, view.entry.id)
	local pet = PetService.addPet(player, data, pick.pet, if variant.id == "Normal" then nil else variant.id)
	garden.bonuses = nil
	data.stats.hatched += 1
	QuestService.progress(player, "hatch", 1)
	local info = Config.Pets[pick.pet]
	local strength = Formulas.petStrength(pet)
	local abilities = {}
	for _, ability in info.abilities do
		table.insert(abilities, Formulas.abilityText(ability, strength))
	end
	Sync.notify(
		player,
		string.format("🎉 Você chocou: %s (%s)! %s", Formulas.petName(pet), Config.Rarities[info.rarity].name, table.concat(abilities, " • ")),
		"rare"
	)
end

---------------------------------------------------------------------
-- Uso de itens
---------------------------------------------------------------------

local function consume(list, id: string, amount: number)
	list[id] = (list[id] or 0) - amount
	if list[id] <= 0 then
		list[id] = nil
	end
end

local function plantSeed(player: Player, garden, seed, position: any)
	local data = garden.data
	if #data.plants >= Config.MaxPlantsPerGarden then
		Sync.notify(player, string.format("Seu jardim está cheio! (máximo de %d plantas)", Config.MaxPlantsPerGarden), "error")
		return
	end
	local lx, lz = resolvePosition(garden, position, function(x, z)
		return inBeds(x, z) and isFarFromEverything(garden, x, z, Config.MinPlantSpacing, 1.8)
	end)
	if not lx or not lz then
		Sync.notify(player, "Clique em um espaço livre na terra marrom do SEU jardim!", "error")
		return
	end
	consume(data.seeds, seed.id, 1)
	local plant: { [string]: any } = {
		id = data.nextId,
		s = seed.id,
		x = round2(lx),
		z = round2(lz),
		p = os.time(),
		b = 0,
		v = Formulas.rollVariant(seed, rng, luckOf(garden)),
	}
	data.nextId += 1
	if seed.multiHarvest then
		plant.slots = {}
		for i = 1, seed.maxFruits do
			plant.slots[i] = newFruit(garden, plant, seed, seed.growTime + (i - 1) * seed.fruitTime * 0.3)
		end
	else
		plant.f = newFruit(garden, plant, seed, 0)
	end
	table.insert(data.plants, plant)
	data.stats.planted += 1
	QuestService.progress(player, "plant", 1)
	createPlantView(garden, plant)
	Sync.markDirty(player)
	if plant.v then
		Sync.notify(player, "✨ Variante rara! Você plantou: " .. Formulas.fruitName(seed.id, plant.v), "rare")
	end
end

local function nearestPlant(garden, lx: number, lz: number)
	local best, bestDistance = nil, math.huge
	for _, plant in garden.data.plants do
		local seed = Config.Seeds[plant.s]
		local reach = math.max(1.5, seed.height * 0.45)
		local dx, dz = plant.x - lx, plant.z - lz
		local distance = math.sqrt(dx * dx + dz * dz)
		if distance <= reach and distance < bestDistance then
			best, bestDistance = plant, distance
		end
	end
	return best
end

local function nearestProp(garden, lx: number, lz: number)
	local best, bestDistance = nil, 2.5
	for _, prop in garden.data.props do
		local dx, dz = prop.x - lx, prop.z - lz
		local distance = math.sqrt(dx * dx + dz * dz)
		if distance <= bestDistance then
			best, bestDistance = prop, distance
		end
	end
	return best
end

local function useWateringCan(player: Player, garden, gear, position: any)
	local data = garden.data
	local lx, lz = resolvePosition(garden, position, inPlot)
	if not lx or not lz then
		Sync.notify(player, "Use o regador dentro do seu jardim.", "error")
		return
	end
	local now = os.time()
	local count = 0
	local radius2 = gear.radius * gear.radius
	for _, plant in data.plants do
		local dx, dz = plant.x - lx, plant.z - lz
		if dx * dx + dz * dz <= radius2 then
			local seed = Config.Seeds[plant.s]
			local age = plantAge(plant, now)
			local base = if seed.multiHarvest and age >= seed.growTime then seed.fruitTime else seed.growTime
			plant.b += base * gear.boost
			count += 1
			local view = garden.plantViews[plant.id]
			if view then
				updatePlantView(garden, view, now)
			end
		end
	end
	if count == 0 then
		Sync.notify(player, "Nenhuma planta por perto. Regue mais perto das plantas!", "error")
		return
	end
	consume(data.gear, gear.id, 1)
	Visuals.splash(garden.plot.cframe:PointToWorldSpace(Vector3.new(lx, groundHeight(lx, lz) + 0.3, lz)), gear.radius)
	Sync.markDirty(player)
	Sync.notify(player, string.format("💧 %d planta(s) regada(s)!", count), "success")
end

local function useShovel(player: Player, garden, position: any)
	-- primeiro tenta acertar um ladrao para recuperar o fruto roubado
	if GardenService.hooks.bonk and GardenService.hooks.bonk(player) then
		return
	end
	local data = garden.data
	local lx, lz = resolvePosition(garden, position, inPlot)
	if not lx or not lz then
		Sync.notify(player, "Use a pá dentro do seu jardim.", "error")
		return
	end
	local plant = nearestPlant(garden, lx, lz)
	local prop = if plant then nil else nearestProp(garden, lx, lz)
	local target = plant or prop
	if not target then
		Sync.notify(player, "Clique em cima de uma planta (ou lanterna/gnomo) para remover.", "error")
		return
	end
	local name = if plant then Formulas.fruitName(plant.s, plant.v) else Config.Gear[prop.g].name
	local pending = garden.shovelPending
	if pending and pending.id == target.id and os.clock() - pending.t <= 4 then
		garden.shovelPending = nil
		if plant then
			removePlant(garden, plant.id)
		else
			removeProp(garden, prop.id)
		end
		Sync.markDirty(player)
		Sync.notify(player, name .. " removido(a) do jardim.", "info")
	else
		garden.shovelPending = { id = target.id, t = os.clock() }
		Sync.notify(player, "Clique de novo em " .. name .. " para remover (não dá para desfazer)!", "error")
	end
end

local function findRecipe(a: string, b: string)
	for _, recipe in Config.MergeRecipes do
		if (recipe.a == a and recipe.b == b) or (recipe.a == b and recipe.b == a) then
			return recipe
		end
	end
	return nil
end

-- Espatula: 1o clique escolhe a planta; 2o clique move para um lugar vazio
-- ou funde com outra planta (receitas secretas)
local function useTrowel(player: Player, garden, position: any)
	local data = garden.data
	local now = os.time()
	local lx, lz = resolvePosition(garden, position, inPlot)
	if not lx or not lz then
		Sync.notify(player, "Use a espátula dentro do seu jardim.", "error")
		return
	end
	local selected = garden.trowel
	local selectedPlant = nil
	if selected and os.clock() - selected.t <= 15 then
		for _, plant in data.plants do
			if plant.id == selected.id then
				selectedPlant = plant
			end
		end
	end
	local clicked = nearestPlant(garden, lx, lz)
	if not selectedPlant then
		if not clicked then
			Sync.notify(player, "Clique em uma planta para escolher com a espátula.", "error")
			return
		end
		garden.trowel = { id = clicked.id, t = os.clock() }
		Sync.notify(player, string.format("Espátula: %s escolhida. Clique num lugar vazio para mover ou em outra planta para tentar uma fusão.", Formulas.fruitName(clicked.s, clicked.v)), "info")
		return
	end
	garden.trowel = nil
	if clicked and clicked.id ~= selectedPlant.id then
		local recipe = findRecipe(selectedPlant.s, clicked.s)
		local seedA, seedB = Config.Seeds[selectedPlant.s], Config.Seeds[clicked.s]
		if not recipe then
			Sync.notify(player, string.format("%s e %s não se fundem.", seedA.name, seedB.name), "error")
			return
		end
		if plantAge(selectedPlant, now) < seedA.growTime or plantAge(clicked, now) < seedB.growTime then
			Sync.notify(player, "As duas plantas precisam estar adultas para a fusão!", "error")
			return
		end
		local result = Config.Seeds[recipe.result]
		local x, z = clicked.x, clicked.z
		removePlant(garden, selectedPlant.id)
		removePlant(garden, clicked.id)
		local plant: { [string]: any } = { id = data.nextId, s = result.id, x = x, z = z, p = now, b = result.growTime }
		data.nextId += 1
		plant.slots = {}
		for i = 1, result.maxFruits do
			plant.slots[i] = newFruit(garden, plant, result, result.growTime + (i - 1) * result.fruitTime * 0.3)
		end
		table.insert(data.plants, plant)
		data.stats.merged += 1
		createPlantView(garden, plant)
		Visuals.ring(garden.plot.cframe:PointToWorldSpace(Vector3.new(x, L.bedTop + 1, z)), result.fruitColor, 6)
		Sync.markDirty(player)
		Sync.notify(player, string.format("✨ FUSÃO SECRETA! %s + %s = %s!", seedA.name, seedB.name, result.name), "rare")
		return
	end
	if not inBeds(lx, lz) or not isFarFromEverything(garden, lx, lz, Config.MinPlantSpacing, 1.8, selectedPlant.id) then
		Sync.notify(player, "Esse lugar não está livre na terra do jardim.", "error")
		return
	end
	selectedPlant.x = round2(lx)
	selectedPlant.z = round2(lz)
	destroyPlantView(garden, selectedPlant.id)
	createPlantView(garden, selectedPlant)
	Sync.notify(player, Formulas.fruitName(selectedPlant.s, selectedPlant.v) .. " foi movida!", "success")
end

local function placeSprinkler(player: Player, garden, gear, position: any)
	local data = garden.data
	if #data.sprinklers >= Config.MaxSprinklersPerGarden then
		Sync.notify(player, string.format("Máximo de %d sprinklers ativos.", Config.MaxSprinklersPerGarden), "error")
		return
	end
	local lx, lz = resolvePosition(garden, position, inPlot)
	if not lx or not lz then
		Sync.notify(player, "Coloque o sprinkler dentro do seu jardim.", "error")
		return
	end
	consume(data.gear, gear.id, 1)
	local entry = { id = data.nextId, g = gear.id, x = round2(lx), z = round2(lz), t = os.time() + gear.duration }
	data.nextId += 1
	table.insert(data.sprinklers, entry)
	createSprinklerView(garden, entry)
	Sync.markDirty(player)
	Sync.notify(player, string.format("%s colocado! Dura %s.", gear.name, Formulas.formatTime(gear.duration)), "success")
end

local function placeProp(player: Player, garden, gear, position: any)
	local data = garden.data
	local count = 0
	for _, prop in data.props do
		if prop.g == gear.id then
			count += 1
		end
	end
	if count >= (gear.maxPlaced or 4) then
		Sync.notify(player, string.format("Máximo de %d %s no jardim.", gear.maxPlaced or 4, gear.name), "error")
		return
	end
	local lx, lz = resolvePosition(garden, position, function(x, z)
		return inPlot(x, z) and isFarFromEverything(garden, x, z, 1.4, 2)
	end)
	if not lx or not lz then
		Sync.notify(player, "Coloque em um espaço livre do seu jardim.", "error")
		return
	end
	consume(data.gear, gear.id, 1)
	local entry: { [string]: any } = { id = data.nextId, g = gear.id, x = round2(lx), z = round2(lz) }
	if gear.duration then
		entry.t = os.time() + gear.duration
	end
	data.nextId += 1
	table.insert(data.props, entry)
	createPropView(garden, entry)
	Sync.markDirty(player)
	if gear.kind == "gnome" then
		Sync.notify(player, string.format("🧙 Gnomo protegendo seu jardim por %s!", Formulas.formatTime(gear.duration)), "success")
	else
		Sync.notify(player, gear.name .. " colocada!", "success")
	end
end

local function placeEgg(player: Player, garden, egg, position: any)
	local data = garden.data
	if #data.placedEggs >= Config.MaxEggsPerGarden then
		Sync.notify(player, string.format("Máximo de %d ovos chocando ao mesmo tempo.", Config.MaxEggsPerGarden), "error")
		return
	end
	local lx, lz = resolvePosition(garden, position, function(x, z)
		return inPlot(x, z) and isFarFromEverything(garden, x, z, 1.8, 2.5)
	end)
	if not lx or not lz then
		Sync.notify(player, "Coloque o ovo em um espaço livre do seu jardim.", "error")
		return
	end
	consume(data.eggs, egg.id, 1)
	local entry = { id = data.nextId, e = egg.id, x = round2(lx), z = round2(lz), t = os.time() + egg.hatchTime }
	data.nextId += 1
	table.insert(data.placedEggs, entry)
	createEggView(garden, entry)
	Sync.markDirty(player)
	Sync.notify(player, string.format("🥚 %s vai chocar em %s.", egg.name, Formulas.formatTime(egg.hatchTime)), "success")
end

function GardenService.useItem(player: Player, kind: any, id: any, position: any)
	local garden = gardens[player]
	if not garden or type(kind) ~= "string" or type(id) ~= "string" then
		return
	end
	local clock = os.clock()
	if clock - garden.lastUse < 0.12 then
		return
	end
	garden.lastUse = clock
	local data = garden.data
	if kind == "Seed" then
		local seed = Config.Seeds[id]
		if seed and (data.seeds[id] or 0) > 0 then
			plantSeed(player, garden, seed, position)
		end
	elseif kind == "Gear" then
		local gear = Config.Gear[id]
		if not gear or (data.gear[id] or 0) <= 0 then
			return
		end
		if gear.kind == "water" then
			useWateringCan(player, garden, gear, position)
		elseif gear.kind == "shovel" then
			useShovel(player, garden, position)
		elseif gear.kind == "trowel" then
			useTrowel(player, garden, position)
		elseif gear.kind == "sprinkler" then
			placeSprinkler(player, garden, gear, position)
		elseif gear.kind == "lantern" or gear.kind == "gnome" then
			placeProp(player, garden, gear, position)
		elseif gear.kind == "consumable" then
			if GardenService.hooks.consume and GardenService.hooks.consume(player, gear) then
				consume(data.gear, gear.id, 1)
				Sync.markDirty(player)
			end
		elseif gear.kind == "sniper" then
			if GardenService.hooks.snipe then
				GardenService.hooks.snipe(player, gear, if isValidVector(position) then position else nil)
			end
		end
	elseif kind == "Egg" then
		local egg = Config.Eggs[id]
		if egg and (data.eggs[id] or 0) > 0 then
			placeEgg(player, garden, egg, position)
		end
	end
end

---------------------------------------------------------------------
-- Clima e ciclo do dia (chamado pelos outros servicos)
---------------------------------------------------------------------

function GardenService.setWeatherEffects(effects)
	weather.growthBonus = effects.growthBonus or 0
	weather.goldBoost = effects.goldBoost or 1
	weather.rainbowBoost = effects.rainbowBoost or 1
	weather.sizeBoost = effects.sizeBoost or 0
end

function GardenService.setPhase(newPhase: string, index: number)
	phase = newPhase
	nightIndex = index
end

function GardenService.applyWeatherMutation(mutationId: string, chance: number)
	local now = os.time()
	for _, garden in gardens do
		local luck = luckOf(garden)
		for _, plant in garden.data.plants do
			applyChanceToPlant(plant, mutationId, chance * (1 + luck), now)
		end
	end
end

-- Algo cai em um fruto aleatorio (raio, meteoro, estrela, tornado). Retorna a posicao.
function GardenService.strikeRandomFruit(mutationId: string): Vector3?
	local now = os.time()
	local candidates = {}
	for _, garden in gardens do
		for _, plant in garden.data.plants do
			forEachVisibleFruit(plant, now, function(list)
				table.insert(candidates, { garden = garden, plant = plant, list = list })
			end)
		end
	end
	if #candidates == 0 then
		return nil
	end
	local pick = candidates[rng:NextInteger(1, #candidates)]
	local seed = Config.Seeds[pick.plant.s]
	if Formulas.addMutation(pick.list, mutationId) then
		local mutation = Config.Mutations[mutationId]
		Sync.notify(pick.garden.player, string.format("✨ Um fruto de %s ficou %s!", seed.name, mutation.name), "rare")
	end
	return pick.garden.plot.cframe:PointToWorldSpace(Vector3.new(pick.plant.x, L.bedTop + seed.height * 0.6, pick.plant.z))
end

---------------------------------------------------------------------
-- Atualizacao periodica
---------------------------------------------------------------------

local function petAbilities(garden, bonuses, dt: number, now: number)
	local player = garden.player
	local data = garden.data
	garden.petTimers = garden.petTimers or {}
	for _, ability in bonuses.active do
		if ability.kind == "AutoHarvest" or ability.kind == "AutoHarvestBest" then
			local key = ability.petUid .. ability.kind
			garden.petTimers[key] = (garden.petTimers[key] or 0) + dt
			if garden.petTimers[key] >= ability.cooldown then
				garden.petTimers[key] = 0
				local ripe = ripeFruits(garden, now)
				if #ripe > 0 then
					local pick = ripe[rng:NextInteger(1, #ripe)]
					if ability.kind == "AutoHarvestBest" then
						for _, candidate in ripe do
							if candidate.value > pick.value then
								pick = candidate
							end
						end
					end
					local seedId = pick.view.seed.id
					local petName = Config.Pets[ability.petId].name
					local fruit = ownerHarvest(garden, pick.view, pick.slot, "🐾 " .. petName)
					if fruit and ability.seedChance and rng:NextNumber() < ability.seedChance and Config.Seeds[seedId].inShop then
						data.seeds[seedId] = (data.seeds[seedId] or 0) + 1
						Sync.notify(player, string.format("🐾 %s achou uma semente de %s!", petName, Config.Seeds[seedId].name), "rare")
					end
				end
			end
		elseif ability.kind == "Raccoon" and phase == "Night" and garden.raccoonNight ~= nightIndex then
			garden.raccoonNight = nightIndex
			local options = {}
			for _, other in gardens do
				if other ~= garden then
					for _, item in ripeFruits(other, now) do
						table.insert(options, item)
					end
				end
			end
			if #options > 0 then
				local pick = options[rng:NextInteger(1, #options)]
				local plant, seed = pick.view.plant, pick.view.seed
				local source = if pick.slot then plant.slots[pick.slot] else plant.f
				local copy = { s = seed.id, w = source.w, m = table.clone(source.m), v = plant.v }
				if GardenService.addFruit(player, copy) then
					Sync.notify(player, "🦝 Seu Guaxinim trouxe um fruto de outro jardim: " .. fruitLabel(seed, copy.w, copy.m, copy.v), "rare")
				end
			end
		end
	end
end

local function tickGarden(garden, dt: number, now: number)
	local data = garden.data
	local bonuses = Formulas.petBonuses(data.pets, data.equippedPets)
	garden.bonuses = bonuses
	local night = phase == "Night"
	local luck = bonuses.Luck + (if night then bonuses.NightLuck else 0)
	local baseRate = weather.growthBonus + bonuses.Growth

	local activeSprinklers = {}
	for i = #data.sprinklers, 1, -1 do
		local entry = data.sprinklers[i]
		local gear = Config.Gear[entry.g]
		if not gear or now >= entry.t then
			table.remove(data.sprinklers, i)
			local model = garden.sprinklerViews[entry.id]
			if model then
				model:Destroy()
			end
			garden.sprinklerViews[entry.id] = nil
			if gear then
				Sync.notify(garden.player, gear.name .. " acabou.", "info")
			end
		else
			table.insert(activeSprinklers, entry)
		end
	end

	local lanterns = {}
	for i = #data.props, 1, -1 do
		local entry = data.props[i]
		local gear = Config.Gear[entry.g]
		if entry.t and now >= entry.t then
			removeProp(garden, entry.id)
			Sync.notify(garden.player, gear.name .. " foi embora. Seu jardim está desprotegido!", "error")
		elseif gear.kind == "lantern" then
			table.insert(lanterns, { entry = entry, gear = gear })
		elseif entry.t then
			local view = garden.propViews[entry.id]
			if view and view.label then
				local text = gear.name .. "\n🛡️ " .. Formulas.formatTime(entry.t - now)
				if view.label.Text ~= text then
					view.label.Text = text
				end
			end
		end
	end

	local glowSources = {}
	if night then
		for _, plant in data.plants do
			local seed = Config.Seeds[plant.s]
			local aura = seed.special and seed.special.glowAura
			if aura and plantAge(plant, now) >= seed.growTime then
				table.insert(glowSources, { plant = plant, aura = aura })
			end
		end
	end

	for _, plant in data.plants do
		local seed = Config.Seeds[plant.s]
		local special = seed.special or {}
		local rate = baseRate
		local wetChance = 0
		for _, entry in activeSprinklers do
			local gear = Config.Gear[entry.g]
			local dx, dz = plant.x - entry.x, plant.z - entry.z
			if dx * dx + dz * dz <= gear.radius * gear.radius then
				rate += gear.growth
				wetChance += gear.wetChance
			end
		end
		if night then
			for _, lantern in lanterns do
				local dx, dz = plant.x - lantern.entry.x, plant.z - lantern.entry.z
				if dx * dx + dz * dz <= lantern.gear.radius * lantern.gear.radius then
					rate += lantern.gear.nightGrowth
				end
			end
			rate += (special.nightGrowth or 1) - 1
		else
			rate += (special.dayGrowth or 1) - 1
		end
		rate = math.max(rate, -0.9)
		if rate ~= 0 then
			plant.b += dt * rate
		end
		local factor = dt * (1 + luck)
		if wetChance > 0 then
			applyChanceToPlant(plant, "Wet", wetChance * factor, now)
		end
		if bonuses.Pollinate > 0 then
			applyChanceToPlant(plant, "Pollinated", bonuses.Pollinate * factor, now)
		end
		if bonuses.Ignite > 0 then
			applyChanceToPlant(plant, "Ignited", bonuses.Ignite * factor, now)
		end
		for _, source in glowSources do
			if source.plant ~= plant then
				local dx, dz = plant.x - source.plant.x, plant.z - source.plant.z
				if dx * dx + dz * dz <= source.aura.radius * source.aura.radius then
					applyChanceToPlant(plant, source.aura.mutation, source.aura.chance * factor, now)
				end
			end
		end
		local view = garden.plantViews[plant.id]
		if view then
			updatePlantView(garden, view, now)
		end
	end

	for _, view in garden.eggViews do
		updateEggView(garden, view, now)
	end

	petAbilities(garden, bonuses, dt, now)
	PetService.addXp(garden.player, data, dt)
end

---------------------------------------------------------------------
-- Jardins dos jogadores
---------------------------------------------------------------------

function GardenService.init(map)
	plots = map.plots
end

function GardenService.assignPlot(player: Player, data): boolean
	for _, plot in plots do
		if not plot.owner then
			plot.owner = player
			plot.model:SetAttribute("OwnerUserId", player.UserId)
			plot.model:SetAttribute("Locked", false)
			plot.signLabel.Text = "Jardim de " .. player.DisplayName
			local garden = {
				player = player,
				data = data,
				plot = plot,
				plantViews = {},
				sprinklerViews = {},
				propViews = {},
				eggViews = {},
				shovelPending = nil,
				trowel = nil,
				lastUse = 0,
				bonuses = nil,
				petTimers = {},
				raccoonNight = -1,
			}
			gardens[player] = garden
			player:SetAttribute("PlotIndex", plot.index)
			for _, plant in data.plants do
				createPlantView(garden, plant)
			end
			for _, entry in data.sprinklers do
				createSprinklerView(garden, entry)
			end
			for _, entry in data.props do
				createPropView(garden, entry)
			end
			for _, entry in data.placedEggs do
				createEggView(garden, entry)
			end
			return true
		end
	end
	return false
end

function GardenService.releasePlot(player: Player)
	local garden = gardens[player]
	if not garden then
		return
	end
	gardens[player] = nil
	for _, view in garden.plantViews do
		view.destroyed = true
		if view.body then
			view.body:Destroy()
		end
	end
	for _, view in garden.eggViews do
		view.destroyed = true
	end
	local plot = garden.plot
	plot.plantsFolder:ClearAllChildren()
	plot.owner = nil
	plot.model:SetAttribute("OwnerUserId", 0)
	plot.model:SetAttribute("Locked", false)
	plot.signLabel.Text = "Jardim Livre"
end

function GardenService.getGarden(player: Player)
	return gardens[player]
end

function GardenService.getGardens()
	return gardens
end

function GardenService.getGardenCFrame(player: Player): CFrame?
	local garden = gardens[player]
	return if garden then garden.plot.spawnCFrame else nil
end

-- Posicao do lado de fora do portao do jardim (para expulsar ladroes)
function GardenService.outsideCFrame(garden): CFrame
	return garden.plot.cframe * CFrame.new(0, 3, -L.plotHalfZ - 7) * CFrame.Angles(0, math.pi, 0)
end

function GardenService.isInside(garden, position: Vector3): boolean
	local localPos = garden.plot.cframe:PointToObjectSpace(position)
	return math.abs(localPos.X) <= L.plotHalfX and math.abs(localPos.Z) <= L.plotHalfZ
end

function GardenService.hasActiveGnome(garden): boolean
	local now = os.time()
	for _, prop in garden.data.props do
		local gear = Config.Gear[prop.g]
		if gear and gear.kind == "gnome" and prop.t and prop.t > now then
			return true
		end
	end
	return false
end

-- Lanternas do jardim em coordenadas do mundo
function GardenService.lanterns(garden): { { position: Vector3, radius: number } }
	local list = {}
	for _, prop in garden.data.props do
		local gear = Config.Gear[prop.g]
		if gear and gear.kind == "lantern" then
			table.insert(list, { position = garden.plot.cframe:PointToWorldSpace(Vector3.new(prop.x, 2, prop.z)), radius = gear.radius })
		end
	end
	return list
end

-- Plantas de defesa adultas: { {seed, defense, position, plantId} }
function GardenService.defenses(garden): { any }
	local list = {}
	local now = os.time()
	for _, plant in garden.data.plants do
		local seed = Config.Seeds[plant.s]
		if seed and seed.defense and plantAge(plant, now) >= seed.growTime then
			table.insert(list, {
				seed = seed,
				defense = seed.defense,
				plantId = plant.id,
				position = garden.plot.cframe:PointToWorldSpace(Vector3.new(plant.x, L.bedTop + seed.height * 0.6, plant.z)),
			})
		end
	end
	return list
end

function GardenService.bonuses(player: Player)
	local garden = gardens[player]
	if garden then
		return bonusesOf(garden)
	end
	return nil
end

function GardenService.invalidateBonuses(player: Player)
	local garden = gardens[player]
	if garden then
		garden.bonuses = nil
	end
end

-- Comando de teste: faz todas as plantas crescerem
function GardenService.growAll(player: Player)
	local garden = gardens[player]
	if not garden then
		return
	end
	for _, plant in garden.data.plants do
		local seed = Config.Seeds[plant.s]
		plant.b += seed.growTime + (seed.fruitTime or 0) * (seed.maxFruits or 1)
	end
	for _, entry in garden.data.placedEggs do
		entry.t = os.time()
	end
end

function GardenService.start()
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < 0.5 then
			return
		end
		local step = math.min(accumulator, 5)
		accumulator = 0
		local now = os.time()
		for _, garden in gardens do
			local ok, err = pcall(tickGarden, garden, step, now)
			if not ok then
				warn("[Jardim] Erro ao atualizar jardim: " .. tostring(err))
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		GardenService.releasePlot(player)
	end)
end

return GardenService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000B">
				<Properties>
					<string name="Name">Inventory</string>
					<ProtectedString name="Source"><![CDATA[-- Inventory: mantem as ferramentas (Tools) da mochila iguais aos itens salvos.
-- Sementes, equipamentos e ovos aparecem na barra de itens do Roblox.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Inventory = {}

type Wanted = { kind: string, id: string, label: string, tip: string }

local function wantedItems(data): { Wanted }
	local list = {}
	for _, seed in Config.SeedList do
		local count = data.seeds[seed.id] or 0
		if count > 0 then
			table.insert(list, {
				kind = "Seed",
				id = seed.id,
				label = string.format("Semente de %s [x%d]", seed.name, count),
				tip = "Clique na terra do seu jardim para plantar",
			})
		end
	end
	for _, gear in Config.GearList do
		local count = data.gear[gear.id] or 0
		if count > 0 then
			local label
			if gear.kind == "water" then
				label = string.format("%s [%d usos]", gear.name, count)
			elseif gear.unique then
				label = gear.name
			else
				label = string.format("%s [x%d]", gear.name, count)
			end
			table.insert(list, { kind = "Gear", id = gear.id, label = label, tip = gear.description })
		end
	end
	for _, egg in Config.EggList do
		local count = data.eggs[egg.id] or 0
		if count > 0 then
			table.insert(list, {
				kind = "Egg",
				id = egg.id,
				label = string.format("%s [x%d]", egg.name, count),
				tip = "Clique no seu jardim para colocar o ovo",
			})
		end
	end
	return list
end

local function toolKey(kind: string, id: string): string
	return kind .. ":" .. id
end

-- Atualiza as Tools da mochila/personagem do jogador
function Inventory.sync(player: Player, data)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return
	end
	local containers = { backpack }
	if player.Character then
		table.insert(containers, player.Character)
	end

	local existing: { [string]: Tool } = {}
	for _, container in containers do
		for _, child in container:GetChildren() do
			if child:IsA("Tool") then
				local kind = child:GetAttribute("ItemKind")
				local id = child:GetAttribute("ItemId")
				if type(kind) == "string" and type(id) == "string" then
					local key = toolKey(kind, id)
					if existing[key] then
						child:Destroy() -- duplicada
					else
						existing[key] = child
					end
				end
			end
		end
	end

	local keep = {}
	for _, item in wantedItems(data) do
		local key = toolKey(item.kind, item.id)
		keep[key] = true
		local tool = existing[key]
		if not tool then
			tool = Instance.new("Tool")
			tool.RequiresHandle = false
			tool.CanBeDropped = false
			tool:SetAttribute("ItemKind", item.kind)
			tool:SetAttribute("ItemId", item.id)
			tool.Name = item.label
			tool.ToolTip = item.tip
			tool.Parent = backpack
		elseif tool.Name ~= item.label then
			tool.Name = item.label
		end
	end

	for key, tool in existing do
		if not keep[key] then
			tool:Destroy()
		end
	end
end

return Inventory
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000C">
				<Properties>
					<string name="Name">MapBuilder</string>
					<ProtectedString name="Source"><![CDATA[-- MapBuilder: cria o mapa inteiro (chao, rua, praca com chafariz, 6 jardins, lojas,
-- decoracao e iluminacao). Tudo e gerado por codigo, entao o jogo funciona mesmo em um
-- lugar vazio.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")

local MapBuilder = {}

-- Medidas de cada jardim (coordenadas locais do jardim; -Z aponta para a rua)
MapBuilder.Layout = {
	plotHalfX = 28,
	plotHalfZ = 34,
	bedInner = 3, -- distancia do centro ate o inicio de cada canteiro
	bedOuter = 25, -- distancia do centro ate o fim de cada canteiro
	bedZMin = -26,
	bedZMax = 30,
	bedTop = 0.25, -- altura da terra
	columns = { -80, 0, 80 },
	rowZ = 56,
}

local SMOOTH = Enum.SurfaceType.Smooth
local WOOD = Color3.fromRGB(150, 105, 65)
local WOOD_DARK = Color3.fromRGB(115, 78, 48)
local WOOD_LIGHT = Color3.fromRGB(205, 160, 105)
local STONE = Color3.fromRGB(205, 200, 190)
local STONE_DARK = Color3.fromRGB(150, 145, 140)
local WHITE = Color3.fromRGB(255, 255, 255)
local BLACK = Color3.fromRGB(20, 20, 20)
local WATER = Color3.fromRGB(90, 175, 255)
local FLOWER_COLORS = {
	Color3.fromRGB(255, 90, 110),
	Color3.fromRGB(255, 200, 60),
	Color3.fromRGB(255, 255, 255),
	Color3.fromRGB(190, 120, 255),
	Color3.fromRGB(255, 150, 200),
	Color3.fromRGB(100, 170, 255),
	Color3.fromRGB(255, 140, 50),
}

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.TopSurface = SMOOTH
	p.BottomSurface = SMOOTH
	p.Material = material or Enum.Material.SmoothPlastic
	p.Color = color
	p.Size = size
	p.CFrame = cf
	p.Parent = parent
	return p
end

-- Peca so de enfeite: nao bate, nao lanca sombra pequena demais
local function decor(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = part(parent, name, size, cf, color, material)
	p.CanCollide = false
	p.CanTouch = false
	return p
end

-- Cilindro em pe
local function cylinderPart(parent: Instance, name: string, height: number, diameter: number, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = Enum.PartType.Cylinder
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.TopSurface = SMOOTH
	p.BottomSurface = SMOOTH
	p.Material = material or Enum.Material.SmoothPlastic
	p.Color = color
	p.Size = Vector3.new(height, diameter, diameter)
	p.CFrame = cf * CFrame.Angles(0, 0, math.pi / 2)
	p.Parent = parent
	return p
end

local function ball(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = decor(parent, name, size, cf, color, material)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

local function surfaceText(target: BasePart, text: string, textColor: Color3, face: Enum.NormalId?): TextLabel
	local gui = Instance.new("SurfaceGui")
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = textColor
	label.TextStrokeTransparency = 0.6
	label.Text = text
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0.04, 0)
	padding.PaddingRight = UDim.new(0.04, 0)
	padding.PaddingTop = UDim.new(0.08, 0)
	padding.PaddingBottom = UDim.new(0.08, 0)
	padding.Parent = label
	label.Parent = gui
	gui.Parent = target
	return label
end

-- plaquinha com nome (e funcao) em cima dos vendedores
local function billboard(adornee: BasePart, title: string, subtitle: string, color: Color3, height: number)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(170, 56)
	gui.StudsOffset = Vector3.new(0, height, 0)
	gui.MaxDistance = 120
	gui.Adornee = adornee
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.fromRGB(28, 32, 44)
	frame.BackgroundTransparency = 0.2
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 14)
	corner.Parent = frame
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = 3
	stroke.Parent = frame
	local name = Instance.new("TextLabel")
	name.Name = "Nome"
	name.Size = UDim2.new(1, -12, 0.6, 0)
	name.Position = UDim2.fromOffset(6, 2)
	name.BackgroundTransparency = 1
	name.Font = Enum.Font.FredokaOne
	name.TextScaled = true
	name.TextColor3 = Color3.fromRGB(255, 255, 255)
	name.TextStrokeTransparency = 0.4
	name.Text = title
	name.Parent = frame
	local role = Instance.new("TextLabel")
	role.Name = "Funcao"
	role.Size = UDim2.new(1, -12, 0.36, 0)
	role.Position = UDim2.new(0, 6, 0.6, 0)
	role.BackgroundTransparency = 1
	role.Font = Enum.Font.FredokaOne
	role.TextScaled = true
	role.TextColor3 = color
	role.Text = subtitle
	role.Parent = frame
	frame.Parent = gui
	gui.Parent = adornee
end

-- florzinha: cabinho + petalas + miolo (so 3 pecas, porque sao muitas)
local function flower(parent: Instance, position: Vector3, color: Color3, size: number)
	local stem = decor(parent, "Cabinho", Vector3.new(0.12, 0.9, 0.12) * size, CFrame.new(position + Vector3.new(0, 0.45 * size, 0)), Color3.fromRGB(70, 150, 55))
	stem.CastShadow = false
	local top = position + Vector3.new(0, 0.95 * size, 0)
	ball(parent, "Petalas", Vector3.new(0.75, 0.22, 0.75) * size, CFrame.new(top), color).CastShadow = false
	ball(parent, "Miolo", Vector3.new(0.26, 0.2, 0.26) * size, CFrame.new(top + Vector3.new(0, 0.06, 0) * size), Color3.fromRGB(255, 215, 70)).CastShadow = false
end

local function flowerBox(parent: Instance, cf: CFrame, length: number, rng: Random)
	decor(parent, "Floreira", Vector3.new(length, 1, 1.4), cf * CFrame.new(0, 0.5, 0), WOOD, Enum.Material.WoodPlanks)
	decor(parent, "Terra", Vector3.new(length - 0.3, 0.1, 1.1), cf * CFrame.new(0, 1.02, 0), Color3.fromRGB(100, 66, 40), Enum.Material.Ground)
	local count = math.max(2, math.floor(length / 1.2))
	for i = 1, count do
		local x = -length / 2 + (i - 0.5) * length / count
		flower(parent, (cf * CFrame.new(x, 1, rng:NextNumber(-0.25, 0.25))).Position, FLOWER_COLORS[rng:NextInteger(1, #FLOWER_COLORS)], 1.1)
	end
end

---------------------------------------------------------------------
-- Jardins
---------------------------------------------------------------------

local function buildPlot(index: number, center: Vector3, rotation: number, parent: Instance, rng: Random)
	local L = MapBuilder.Layout
	local cf = CFrame.new(center) * CFrame.Angles(0, rotation, 0)
	local model = Instance.new("Model")
	model.Name = "Jardim" .. index
	model:SetAttribute("PlotIndex", index)
	model:SetAttribute("OwnerUserId", 0)

	local function at(x: number, y: number, z: number): CFrame
		return cf * CFrame.new(x, y, z)
	end

	part(model, "Base", Vector3.new(L.plotHalfX * 2, 0.2, L.plotHalfZ * 2), at(0, 0, 0), Color3.fromRGB(110, 185, 80), Enum.Material.Grass)
	local bedWidth = L.bedOuter - L.bedInner
	local bedLength = L.bedZMax - L.bedZMin
	local bedCenterZ = (L.bedZMax + L.bedZMin) / 2
	for _, side in { -1, 1 } do
		local bedX = side * (L.bedInner + bedWidth / 2)
		local bed = part(model, "Canteiro", Vector3.new(bedWidth, 0.5, bedLength), at(bedX, 0, bedCenterZ), Color3.fromRGB(125, 82, 50), Enum.Material.Ground)
		bed:SetAttribute("Canteiro", true)
		-- moldura de madeira em volta do canteiro
		for _, dz in { -1, 1 } do
			decor(model, "Moldura", Vector3.new(bedWidth + 0.9, 0.7, 0.45), at(bedX, 0.25, bedCenterZ + dz * (bedLength / 2 + 0.22)), WOOD_DARK, Enum.Material.Wood)
		end
		for _, dx in { -1, 1 } do
			decor(model, "Moldura", Vector3.new(0.45, 0.7, bedLength), at(bedX + dx * (bedWidth / 2 + 0.22), 0.25, bedCenterZ), WOOD_DARK, Enum.Material.Wood)
		end
		-- sulcos na terra
		for i = 1, 4 do
			local x = bedX - bedWidth / 2 + i * bedWidth / 5
			decor(model, "Sulco", Vector3.new(0.35, 0.04, bedLength - 1), at(x, 0.27, bedCenterZ), Color3.fromRGB(105, 68, 40), Enum.Material.Ground)
		end
	end
	part(model, "Caminho", Vector3.new(L.bedInner * 2, 0.3, L.plotHalfZ * 2 - 1), at(0, 0, 0), Color3.fromRGB(215, 190, 140), Enum.Material.Sand)
	-- pedrinhas no caminho
	for z = -L.plotHalfZ + 3, L.plotHalfZ - 3, 4 do
		local stone = cylinderPart(model, "Pedra", 0.12, 2.4 + rng:NextNumber(-0.3, 0.3), at(rng:NextNumber(-0.5, 0.5), 0.2, z), STONE, Enum.Material.Slate)
		stone.CastShadow = false
	end

	-- cerca
	-- skipStart/skipEnd evitam dois postes no mesmo canto
	local function fence(x1: number, z1: number, x2: number, z2: number, skipStart: boolean?, skipEnd: boolean?)
		local a = Vector3.new(x1, 0, z1)
		local b = Vector3.new(x2, 0, z2)
		local length = (b - a).Magnitude
		local mid = (a + b) / 2
		for _, y in { 1.1, 2.2 } do
			part(model, "Cerca", Vector3.new(0.35, 0.35, length), cf * CFrame.lookAt(Vector3.new(mid.X, y, mid.Z), Vector3.new(b.X, y, b.Z)), WOOD, Enum.Material.Wood)
		end
		local posts = math.max(1, math.floor(length / 6))
		for i = 0, posts do
			if not ((i == 0 and skipStart) or (i == posts and skipEnd)) then
				local p = a:Lerp(b, i / posts)
				part(model, "Poste", Vector3.new(0.6, 3, 0.6), at(p.X, 1.5, p.Z), WOOD, Enum.Material.Wood)
				decor(model, "Tampa", Vector3.new(0.8, 0.25, 0.8), at(p.X, 3.1, p.Z), WOOD_LIGHT, Enum.Material.Wood)
			end
		end
	end
	local hx, hz = L.plotHalfX, L.plotHalfZ
	fence(-hx, -hz, -hx, hz)
	fence(hx, -hz, hx, hz)
	fence(-hx, hz, hx, hz, true, true)
	fence(-hx, -hz, -5, -hz, true, false)
	fence(5, -hz, hx, -hz, false, true)

	-- arco de entrada com a placa do dono
	for _, x in { -5.4, 5.4 } do
		part(model, "PosteArco", Vector3.new(0.9, 8, 0.9), at(x, 4, -hz), WOOD_DARK, Enum.Material.Wood)
		decor(model, "Tampa", Vector3.new(1.2, 0.35, 1.2), at(x, 8.15, -hz), WOOD_LIGHT, Enum.Material.Wood)
		for i = 1, 5 do -- trepadeira com florzinhas no poste
			local y = 1.2 + i * 1.25
			ball(model, "Folha", Vector3.new(0.7, 0.55, 0.45), at(x + (if i % 2 == 0 then 0.42 else -0.42), y, -hz - 0.35), Color3.fromRGB(70, 160, 60))
			if i % 2 == 1 then
				ball(model, "Flor", Vector3.new(0.3, 0.3, 0.3), at(x, y + 0.3, -hz - 0.55), FLOWER_COLORS[(index + i) % #FLOWER_COLORS + 1])
			end
		end
	end
	decor(model, "Viga", Vector3.new(12.4, 0.7, 0.9), at(0, 7.4, -hz), WOOD_DARK, Enum.Material.Wood)
	local board = part(model, "Placa", Vector3.new(11, 2.8, 0.4), at(0, 9.3, -hz - 0.1), WOOD_LIGHT, Enum.Material.WoodPlanks)
	board.CanCollide = false
	for _, x in { -5.6, 5.6 } do
		decor(model, "Moldura", Vector3.new(0.3, 3.1, 0.55), at(x, 9.3, -hz - 0.1), WOOD_DARK, Enum.Material.Wood)
	end
	for _, y in { 7.85, 10.75 } do
		decor(model, "Moldura", Vector3.new(11.5, 0.3, 0.55), at(0, y, -hz - 0.1), WOOD_DARK, Enum.Material.Wood)
	end
	local signLabel = surfaceText(board, "Jardim Livre", Color3.fromRGB(70, 45, 20))
	signLabel.TextStrokeTransparency = 1
	-- floreiras dos dois lados da entrada
	for _, x in { -9, 9 } do
		flowerBox(model, at(x, 0, -hz - 1.6), 5, rng)
	end
	-- carrinho de mao e saco de adubo perto da entrada (dentro do jardim, fora dos canteiros)
	decor(model, "Carrinho", Vector3.new(1.8, 0.8, 2.6), at(-22, 1, -hz + 3), Color3.fromRGB(70, 120, 200), Enum.Material.Metal)
	cylinderPart(model, "Roda", 0.3, 1, at(-22, 0.5, -hz + 1.4) * CFrame.Angles(0, 0, math.pi / 2), BLACK)
	decor(model, "Saco", Vector3.new(1.4, 1.6, 1), at(22, 0.9, -hz + 3) * CFrame.Angles(0, 0.3, 0.1), Color3.fromRGB(190, 160, 110), Enum.Material.Fabric)

	local plantsFolder = Instance.new("Folder")
	plantsFolder.Name = "Plantas"
	plantsFolder.Parent = model
	model.Parent = parent

	return {
		index = index,
		model = model,
		cframe = cf,
		plantsFolder = plantsFolder,
		signLabel = signLabel,
		spawnCFrame = cf * CFrame.new(0, 3, -hz + 3) * CFrame.Angles(0, math.pi, 0),
		owner = nil :: Player?,
	}
end

---------------------------------------------------------------------
-- Lojas
---------------------------------------------------------------------

-- NPC com avatar no estilo Roblox (cabeca, tronco, bracos, pernas, cabelo, chapeu, roupa)
local function buildNpc(parent: Instance, cf: CFrame, look, name: string, role: string)
	local npc = Instance.new("Model")
	npc.Name = "NPC_" .. name
	local pieces = {}
	local function add(piece: BasePart)
		piece.CanCollide = false
		table.insert(pieces, piece)
		return piece
	end
	local function at(x: number, y: number, z: number): CFrame
		return cf * CFrame.new(x, y, z)
	end
	local skin = look.skin
	-- pernas e sapatos
	for _, x in { -0.5, 0.5 } do
		add(part(npc, if x < 0 then "PernaEsquerda" else "PernaDireita", Vector3.new(1, 2, 1), at(x, 1, 0), look.pants))
		add(part(npc, "Sapato", Vector3.new(1.05, 0.35, 1.15), at(x, 0.18, -0.05), look.shoes))
	end
	add(part(npc, "Tronco", Vector3.new(2, 2, 1), at(0, 3, 0), look.shirt))
	add(part(npc, "BracoEsquerdo", Vector3.new(1, 2, 1), at(-1.5, 3, 0), look.sleeves or look.shirt))
	add(part(npc, "BracoDireito", Vector3.new(1, 2, 1), at(1.5, 3, 0), look.sleeves or look.shirt))
	for _, x in { -1.5, 1.5 } do
		add(part(npc, "Mao", Vector3.new(0.95, 0.45, 0.95), at(x, 1.85, 0), skin))
	end
	local head = add(part(npc, "Cabeca", Vector3.new(2, 1, 1), at(0, 4.5, 0), skin))
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Head
	mesh.Scale = Vector3.new(1.25, 1.25, 1.25)
	mesh.Parent = head
	-- rosto
	for _, x in { -0.25, 0.25 } do
		add(ball(npc, "Olho", Vector3.new(0.2, 0.28, 0.08), at(x, 4.62, -0.6), BLACK))
		add(ball(npc, "Brilho", Vector3.new(0.07, 0.08, 0.04), at(x + 0.04, 4.68, -0.64), WHITE))
		add(part(npc, "Sobrancelha", Vector3.new(0.28, 0.06, 0.04), at(x, 4.86, -0.61), look.hair))
	end
	add(part(npc, "Sorriso", Vector3.new(0.36, 0.07, 0.04), at(0, 4.27, -0.62), BLACK))
	for _, x in { -0.2, 0.2 } do
		add(part(npc, "Sorriso", Vector3.new(0.1, 0.07, 0.04), at(x, 4.31, -0.62), BLACK))
		add(ball(npc, "Bochecha", Vector3.new(0.2, 0.12, 0.04), at(x * 2.1, 4.4, -0.58), Color3.fromRGB(255, 160, 160)))
	end
	-- cabelo
	if look.hairStyle ~= "bald" then
		add(part(npc, "Cabelo", Vector3.new(1.32, 0.35, 1.3), at(0, 5.12, 0.02), look.hair))
		add(part(npc, "Cabelo", Vector3.new(1.32, 0.9, 0.3), at(0, 4.72, 0.52), look.hair))
		if look.hairStyle == "long" then
			add(part(npc, "Cabelo", Vector3.new(1.45, 1.9, 0.35), at(0, 4.05, 0.58), look.hair))
			for _, x in { -0.68, 0.68 } do
				add(part(npc, "Cabelo", Vector3.new(0.18, 1.4, 0.9), at(x, 4.35, 0.12), look.hair))
			end
		end
	end
	if look.beard then
		add(ball(npc, "Barba", Vector3.new(1.05, 0.65, 0.5), at(0, 4.1, -0.42), look.beard))
		add(part(npc, "Bigode", Vector3.new(0.6, 0.12, 0.1), at(0, 4.36, -0.64), look.beard))
	end
	if look.glasses then
		for _, x in { -0.25, 0.25 } do
			local lens = add(ball(npc, "Lente", Vector3.new(0.38, 0.32, 0.05), at(x, 4.62, -0.66), Color3.fromRGB(40, 40, 50)))
			lens.Transparency = 0.45
		end
		add(part(npc, "Armacao", Vector3.new(0.22, 0.05, 0.05), at(0, 4.64, -0.67), BLACK))
	end
	-- chapeu
	if look.hat == "straw" then
		add(cylinderPart(npc, "Chapeu", 0.12, 2.7, at(0, 5.28, 0), look.hatColor))
		add(cylinderPart(npc, "Chapeu", 0.6, 1.4, at(0, 5.6, 0), look.hatColor))
		add(cylinderPart(npc, "Fita", 0.16, 1.43, at(0, 5.38, 0), Color3.fromRGB(200, 60, 50)))
	elseif look.hat == "hardhat" then
		add(ball(npc, "Capacete", Vector3.new(1.5, 0.8, 1.5), at(0, 5.18, 0), look.hatColor))
		add(cylinderPart(npc, "Aba", 0.08, 1.75, at(0, 4.98, 0), look.hatColor))
	elseif look.hat == "cap" then
		add(ball(npc, "Bone", Vector3.new(1.38, 0.62, 1.38), at(0, 5.15, 0), look.hatColor))
		add(part(npc, "Aba", Vector3.new(1, 0.08, 0.65), at(0, 5, -0.78), look.hatColor))
	elseif look.hat == "bow" then
		for _, x in { -0.32, 0.32 } do
			add(ball(npc, "Laco", Vector3.new(0.5, 0.42, 0.2), at(x, 5.32, 0.35), look.hatColor))
		end
		add(ball(npc, "Laco", Vector3.new(0.22, 0.22, 0.22), at(0, 5.32, 0.35), look.hatColor))
	end
	-- roupa por cima
	if look.outfit == "overalls" then
		add(part(npc, "Macacao", Vector3.new(1.5, 1.0, 0.12), at(0, 2.7, -0.52), look.outfitColor))
		for _, x in { -0.55, 0.55 } do
			add(part(npc, "Alca", Vector3.new(0.22, 1.1, 0.1), at(x, 3.45, -0.53), look.outfitColor))
			add(ball(npc, "Botao", Vector3.new(0.12, 0.12, 0.05), at(x, 3.05, -0.6), Color3.fromRGB(240, 200, 60)))
		end
	elseif look.outfit == "apron" then
		add(part(npc, "Avental", Vector3.new(1.6, 2.1, 0.1), at(0, 2.55, -0.55), look.outfitColor))
		add(part(npc, "Bolso", Vector3.new(0.8, 0.4, 0.06), at(0, 2.2, -0.62), look.outfitColor:Lerp(Color3.new(0, 0, 0), 0.15)))
	elseif look.outfit == "vest" then
		for _, x in { -0.6, 0.6 } do
			add(part(npc, "Colete", Vector3.new(0.75, 2, 0.1), at(x, 3, -0.53), look.outfitColor))
			add(part(npc, "Faixa", Vector3.new(0.75, 0.12, 0.06), at(x, 2.6, -0.6), Color3.fromRGB(230, 230, 230)))
		end
		add(part(npc, "Cinto", Vector3.new(2.05, 0.25, 1.05), at(0, 2.1, 0), Color3.fromRGB(90, 60, 40)))
	elseif look.outfit == "dress" then
		add(part(npc, "Vestido", Vector3.new(2.3, 1.7, 1.3), at(0, 1.45, 0), look.outfitColor))
	end
	for _, piece in pieces do
		piece.CastShadow = true
	end
	npc.PrimaryPart = head
	npc:SetAttribute("Npc", name)
	CollectionService:AddTag(npc, "LojaNpc")
	npc.Parent = parent
	billboard(head, name, role, look.tagColor or Color3.fromRGB(255, 220, 90), 3)
	return npc
end

-- enfeites tematicos de cada loja (prateleiras no fundo e coisas na frente)
local function stallGoods(model: Model, cf: CFrame, info, rng: Random)
	local function at(x: number, y: number, z: number): CFrame
		return cf * CFrame.new(x, y, z)
	end
	-- prateleiras no fundo
	for _, y in { 4.3, 6.3 } do
		decor(model, "Prateleira", Vector3.new(12, 0.3, 1.2), at(0, y, 3.9), WOOD_DARK, Enum.Material.Wood)
		for i = 1, 8 do
			local x = -5.6 + (i - 1) * 1.6
			local color = info.goods[(i + math.floor(y)) % #info.goods + 1]
			if info.id == "Seeds" then -- pacotinhos de semente
				decor(model, "Pacote", Vector3.new(0.9, 1.2, 0.15), at(x, y + 0.75, 3.75) * CFrame.Angles(math.rad(-8), 0, 0), color)
				decor(model, "Etiqueta", Vector3.new(0.7, 0.35, 0.05), at(x, y + 0.95, 3.66) * CFrame.Angles(math.rad(-8), 0, 0), WHITE)
			elseif info.id == "Sell" then -- potes e frutas
				ball(model, "Fruta", Vector3.new(0.85, 0.85, 0.85), at(x, y + 0.55, 3.8), color)
			elseif info.id == "Gear" then -- regadores e ferramentas
				decor(model, "Ferramenta", Vector3.new(0.9, 0.8, 0.6), at(x, y + 0.55, 3.8), color, Enum.Material.Metal)
				decor(model, "Bico", Vector3.new(0.5, 0.12, 0.12), at(x + 0.55, y + 0.75, 3.8) * CFrame.Angles(0, 0, math.rad(30)), color, Enum.Material.Metal)
			else -- ovos em ninhos
				cylinderPart(model, "Ninho", 0.3, 1.1, at(x, y + 0.3, 3.8), Color3.fromRGB(170, 130, 80), Enum.Material.Fabric)
				ball(model, "Ovo", Vector3.new(0.6, 0.8, 0.6), at(x, y + 0.75, 3.8), color)
			end
		end
	end
	-- caixotes e barris na frente da loja
	for index, x in { -9.6, 9.6 } do
		decor(model, "Caixote", Vector3.new(2.6, 1.8, 2.6), at(x, 0.9, -4) * CFrame.Angles(0, math.rad(index * 7), 0), WOOD, Enum.Material.WoodPlanks)
		for i = 1, 4 do
			local color = info.goods[(i + index) % #info.goods + 1]
			if info.id == "Eggs" then
				ball(model, "Ovo", Vector3.new(0.8, 1, 0.8), at(x - 0.6 + (i % 2) * 1.2, 2, -4.6 + math.floor((i - 1) / 2) * 1.2), color)
			elseif info.id == "Gear" then
				decor(model, "Saco", Vector3.new(1, 1.2, 0.8), at(x - 0.6 + (i % 2) * 1.2, 2.2, -4.6 + math.floor((i - 1) / 2) * 1.2), Color3.fromRGB(190, 160, 110), Enum.Material.Fabric)
			else
				ball(model, "Produto", Vector3.new(1, 1, 1), at(x - 0.6 + (i % 2) * 1.2, 2, -4.6 + math.floor((i - 1) / 2) * 1.2), color)
			end
		end
		local barrel = cylinderPart(model, "Barril", 2.2, 1.9, at(x, 1.1, -1.2), WOOD_DARK, Enum.Material.Wood)
		barrel.CastShadow = true
		for _, y in { 0.45, 1.75 } do
			cylinderPart(model, "Aro", 0.18, 1.96, at(x, y, -1.2), Color3.fromRGB(80, 80, 90), Enum.Material.Metal)
		end
	end
	if info.id == "Sell" then -- balanca e moedas no balcao
		decor(model, "Balanca", Vector3.new(0.3, 1.4, 0.3), at(5, 4.1, -3), Color3.fromRGB(200, 170, 60), Enum.Material.Metal)
		decor(model, "Braco", Vector3.new(2.4, 0.15, 0.15), at(5, 4.8, -3), Color3.fromRGB(200, 170, 60), Enum.Material.Metal)
		for _, dx in { -1.1, 1.1 } do
			cylinderPart(model, "Prato", 0.12, 0.9, at(5 + dx, 4.4, -3), Color3.fromRGB(220, 190, 80), Enum.Material.Metal)
		end
		for i = 1, 5 do
			cylinderPart(model, "Moeda", 0.12, 0.6, at(-5 + rng:NextNumber(-0.3, 0.3), 3.45 + i * 0.13, -3), Color3.fromRGB(255, 205, 50), Enum.Material.Metal)
		end
	end
end

local function buildStall(parent: Instance, info, rng: Random)
	local cf = CFrame.new(info.position) * CFrame.Angles(0, info.rotation, 0)
	local model = Instance.new("Model")
	model.Name = "Loja_" .. info.id

	-- piso de madeira
	part(model, "Piso", Vector3.new(16, 0.3, 11), cf * CFrame.new(0, 0.15, 0.2), WOOD_LIGHT, Enum.Material.WoodPlanks)
	local counter = part(model, "Balcao", Vector3.new(14, 3, 3), cf * CFrame.new(0, 1.5, -3), WOOD, Enum.Material.WoodPlanks)
	part(model, "Tampo", Vector3.new(14.6, 0.4, 3.6), cf * CFrame.new(0, 3.2, -3), WOOD_LIGHT, Enum.Material.Wood)
	-- faixa colorida na frente do balcao
	decor(model, "Faixa", Vector3.new(14.1, 0.8, 0.1), cf * CFrame.new(0, 2.2, -4.55), info.roofA)
	for _, x in { -7, 7 } do
		for _, z in { -4.5, 4.5 } do
			part(model, "Pilar", Vector3.new(0.7, 8.5, 0.7), cf * CFrame.new(x, 4.25, z), WOOD, Enum.Material.Wood)
		end
	end
	part(model, "Fundo", Vector3.new(14, 8, 0.5), cf * CFrame.new(0, 4, 4.5), WOOD_LIGHT, Enum.Material.WoodPlanks)
	for i = 0, 7 do
		local color = if i % 2 == 0 then info.roofA else info.roofB
		part(model, "Telhado", Vector3.new(1.9, 0.4, 11), cf * CFrame.new(-6.65 + i * 1.9, 8.8, 0) * CFrame.Angles(math.rad(-8), 0, 0), color)
		-- babado do toldo
		ball(model, "Babado", Vector3.new(1.9, 1.1, 0.35), cf * CFrame.new(-6.65 + i * 1.9, 9.25 - 5.45 * math.sin(math.rad(8)) - 0.45, -5.45), color)
	end
	-- placa com moldura
	local sign = part(model, "Placa", Vector3.new(12, 2.4, 0.4), cf * CFrame.new(0, 10.6, -4.8), WHITE)
	sign.CanCollide = false
	for _, x in { -6.15, 6.15 } do
		decor(model, "Moldura", Vector3.new(0.3, 2.7, 0.55), cf * CFrame.new(x, 10.6, -4.8), WOOD_DARK, Enum.Material.Wood)
	end
	for _, y in { 9.3, 11.9 } do
		decor(model, "Moldura", Vector3.new(12.6, 0.3, 0.55), cf * CFrame.new(0, y, -4.8), WOOD_DARK, Enum.Material.Wood)
	end
	surfaceText(sign, info.icon .. " " .. info.title, info.roofA)
	-- lampioes pendurados nos pilares da frente
	for _, x in { -7, 7 } do
		decor(model, "Gancho", Vector3.new(0.12, 0.8, 0.12), cf * CFrame.new(x, 7.6, -5.1), Color3.fromRGB(60, 60, 70), Enum.Material.Metal)
		local lamp = decor(model, "Lampiao", Vector3.new(0.7, 0.9, 0.7), cf * CFrame.new(x, 6.8, -5.1), Color3.fromRGB(255, 220, 140), Enum.Material.Neon)
		lamp.CastShadow = false
		decor(model, "TampaLampiao", Vector3.new(0.9, 0.2, 0.9), cf * CFrame.new(x, 7.3, -5.1), Color3.fromRGB(60, 60, 70), Enum.Material.Metal)
	end

	-- produtos decorativos no balcao
	for i = 1, 5 do
		local color = info.goods[(i - 1) % #info.goods + 1]
		ball(model, "Produto", Vector3.new(1, 1, 1), cf * CFrame.new(-5 + i * 1.7, 3.9, -3), color)
	end
	stallGoods(model, cf, info, rng)

	buildNpc(model, cf * CFrame.new(0, 0, 0.8), info.look, info.npc, info.title)

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "AbrirLoja"
	prompt.ActionText = info.action
	prompt.ObjectText = info.title
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt:SetAttribute("Shop", info.id)
	prompt.Parent = counter

	model.Parent = parent
	return cf * CFrame.new(0, 3, -9) * CFrame.Angles(0, math.pi, 0)
end

---------------------------------------------------------------------
-- Praca central com chafariz
---------------------------------------------------------------------

local function buildPlaza(parent: Instance, rng: Random)
	local plaza = Instance.new("Model")
	plaza.Name = "Praca"
	local floor = cylinderPart(plaza, "Piso", 0.3, 34, CFrame.new(0, 0.12, 0), STONE, Enum.Material.Slate)
	floor.CanCollide = true
	cylinderPart(plaza, "Borda", 0.32, 35.4, CFrame.new(0, 0.1, 0), STONE_DARK, Enum.Material.Slate)
	cylinderPart(plaza, "Anel", 0.34, 22, CFrame.new(0, 0.13, 0), Color3.fromRGB(225, 215, 195), Enum.Material.Slate)
	cylinderPart(plaza, "Anel", 0.36, 20.6, CFrame.new(0, 0.14, 0), STONE, Enum.Material.Slate)

	-- chafariz
	local wall = cylinderPart(plaza, "Chafariz", 1.6, 13, CFrame.new(0, 0.9, 0), STONE_DARK, Enum.Material.Slate)
	wall.CanCollide = true
	-- borda em anel (feita de pedacos, para a agua aparecer no meio)
	for i = 0, 15 do
		local angle = i * math.pi / 8
		decor(plaza, "BordaChafariz", Vector3.new(0.9, 0.35, 2.75), CFrame.new(math.cos(angle) * 6.55, 1.85, math.sin(angle) * 6.55) * CFrame.Angles(0, -angle, 0), STONE, Enum.Material.Slate)
	end
	local water = cylinderPart(plaza, "Agua", 0.12, 11.9, CFrame.new(0, 1.74, 0), WATER, Enum.Material.Glass)
	water.Transparency = 0.25
	cylinderPart(plaza, "Coluna", 4.4, 1.6, CFrame.new(0, 3.6, 0), STONE, Enum.Material.Slate)
	cylinderPart(plaza, "Bacia", 0.7, 5.2, CFrame.new(0, 5.6, 0), STONE_DARK, Enum.Material.Slate)
	local topWater = cylinderPart(plaza, "AguaTopo", 0.12, 4.6, CFrame.new(0, 5.98, 0), WATER, Enum.Material.Glass)
	topWater.Transparency = 0.2
	local spout = ball(plaza, "Bica", Vector3.new(1.1, 1.1, 1.1), CFrame.new(0, 6.5, 0), STONE, Enum.Material.Slate)
	local jets = Instance.new("ParticleEmitter")
	jets.Name = "Jatos"
	jets.Color = ColorSequence.new(Color3.fromRGB(170, 215, 255))
	jets.LightEmission = 0.3
	jets.Transparency = NumberSequence.new(0.25, 0.8)
	jets.Size = NumberSequence.new(0.35, 0.15)
	jets.Lifetime = NumberRange.new(1.1, 1.5)
	jets.Speed = NumberRange.new(7, 9)
	jets.SpreadAngle = Vector2.new(25, 25)
	jets.Acceleration = Vector3.new(0, -18, 0)
	jets.Rate = 45
	jets.Parent = spout
	-- peixinhos na agua
	for i = 1, 4 do
		local angle = i * math.pi / 2 + 0.4
		ball(plaza, "Peixe", Vector3.new(0.7, 0.25, 0.35), CFrame.new(math.cos(angle) * 4, 1.55, math.sin(angle) * 4) * CFrame.Angles(0, -angle, 0), Color3.fromRGB(255, 140, 40))
	end

	-- bancos e canteiros de flores em volta
	for i = 0, 3 do
		local angle = i * math.pi / 2 + math.pi / 4
		local benchCF = CFrame.new(math.cos(angle) * 13.5, 0, math.sin(angle) * 13.5) * CFrame.Angles(0, -angle - math.pi / 2, 0)
		decor(plaza, "Banco", Vector3.new(5, 0.35, 1.6), benchCF * CFrame.new(0, 1.4, 0), WOOD, Enum.Material.WoodPlanks)
		decor(plaza, "Encosto", Vector3.new(5, 1.2, 0.3), benchCF * CFrame.new(0, 2.2, 0.75), WOOD, Enum.Material.WoodPlanks)
		for _, x in { -2.1, 2.1 } do
			decor(plaza, "PeBanco", Vector3.new(0.35, 1.3, 1.4), benchCF * CFrame.new(x, 0.65, 0), Color3.fromRGB(60, 60, 70), Enum.Material.Metal)
		end
		local bedAngle = angle + math.pi / 4
		local bedCF = CFrame.new(math.cos(bedAngle) * 14.5, 0, math.sin(bedAngle) * 14.5)
		cylinderPart(plaza, "Canteiro", 0.8, 4.6, bedCF * CFrame.new(0, 0.5, 0), STONE_DARK, Enum.Material.Slate)
		cylinderPart(plaza, "Terra", 0.1, 4, bedCF * CFrame.new(0, 0.92, 0), Color3.fromRGB(100, 66, 40), Enum.Material.Ground)
		for j = 1, 7 do
			local a = j * math.pi * 2 / 7
			flower(plaza, (bedCF * CFrame.new(math.cos(a) * 1.3, 0.92, math.sin(a) * 1.3)).Position, FLOWER_COLORS[rng:NextInteger(1, #FLOWER_COLORS)], 1.2)
		end
		ball(plaza, "Arbusto", Vector3.new(1.6, 1.4, 1.6), bedCF * CFrame.new(0, 1.5, 0), Color3.fromRGB(70, 160, 60))
	end

	-- placa de boas-vindas em um portal de madeira
	for _, x in { -14, 14 } do
		local post = part(plaza, "PostePortal", Vector3.new(1.2, 16, 1.2), CFrame.new(x, 8, 0), WOOD_DARK, Enum.Material.Wood)
		post.CanCollide = true
		decor(plaza, "Tampa", Vector3.new(1.6, 0.5, 1.6), CFrame.new(x, 16.2, 0), WOOD_LIGHT, Enum.Material.Wood)
		ball(plaza, "Arbusto", Vector3.new(2.6, 2, 2.6), CFrame.new(x, 1, 0), Color3.fromRGB(70, 160, 60))
	end
	local welcome = part(plaza, "Boas-vindas", Vector3.new(26, 5, 0.6), CFrame.new(0, 14, 0), Color3.fromRGB(255, 250, 235))
	welcome.CanCollide = false
	for _, y in { 11.35, 16.65 } do
		decor(plaza, "Moldura", Vector3.new(27, 0.4, 0.9), CFrame.new(0, y, 0), WOOD_DARK, Enum.Material.Wood)
	end
	surfaceText(welcome, "🌱 Cultive um Jardim 🌱", Color3.fromRGB(70, 150, 50), Enum.NormalId.Front)
	surfaceText(welcome, "🌱 Cultive um Jardim 🌱", Color3.fromRGB(70, 150, 50), Enum.NormalId.Back)
	for i = 1, 9 do -- florzinhas em cima da placa
		local x = -12 + (i - 1) * 3
		ball(plaza, "Folha", Vector3.new(1.4, 0.7, 0.9), CFrame.new(x, 17.1, 0), Color3.fromRGB(70, 160, 60))
		ball(plaza, "Flor", Vector3.new(0.6, 0.6, 0.6), CFrame.new(x + 0.3, 17.5, 0), FLOWER_COLORS[i % #FLOWER_COLORS + 1])
	end
	plaza.Parent = parent
end

---------------------------------------------------------------------
-- Decoracao
---------------------------------------------------------------------

local function buildTree(parent: Instance, position: Vector3, scale: number, rng: Random)
	local kind = rng:NextInteger(1, 10)
	if kind <= 2 then -- pinheiro em camadas
		local trunk = part(parent, "Tronco", Vector3.new(1.1, 5, 1.1) * scale, CFrame.new(position + Vector3.new(0, 2.5 * scale, 0)), Color3.fromRGB(100, 68, 42), Enum.Material.Wood)
		trunk.CastShadow = true
		trunk.CanCollide = false
		for i = 0, 3 do
			cylinderPart(parent, "Copa", 1.6 * scale, (7.5 - i * 1.7) * scale, CFrame.new(position + Vector3.new(0, (3.4 + i * 1.9) * scale, 0)), Color3.fromRGB(40, 120 + i * 8, 60))
		end
		ball(parent, "Topo", Vector3.new(1.4, 1.6, 1.4) * scale, CFrame.new(position + Vector3.new(0, 10.6 * scale, 0)), Color3.fromRGB(50, 150, 70))
		return
	end
	local trunk = part(parent, "Tronco", Vector3.new(1.2, 6, 1.2) * scale, CFrame.new(position + Vector3.new(0, 3 * scale, 0)), Color3.fromRGB(110, 75, 45), Enum.Material.Wood)
	trunk.CastShadow = true
	for i = 1, 3 do -- raizes
		local angle = i * math.pi * 2 / 3 + rng:NextNumber(0, 1)
		ball(parent, "Raiz", Vector3.new(1.4, 0.6, 0.7) * scale, CFrame.new(position + Vector3.new(math.cos(angle) * 0.7, 0.2, math.sin(angle) * 0.7) * scale) * CFrame.Angles(0, -angle, 0), Color3.fromRGB(100, 68, 42))
	end
	local blossom = kind == 3
	local base = if blossom then Color3.fromRGB(255, 175, 205) else Color3.fromRGB(60, 150, 55)
	local shades = { base, base:Lerp(WHITE, 0.12), base:Lerp(BLACK, 0.12) }
	local blobs = {
		{ Vector3.new(0, 7.5, 0), Vector3.new(7, 6, 7) },
		{ Vector3.new(1.9, 9.4, 0.5), Vector3.new(4.6, 4, 4.6) },
		{ Vector3.new(-1.8, 8.9, -0.9), Vector3.new(4.2, 3.8, 4.2) },
		{ Vector3.new(0.3, 8.6, 2), Vector3.new(4, 3.6, 4) },
		{ Vector3.new(-0.4, 10.4, -0.2), Vector3.new(3.6, 3, 3.6) },
	}
	for i, blob in blobs do
		ball(parent, "Copa", blob[2] * scale, CFrame.new(position + blob[1] * scale), shades[(i - 1) % #shades + 1])
	end
	if kind == 4 then -- macieira
		for i = 1, 7 do
			local angle = i * 0.9
			ball(parent, "Maca", Vector3.new(0.7, 0.7, 0.7) * scale, CFrame.new(position + Vector3.new(math.cos(angle) * 3.2, 6.6 + (i % 3) * 0.8, math.sin(angle) * 3.2) * scale), Color3.fromRGB(220, 40, 45))
		end
	end
end

local function buildBush(parent: Instance, position: Vector3, rng: Random)
	local size = rng:NextNumber(1.6, 3)
	local color = Color3.fromRGB(65, 150 + rng:NextInteger(0, 25), 55)
	ball(parent, "Arbusto", Vector3.new(size * 1.3, size, size * 1.2), CFrame.new(position + Vector3.new(0, size * 0.4, 0)), color)
	ball(parent, "Arbusto", Vector3.new(size, size * 0.8, size), CFrame.new(position + Vector3.new(size * 0.55, size * 0.3, size * 0.2)), color:Lerp(WHITE, 0.08))
	if rng:NextNumber() < 0.5 then -- frutinhas ou flores no arbusto
		local berry = FLOWER_COLORS[rng:NextInteger(1, #FLOWER_COLORS)]
		for i = 1, 4 do
			local angle = i * 1.6
			ball(parent, "Frutinha", Vector3.new(0.35, 0.35, 0.35), CFrame.new(position + Vector3.new(math.cos(angle) * size * 0.55, size * (0.55 + (i % 2) * 0.2), math.sin(angle) * size * 0.5)), berry)
		end
	end
end

local function buildRock(parent: Instance, position: Vector3, rng: Random)
	local size = rng:NextNumber(1, 3)
	local gray = Color3.fromRGB(140, 140, 135):Lerp(Color3.fromRGB(180, 175, 165), rng:NextNumber())
	ball(parent, "Pedra", Vector3.new(size * 1.4, size * 0.8, size), CFrame.new(position + Vector3.new(0, size * 0.2, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0), gray, Enum.Material.Slate)
	if size > 2 then
		ball(parent, "Pedra", Vector3.new(size * 0.6, size * 0.45, size * 0.5), CFrame.new(position + Vector3.new(size * 0.7, 0.1, size * 0.3)), gray:Lerp(BLACK, 0.1), Enum.Material.Slate)
	end
end

local function buildLamp(parent: Instance, position: Vector3)
	local metal = Color3.fromRGB(55, 58, 68)
	cylinderPart(parent, "BaseLuz", 0.6, 1.4, CFrame.new(position + Vector3.new(0, 0.3, 0)), metal, Enum.Material.Metal)
	part(parent, "PosteLuz", Vector3.new(0.45, 8.4, 0.45), CFrame.new(position + Vector3.new(0, 4.6, 0)), metal, Enum.Material.Metal)
	decor(parent, "TopoLuz", Vector3.new(1.5, 0.25, 1.5), CFrame.new(position + Vector3.new(0, 8.9, 0)), metal, Enum.Material.Metal)
	local lamp = decor(parent, "Lampada", Vector3.new(1.1, 1.3, 1.1), CFrame.new(position + Vector3.new(0, 9.7, 0)), Color3.fromRGB(255, 235, 170), Enum.Material.Neon)
	lamp.CastShadow = false
	for _, offset in { Vector3.new(0.58, 0, 0.58), Vector3.new(-0.58, 0, 0.58), Vector3.new(0.58, 0, -0.58), Vector3.new(-0.58, 0, -0.58) } do
		decor(parent, "Grade", Vector3.new(0.12, 1.4, 0.12), CFrame.new(position + Vector3.new(0, 9.7, 0) + offset), metal, Enum.Material.Metal)
	end
	decor(parent, "Chapeu", Vector3.new(1.6, 0.3, 1.6), CFrame.new(position + Vector3.new(0, 10.5, 0)), metal, Enum.Material.Metal)
	ball(parent, "Ponta", Vector3.new(0.4, 0.4, 0.4), CFrame.new(position + Vector3.new(0, 10.8, 0)), metal, Enum.Material.Metal)
	local light = Instance.new("PointLight")
	light.Range = 20
	light.Brightness = 1.6
	light.Color = Color3.fromRGB(255, 215, 150)
	light.Parent = lamp
	return light
end

local function setupLighting()
	Lighting.ClockTime = 14
	Lighting.Brightness = 2.2
	Lighting.GlobalShadows = true
	Lighting.Ambient = Color3.fromRGB(95, 95, 105)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 148, 140)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.35
	Lighting.ShadowSoftness = 0.25
	Lighting.ExposureCompensation = 0.1
	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		local atmosphere = Instance.new("Atmosphere")
		atmosphere.Density = 0.3
		atmosphere.Offset = 0.15
		atmosphere.Haze = 1
		atmosphere.Glare = 0.4
		atmosphere.Color = Color3.fromRGB(200, 220, 255)
		atmosphere.Decay = Color3.fromRGB(120, 150, 200)
		atmosphere.Parent = Lighting
	end
	-- cores mais vivas, brilho suave nas luzes e raios de sol
	if not Lighting:FindFirstChild("CoresJardim") then
		local color = Instance.new("ColorCorrectionEffect")
		color.Name = "CoresJardim"
		color.Saturation = 0.15
		color.Contrast = 0.06
		color.Brightness = 0.02
		color.TintColor = Color3.fromRGB(255, 251, 242)
		color.Parent = Lighting
		local bloom = Instance.new("BloomEffect")
		bloom.Name = "BrilhoJardim"
		bloom.Intensity = 0.5
		bloom.Size = 26
		bloom.Threshold = 1.6
		bloom.Parent = Lighting
		local sunRays = Instance.new("SunRaysEffect")
		sunRays.Name = "RaiosJardim"
		sunRays.Intensity = 0.05
		sunRays.Spread = 0.6
		sunRays.Parent = Lighting
	end
	-- nuvens de verdade no ceu
	local terrain = workspace:FindFirstChildOfClass("Terrain")
	if terrain and not terrain:FindFirstChildOfClass("Clouds") then
		local clouds = Instance.new("Clouds")
		clouds.Cover = 0.55
		clouds.Density = 0.7
		clouds.Color = Color3.fromRGB(255, 255, 255)
		clouds.Parent = terrain
	end
end

-- area livre para enfeites (fora da rua, dos jardins, das lojas e da praca)
local function isFree(x: number, z: number, margin: number): boolean
	local L = MapBuilder.Layout
	if math.abs(x) > 200 or math.abs(z) > 150 then
		return false
	end
	if math.abs(z) < 23 + margin and math.abs(x) < 190 then
		return false
	end
	for _, cx in L.columns do
		for _, cz in { L.rowZ, -L.rowZ } do
			if math.abs(x - cx) < L.plotHalfX + 4 + margin and math.abs(z - cz) < L.plotHalfZ + 5 + margin then
				return false
			end
		end
	end
	for _, sx in { -40, 40 } do
		for _, sz in { -30, 30 } do
			if math.abs(x - sx) < 12 + margin and math.abs(z - sz) < 10 + margin then
				return false
			end
		end
	end
	return true
end

local function randomFreeSpot(rng: Random, margin: number): Vector3?
	for _ = 1, 40 do
		local x, z = rng:NextNumber(-198, 198), rng:NextNumber(-148, 148)
		if isFree(x, z, margin) then
			return Vector3.new(x, 0, z)
		end
	end
	return nil
end

---------------------------------------------------------------------
-- Construcao completa
---------------------------------------------------------------------

function MapBuilder.build()
	local old = workspace:FindFirstChild("Mapa")
	if old then
		old:Destroy()
	end
	local map = Instance.new("Folder")
	map.Name = "Mapa"
	local rng = Random.new(2025) -- sempre o mesmo mapa

	setupLighting()

	part(map, "Chao", Vector3.new(900, 2, 800), CFrame.new(0, -1, 0), Color3.fromRGB(95, 170, 70), Enum.Material.Grass)
	part(map, "Rua", Vector3.new(360, 0.2, 40), CFrame.new(0, 0, 0), Color3.fromRGB(220, 200, 150), Enum.Material.Sand)
	-- meio-fio de pedra (com aberturas nas entradas dos jardins)
	for _, z in { -20.3, 20.3 } do
		local edges = { -180, -86, -74, -6, 6, 74, 86, 180 }
		for i = 1, #edges - 1, 2 do
			local x1, x2 = edges[i], edges[i + 1]
			decor(map, "MeioFio", Vector3.new(x2 - x1, 0.4, 0.8), CFrame.new((x1 + x2) / 2, 0.2, z), STONE, Enum.Material.Slate)
		end
	end

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(8, 0.4, 6)
	spawn.CFrame = CFrame.new(0, 0.2, -12)
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.TopSurface = SMOOTH
	spawn.Parent = map

	buildPlaza(map, rng)

	-- jardins: 3 de cada lado da rua
	local L = MapBuilder.Layout
	local plots = {}
	for row = 1, 2 do
		local z = if row == 1 then L.rowZ else -L.rowZ
		local rotation = if row == 1 then 0 else math.pi
		for _, x in L.columns do
			table.insert(plots, buildPlot(#plots + 1, Vector3.new(x, 0, z), rotation, map, rng))
		end
	end

	-- lojas entre os jardins
	local stalls = {
		{
			id = "Seeds", title = "Sementes", icon = "🌱", npc = "Sam", action = "Comprar sementes",
			position = Vector3.new(-40, 0, 30), rotation = 0,
			roofA = Color3.fromRGB(70, 160, 60), roofB = Color3.fromRGB(240, 240, 230),
			goods = { Color3.fromRGB(255, 140, 30), Color3.fromRGB(225, 30, 55), Color3.fromRGB(60, 80, 210), Color3.fromRGB(240, 70, 110) },
			look = {
				tagColor = Color3.fromRGB(120, 220, 90),
				skin = Color3.fromRGB(255, 205, 160), hair = Color3.fromRGB(110, 70, 40), hairStyle = "short",
				hat = "straw", hatColor = Color3.fromRGB(235, 205, 120),
				shirt = Color3.fromRGB(90, 170, 70), pants = Color3.fromRGB(60, 90, 150), shoes = Color3.fromRGB(90, 60, 40),
				outfit = "overalls", outfitColor = Color3.fromRGB(60, 90, 150),
			},
		},
		{
			id = "Sell", title = "Venda", icon = "💰", npc = "Steven", action = "Vender frutos",
			position = Vector3.new(40, 0, 30), rotation = 0,
			roofA = Color3.fromRGB(230, 170, 30), roofB = Color3.fromRGB(240, 240, 230),
			goods = { Color3.fromRGB(255, 205, 40), Color3.fromRGB(255, 230, 120), Color3.fromRGB(225, 40, 50), Color3.fromRGB(120, 200, 70) },
			look = {
				tagColor = Color3.fromRGB(255, 205, 60),
				skin = Color3.fromRGB(240, 190, 150), hair = Color3.fromRGB(240, 210, 110), hairStyle = "short",
				hat = "cap", hatColor = Color3.fromRGB(230, 170, 30), glasses = true,
				shirt = Color3.fromRGB(70, 130, 210), pants = Color3.fromRGB(90, 90, 100), shoes = Color3.fromRGB(40, 40, 45),
				outfit = "apron", outfitColor = Color3.fromRGB(245, 205, 70),
			},
		},
		{
			id = "Gear", title = "Equipamentos", icon = "🔧", npc = "George", action = "Comprar equipamentos",
			position = Vector3.new(-40, 0, -30), rotation = math.pi,
			roofA = Color3.fromRGB(60, 120, 210), roofB = Color3.fromRGB(240, 240, 230),
			goods = { Color3.fromRGB(80, 140, 230), Color3.fromRGB(170, 170, 180), Color3.fromRGB(90, 200, 90), Color3.fromRGB(250, 200, 50) },
			look = {
				tagColor = Color3.fromRGB(110, 170, 255),
				skin = Color3.fromRGB(230, 180, 140), hair = Color3.fromRGB(150, 150, 150), hairStyle = "short",
				hat = "hardhat", hatColor = Color3.fromRGB(250, 200, 40), beard = Color3.fromRGB(170, 170, 170),
				shirt = Color3.fromRGB(110, 110, 120), pants = Color3.fromRGB(50, 50, 60), shoes = Color3.fromRGB(70, 50, 35),
				outfit = "vest", outfitColor = Color3.fromRGB(250, 130, 40),
			},
		},
		{
			id = "Eggs", title = "Ovos & Pets", icon = "🥚", npc = "Eloise", action = "Comprar ovos",
			position = Vector3.new(40, 0, -30), rotation = math.pi,
			roofA = Color3.fromRGB(200, 90, 200), roofB = Color3.fromRGB(240, 240, 230),
			goods = { Color3.fromRGB(240, 235, 220), Color3.fromRGB(150, 230, 140), Color3.fromRGB(120, 170, 255), Color3.fromRGB(255, 215, 70) },
			look = {
				tagColor = Color3.fromRGB(230, 140, 255),
				skin = Color3.fromRGB(255, 215, 185), hair = Color3.fromRGB(250, 140, 190), hairStyle = "long",
				hat = "bow", hatColor = Color3.fromRGB(255, 255, 255),
				shirt = Color3.fromRGB(250, 240, 250), sleeves = Color3.fromRGB(170, 90, 210), pants = Color3.fromRGB(170, 90, 210), shoes = Color3.fromRGB(250, 250, 250),
				outfit = "dress", outfitColor = Color3.fromRGB(170, 90, 210),
			},
		},
	}
	local locations = {}
	local shopPositions = {}
	for _, info in stalls do
		locations[info.id] = buildStall(map, info, rng)
		shopPositions[info.id] = info.position
	end
	locations.Spawn = CFrame.new(0, 3, -12)

	-- decoracao
	local decorFolder = Instance.new("Folder")
	decorFolder.Name = "Decoracao"
	decorFolder.Parent = map
	-- postes entre as entradas dos jardins (x = -140, -100, ..., 140)
	local lights = {}
	for x = -140, 140, 40 do
		for _, z in { -19, 19 } do
			table.insert(lights, buildLamp(decorFolder, Vector3.new(x, 0, z + (if z > 0 then 2.2 else -2.2))))
		end
	end
	-- floreiras ao longo da rua, entre os postes
	for x = -160, 160, 40 do
		if math.abs(x) > 20 then
			for _, z in { -22, 22 } do
				if isFree(x, z + (if z > 0 then 3 else -3), -4) then
					flowerBox(decorFolder, CFrame.new(x, 0, z + (if z > 0 then 1.6 else -1.6)), 6, rng)
				end
			end
		end
	end
	-- arvores na borda do mapa e entre os jardins
	for x = -180, 180, 30 do
		buildTree(decorFolder, Vector3.new(x + (x % 20), 0, 115 + (x % 3) * 4), 1 + (x % 7) / 10, rng)
		buildTree(decorFolder, Vector3.new(x - (x % 20), 0, -115 - (x % 3) * 4), 1 + (x % 5) / 10, rng)
	end
	for _, x in { -150, -130, 130, 150 } do
		for _, z in { -60, -30, 30, 60 } do
			buildTree(decorFolder, Vector3.new(x, 0, z), 1.1, rng)
		end
	end
	for _ = 1, 18 do
		local spot = randomFreeSpot(rng, 6)
		if spot then
			buildTree(decorFolder, spot, rng:NextNumber(0.8, 1.3), rng)
		end
	end
	-- manchas de grama, flores, arbustos e pedras espalhados
	for _ = 1, 45 do
		local spot = randomFreeSpot(rng, 0)
		if spot then
			local tone = Color3.fromRGB(95, 170, 70):Lerp(if rng:NextNumber() < 0.5 then Color3.fromRGB(70, 140, 55) else Color3.fromRGB(140, 200, 90), rng:NextNumber(0.3, 0.7))
			local patch = cylinderPart(decorFolder, "Mancha", 0.06, rng:NextNumber(8, 20), CFrame.new(spot + Vector3.new(0, 0.02, 0)), tone, Enum.Material.Grass)
			patch.CastShadow = false
		end
	end
	for _ = 1, 60 do
		local spot = randomFreeSpot(rng, 0)
		if spot then
			local color = FLOWER_COLORS[rng:NextInteger(1, #FLOWER_COLORS)]
			for i = 1, rng:NextInteger(3, 6) do
				flower(decorFolder, spot + Vector3.new(rng:NextNumber(-1.6, 1.6), 0, rng:NextNumber(-1.6, 1.6)), if i % 3 == 0 then FLOWER_COLORS[rng:NextInteger(1, #FLOWER_COLORS)] else color, rng:NextNumber(0.9, 1.4))
			end
		end
	end
	for _ = 1, 34 do
		local spot = randomFreeSpot(rng, 2)
		if spot then
			buildBush(decorFolder, spot, rng)
		end
	end
	for _ = 1, 24 do
		local spot = randomFreeSpot(rng, 2)
		if spot then
			buildRock(decorFolder, spot, rng)
		end
	end
	-- morros no horizonte (fora da area de jogo)
	for i = 1, 26 do
		local angle = i * math.pi * 2 / 26 + rng:NextNumber(-0.08, 0.08)
		local distance = rng:NextNumber(270, 340)
		local width = rng:NextNumber(90, 150)
		local height = rng:NextNumber(35, 70)
		local tone = Color3.fromRGB(80, 150, 70):Lerp(Color3.fromRGB(60, 120, 80), rng:NextNumber())
		ball(decorFolder, "Morro", Vector3.new(width, height, width * 0.8), CFrame.new(math.cos(angle) * distance * 1.2, -height * 0.18, math.sin(angle) * distance) * CFrame.Angles(0, -angle, 0), tone, Enum.Material.Grass)
	end

	-- paredes invisiveis nas bordas
	local walls = {
		{ Vector3.new(420, 60, 2), Vector3.new(0, 30, 160) },
		{ Vector3.new(420, 60, 2), Vector3.new(0, 30, -160) },
		{ Vector3.new(2, 60, 320), Vector3.new(210, 30, 0) },
		{ Vector3.new(2, 60, 320), Vector3.new(-210, 30, 0) },
	}
	for _, wall in walls do
		local p = part(map, "Parede", wall[1], CFrame.new(wall[2]), WHITE)
		p.Transparency = 1
		p.CastShadow = false
	end

	map.Parent = workspace

	return {
		folder = map,
		plots = plots,
		locations = locations,
		shopPositions = shopPositions,
		lights = lights,
	}
end

return MapBuilder
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000D">
				<Properties>
					<string name="Name">PetService</string>
					<ProtectedString name="Source"><![CDATA[-- PetService: pets chocados dos ovos, equipar/desequipar, variantes e niveis.
-- Os pets ganham XP enquanto estao equipados e ficam mais fortes a cada nivel.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Formulas = require(Shared:WaitForChild("Formulas"))
local DataService = require(script.Parent.DataService)
local Sync = require(script.Parent.Sync)

local PetService = {}

local listeners: { (Player) -> () } = {}

-- Avisa outros servicos quando os pets equipados mudam
function PetService.onChanged(callback: (Player) -> ())
	table.insert(listeners, callback)
end

local function changed(player: Player)
	for _, callback in listeners do
		callback(player)
	end
end

function PetService.getBonuses(data)
	return Formulas.petBonuses(data.pets, data.equippedPets)
end

-- Atributo lido pelos clientes para desenhar os pets seguindo o jogador
-- formato: "Dog:Big:12,Cat::3" (id, variante, nivel)
function PetService.updateAttribute(player: Player, data)
	local entries = {}
	for _, pet in data.pets do
		if table.find(data.equippedPets, pet.id) then
			table.insert(entries, string.format("%s:%s:%d", pet.p, pet.v or "", Formulas.petLevel(pet.xp)))
		end
	end
	player:SetAttribute("EquippedPets", table.concat(entries, ","))
end

-- Remove ids de pets equipados que nao existem mais
local function cleanEquipped(data)
	for i = #data.equippedPets, 1, -1 do
		local id = data.equippedPets[i]
		local exists = false
		for _, pet in data.pets do
			if pet.id == id then
				exists = true
				break
			end
		end
		if not exists or i > Config.MaxPetsEquipped then
			table.remove(data.equippedPets, i)
		end
	end
end

function PetService.setup(player: Player, data)
	cleanEquipped(data)
	PetService.updateAttribute(player, data)
end

function PetService.addPet(player: Player, data, petId: string, variantId: string?)
	local pet = { id = data.nextId, p = petId, v = variantId, xp = 0 }
	data.nextId += 1
	table.insert(data.pets, pet)
	if #data.equippedPets < Config.MaxPetsEquipped then
		table.insert(data.equippedPets, pet.id)
	end
	PetService.updateAttribute(player, data)
	Sync.markDirty(player)
	changed(player)
	return pet
end

-- XP para os pets equipados (chamado a cada meio segundo)
function PetService.addXp(player: Player, data, dt: number)
	local leveled = false
	for _, pet in data.pets do
		if table.find(data.equippedPets, pet.id) then
			local before = Formulas.petLevel(pet.xp)
			pet.xp = (pet.xp or 0) + dt
			local after = Formulas.petLevel(pet.xp)
			if after > before then
				leveled = true
				Sync.notify(player, string.format("⬆️ %s subiu para o nível %d!", Formulas.petName(pet), after), "success")
			end
		end
	end
	if leveled then
		PetService.updateAttribute(player, data)
		Sync.markDirty(player)
		changed(player)
	end
end

function PetService.handleAction(player: Player, action: any, petUid: any): (boolean, string)
	local data = DataService.get(player)
	if not data then
		return false, "Seus dados ainda estão carregando."
	end
	if type(action) ~= "string" or type(petUid) ~= "number" then
		return false, "Pedido inválido."
	end
	local pet = nil
	for _, candidate in data.pets do
		if candidate.id == petUid then
			pet = candidate
			break
		end
	end
	if not pet then
		return false, "Pet não encontrado."
	end
	local name = Formulas.petName(pet)
	local equippedIndex = table.find(data.equippedPets, pet.id)
	if action == "equip" then
		if equippedIndex then
			return false, "Esse pet já está equipado."
		end
		if #data.equippedPets >= Config.MaxPetsEquipped then
			return false, string.format("Você só pode equipar %d pets.", Config.MaxPetsEquipped)
		end
		table.insert(data.equippedPets, pet.id)
		PetService.updateAttribute(player, data)
		Sync.markDirty(player)
		changed(player)
		return true, name .. " equipado!"
	elseif action == "unequip" then
		if not equippedIndex then
			return false, "Esse pet não está equipado."
		end
		table.remove(data.equippedPets, equippedIndex)
		PetService.updateAttribute(player, data)
		Sync.markDirty(player)
		changed(player)
		return true, name .. " guardado."
	end
	return false, "Ação desconhecida."
end

return PetService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000E">
				<Properties>
					<string name="Name">QuestService</string>
					<ProtectedString name="Source"><![CDATA[-- QuestService: missoes diarias (3 por dia, trocam a meia-noite UTC).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Formulas = require(Shared:WaitForChild("Formulas"))
local DataService = require(script.Parent.DataService)
local Sync = require(script.Parent.Sync)

local QuestService = {}

local function today(): number
	return math.floor(os.time() / 86400)
end

local function findTemplate(id: string)
	for _, template in Config.Quests.templates do
		if template.id == id then
			return template
		end
	end
	return nil
end

-- Recompensa cresce com o quanto o jogador ja ganhou (continua valendo a pena no fim do jogo)
local function rewardFor(template, target: number, data): number
	local scale = math.max(1, math.sqrt(math.max(data.stats.earned, 0)) / 40)
	return math.floor(template.reward * target * scale)
end

-- Gera as missoes do dia se ainda nao existirem
function QuestService.ensure(player: Player, data): boolean
	local day = today()
	if data.quests.day == day and #data.quests.list > 0 then
		return false
	end
	local rng = Random.new(day * 7919 + math.abs(player.UserId) % 100000)
	local pool = table.clone(Config.Quests.templates)
	local list = {}
	for _ = 1, math.min(Config.Quests.perDay, #pool) do
		local template = table.remove(pool, rng:NextInteger(1, #pool))
		local target = rng:NextInteger(template.min, template.max)
		table.insert(list, {
			id = template.id,
			target = target,
			progress = 0,
			reward = rewardFor(template, target, data),
			claimed = false,
		})
	end
	data.quests.day = day
	data.quests.list = list
	return true
end

function QuestService.progress(player: Player, kind: string, amount: number)
	local data = DataService.get(player)
	if not data then
		return
	end
	QuestService.ensure(player, data)
	for _, quest in data.quests.list do
		if quest.id == kind and not quest.claimed and quest.progress < quest.target then
			quest.progress = math.min(quest.target, quest.progress + amount)
			if quest.progress >= quest.target then
				local template = findTemplate(quest.id)
				local text = if template then string.format(template.text, quest.target) else quest.id
				Sync.notify(player, "📜 Missão completa: " .. text .. "! Pegue a recompensa em Missões.", "success")
			end
			Sync.markDirty(player)
		end
	end
end

function QuestService.claim(player: Player, index: any): (boolean, string)
	local data = DataService.get(player)
	if not data then
		return false, "Seus dados ainda estão carregando."
	end
	if type(index) ~= "number" then
		return false, "Pedido inválido."
	end
	QuestService.ensure(player, data)
	local quest = data.quests.list[index]
	if not quest then
		return false, "Missão não encontrada."
	end
	if quest.claimed then
		return false, "Você já pegou essa recompensa."
	end
	if quest.progress < quest.target then
		return false, "Missão ainda não terminou."
	end
	quest.claimed = true
	data.sheckles += quest.reward
	Sync.markDirty(player)
	return true, "Recompensa: " .. Formulas.formatMoney(quest.reward) .. "!"
end

-- Lista para a interface
function QuestService.snapshot(data)
	local list = {}
	for index, quest in data.quests.list do
		local template = findTemplate(quest.id)
		table.insert(list, {
			i = index,
			icon = if template then template.icon else "📜",
			text = if template then string.format(template.text, quest.target) else quest.id,
			progress = quest.progress,
			target = quest.target,
			reward = quest.reward,
			claimed = quest.claimed,
		})
	end
	return list
end

return QuestService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000F">
				<Properties>
					<string name="Name">Remotes</string>
					<ProtectedString name="Source"><![CDATA[-- Remotes: cria os RemoteEvents/RemoteFunctions usados entre cliente e servidor.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = {}

local folder = ReplicatedStorage:FindFirstChild("Remotes")
if not folder then
	folder = Instance.new("Folder")
	folder.Name = "Remotes"
end

local function make(className: string, name: string)
	local remote = folder:FindFirstChild(name)
	if not remote then
		remote = Instance.new(className)
		remote.Name = name
		remote.Parent = folder
	end
	return remote
end

-- Servidor -> cliente
Remotes.Notify = make("RemoteEvent", "Notify") :: RemoteEvent
Remotes.StateChanged = make("RemoteEvent", "StateChanged") :: RemoteEvent
-- Cliente -> servidor
Remotes.UseItem = make("RemoteEvent", "UseItem") :: RemoteEvent
Remotes.Teleport = make("RemoteEvent", "Teleport") :: RemoteEvent
Remotes.RequestState = make("RemoteEvent", "RequestState") :: RemoteEvent
Remotes.Buy = make("RemoteFunction", "Buy") :: RemoteFunction
Remotes.Sell = make("RemoteFunction", "Sell") :: RemoteFunction
Remotes.PetAction = make("RemoteFunction", "PetAction") :: RemoteFunction
Remotes.QuestAction = make("RemoteFunction", "QuestAction") :: RemoteFunction

folder.Parent = ReplicatedStorage

return Remotes
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000010">
				<Properties>
					<string name="Name">ShopService</string>
					<ProtectedString name="Source"><![CDATA[-- ShopService: lojas de sementes, equipamentos e ovos, venda de frutos
-- e reabastecimento a cada 5 minutos (estoque igual para todos os servidores).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Formulas = require(Shared:WaitForChild("Formulas"))
local DataService = require(script.Parent.DataService)
local QuestService = require(script.Parent.QuestService)
local Sync = require(script.Parent.Sync)

local ShopService = {}

local shopPositions: { [string]: Vector3 } = {}

local CATEGORIES = {
	Seeds = { items = Config.Seeds, stockKey = "seeds", shop = "Seeds" },
	Gear = { items = Config.Gear, stockKey = "gear", shop = "Gear" },
	Eggs = { items = Config.Eggs, stockKey = "eggs", shop = "Eggs" },
}

local function currentWindow(): number
	return Formulas.restockWindow(os.time())
end

function ShopService.init(map)
	shopPositions = map.shopPositions
end

-- Atualiza o estoque do jogador se ja passou o tempo de reabastecer
function ShopService.ensureStock(data): boolean
	local window = currentWindow()
	if data.stock.window == window then
		return false
	end
	data.stock.window = window
	data.stock.seeds = Formulas.rollStock(Config.SeedList, window, 1)
	data.stock.gear = Formulas.rollStock(Config.GearList, window, 2)
	data.stock.eggs = Formulas.rollStock(Config.EggList, window, 3)
	return true
end

local function isNear(player: Player, shopId: string): boolean
	local position = shopPositions[shopId]
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not position or not root or not root:IsA("BasePart") then
		return false
	end
	return (root.Position - position).Magnitude <= Config.ShopInteractDistance
end

function ShopService.buy(player: Player, category: any, itemId: any): (boolean, string)
	local data = DataService.get(player)
	if not data then
		return false, "Seus dados ainda estão carregando."
	end
	if type(category) ~= "string" or type(itemId) ~= "string" then
		return false, "Pedido inválido."
	end
	local info = CATEGORIES[category]
	if not info then
		return false, "Loja inválida."
	end
	local item = info.items[itemId]
	if not item then
		return false, "Item inválido."
	end
	if not isNear(player, info.shop) then
		return false, "Chegue mais perto da loja!"
	end
	ShopService.ensureStock(data)
	local stockList = data.stock[info.stockKey]
	local stock = stockList[itemId] or 0
	if stock <= 0 then
		return false, "Sem estoque! Espere o reabastecimento."
	end
	if data.sheckles < item.price then
		return false, "Sheckles insuficientes!"
	end
	if category == "Gear" and item.unique and (data.gear[itemId] or 0) > 0 then
		return false, "Você já tem " .. item.name .. "."
	end
	data.sheckles -= item.price
	stockList[itemId] = stock - 1
	if category == "Seeds" then
		data.seeds[itemId] = (data.seeds[itemId] or 0) + 1
	elseif category == "Gear" then
		local amount = if item.kind == "water" then item.uses else 1
		data.gear[itemId] = (data.gear[itemId] or 0) + amount
	else
		data.eggs[itemId] = (data.eggs[itemId] or 0) + 1
	end
	Sync.markDirty(player)
	return true, "Você comprou " .. item.name .. "!"
end

-- mode "all" vende tudo; mode "one" vende o fruto de indice index
-- (seedId e weight confirmam que e o fruto certo)
function ShopService.sell(player: Player, mode: any, index: any, seedId: any, weight: any): (boolean, string)
	local data = DataService.get(player)
	if not data then
		return false, "Seus dados ainda estão carregando."
	end
	if not isNear(player, "Sell") then
		return false, "Vá até a barraca de Venda do Steven!"
	end
	local bonuses = Formulas.petBonuses(data.pets, data.equippedPets)
	if mode == "all" then
		local count = #data.fruits
		if count == 0 then
			return false, "Você não tem frutos para vender."
		end
		local total = 0
		for _, fruit in data.fruits do
			total += Formulas.fruitValue(fruit.s, fruit.w, fruit.m, bonuses.Sell, fruit.v)
		end
		table.clear(data.fruits)
		data.sheckles += total
		data.stats.earned += total
		data.stats.sold += count
		QuestService.progress(player, "sell", count)
		Sync.markDirty(player)
		return true, string.format("Vendeu %d fruto(s) por %s!", count, Formulas.formatMoney(total))
	elseif mode == "one" then
		if type(index) ~= "number" then
			return false, "Pedido inválido."
		end
		local fruit = data.fruits[index]
		if not fruit or fruit.s ~= seedId or fruit.w ~= weight then
			return false, "Fruto não encontrado. Tente de novo."
		end
		local value = Formulas.fruitValue(fruit.s, fruit.w, fruit.m, bonuses.Sell, fruit.v)
		table.remove(data.fruits, index)
		data.sheckles += value
		data.stats.earned += value
		data.stats.sold += 1
		QuestService.progress(player, "sell", 1)
		Sync.markDirty(player)
		return true, string.format("Vendeu %s por %s!", Formulas.fruitName(fruit.s, fruit.v), Formulas.formatMoney(value))
	end
	return false, "Pedido inválido."
end

-- Comando de teste: enche o estoque do jogador
function ShopService.fillStock(data)
	ShopService.ensureStock(data)
	for _, info in CATEGORIES do
		for id in info.items do
			data.stock[info.stockKey][id] = math.max(data.stock[info.stockKey][id] or 0, 10)
		end
	end
end

function ShopService.start()
	task.spawn(function()
		local lastWindow = currentWindow()
		while true do
			task.wait(1)
			local window = currentWindow()
			if window ~= lastWindow then
				lastWindow = window
				for _, player in DataService.getPlayers() do
					local data = DataService.get(player)
					if data and ShopService.ensureStock(data) then
						Sync.markDirty(player)
					end
				end
				Sync.notifyAll("🌱 As lojas foram reabastecidas!", "success")
			end
		end
	end)
end

return ShopService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000011">
				<Properties>
					<string name="Name">StealService</string>
					<ProtectedString name="Source"><![CDATA[-- StealService: roubo a noite (novidade do GAG2) e todas as defesas.
--
-- Como funciona:
--   * So a noite, e so em jardins cujo dono NAO esta dentro do proprio jardim.
--   * Gnomo ativo tambem tranca o jardim.
--   * O ladrao segura E no fruto, carrega o fruto na cabeca (mais devagar, sem teleporte)
--     e precisa leva-lo ate o PROPRIO jardim para ficar com ele.
--   * Se morrer, for atingido por certas defesas, levar uma "pazada" do dono,
--     sair do jogo ou demorar demais, o fruto volta para o dono.
--   * Plantas de defesa e pets guardas atacam intrusos a noite.
--   * Cogumelos: velocidade, pulo e invisibilidade (defesas nao veem, exceto perto de lanternas).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Formulas = require(Shared:WaitForChild("Formulas"))
local DataService = require(script.Parent.DataService)
local DayNightService = require(script.Parent.DayNightService)
local GardenService = require(script.Parent.GardenService)
local QuestService = require(script.Parent.QuestService)
local Sync = require(script.Parent.Sync)
local Visuals = require(script.Parent.Visuals)
local WeatherService = require(script.Parent.WeatherService)

local StealService = {}

local S = Config.Stealing

type Carrier = {
	fruit: any,
	victim: Player,
	victimName: string,
	started: number,
	visual: BasePart?,
}

local carriers: { [Player]: Carrier } = {}
local lastSteal: { [Player]: number } = {}
local effects: { [Player]: { [string]: number } } = {}
local invisibleParts: { [Player]: { [Instance]: number } } = {}
local cooldowns: { [string]: number } = {}
local lockedState: { [any]: boolean } = {}

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function humanoidOf(player: Player): Humanoid?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid
end

local function effectActive(player: Player, name: string): boolean
	local list = effects[player]
	return list ~= nil and list[name] ~= nil and list[name] > os.clock()
end

local function setEffect(player: Player, name: string, duration: number)
	effects[player] = effects[player] or {}
	effects[player][name] = os.clock() + duration
end

local function ready(key: string, cooldown: number): boolean
	local now = os.clock()
	if cooldowns[key] and now < cooldowns[key] then
		return false
	end
	cooldowns[key] = now + cooldown
	return true
end

function StealService.isCarrying(player: Player): boolean
	return carriers[player] ~= nil
end

-- Jardim trancado: dono dentro do proprio jardim ou Gnomo ativo
function StealService.isLocked(garden): boolean
	if GardenService.hasActiveGnome(garden) then
		return true
	end
	local root = rootOf(garden.player)
	return root ~= nil and GardenService.isInside(garden, root.Position)
end

local function clearCarry(thief: Player)
	local carrier = carriers[thief]
	carriers[thief] = nil
	if carrier and carrier.visual then
		carrier.visual:Destroy()
	end
	thief:SetAttribute("Carrying", nil)
	thief:SetAttribute("CarryName", nil)
	thief:SetAttribute("CarryUntil", nil)
end

-- O fruto volta para o dono
local function returnLoot(thief: Player, reason: string)
	local carrier = carriers[thief]
	if not carrier then
		return
	end
	clearCarry(thief)
	local name = Formulas.fruitName(carrier.fruit.s, carrier.fruit.v)
	local victim = carrier.victim
	if victim.Parent and GardenService.getGarden(victim) then
		if GardenService.addFruit(victim, carrier.fruit) then
			Sync.notify(victim, string.format("🛡️ Seu(sua) %s foi recuperado(a)! (%s)", name, reason), "success")
		else
			Sync.notify(victim, string.format("Seu(sua) %s foi recuperado(a), mas sua mochila está cheia e ele se perdeu.", name), "error")
		end
	end
	if thief.Parent then
		Sync.notify(thief, string.format("Você perdeu o(a) %s roubado(a)! (%s)", name, reason), "error")
	end
end

local function secureLoot(thief: Player)
	local carrier = carriers[thief]
	if not carrier then
		return
	end
	if not GardenService.addFruit(thief, carrier.fruit) then
		returnLoot(thief, "mochila do ladrão cheia")
		return
	end
	clearCarry(thief)
	local name = Formulas.fruitName(carrier.fruit.s, carrier.fruit.v)
	local thiefData = DataService.get(thief)
	if thiefData then
		thiefData.stats.stolen += 1
	end
	QuestService.progress(thief, "steal", 1)
	local victimData = DataService.get(carrier.victim)
	if victimData then
		victimData.stats.stolenFrom += 1
	end
	Sync.notify(thief, string.format("🦹 Roubo garantido! Você ficou com %s.", name), "rare")
	if carrier.victim.Parent then
		Sync.notify(carrier.victim, string.format("😱 %s levou seu(sua) %s embora!", thief.DisplayName, name), "error")
	end
end

-- Tentativa de roubo (prompt "Colher" acionado por quem nao e o dono)
function StealService.trySteal(thief: Player, garden, view, slotIndex: number?)
	if not S.enabled then
		return
	end
	if not DayNightService.isNight() then
		Sync.notify(thief, "Esse jardim não é seu! Roubos só funcionam à noite.", "error")
		return
	end
	if not GardenService.getGarden(thief) then
		return
	end
	if carriers[thief] then
		Sync.notify(thief, "Você já está carregando um fruto. Leve-o ao seu jardim!", "error")
		return
	end
	if lastSteal[thief] and os.clock() - lastSteal[thief] < S.cooldown then
		return
	end
	if StealService.isLocked(garden) then
		Sync.notify(thief, "🔒 Este jardim está protegido (dono em casa ou Gnomo).", "error")
		return
	end
	local root = rootOf(thief)
	if not root then
		return
	end
	local fruitPosition = GardenService.fruitWorldPosition(view, slotIndex)
	if (root.Position - fruitPosition).Magnitude > S.maxDistance then
		return
	end
	local fruit = GardenService.takeFruit(garden, view, slotIndex)
	if not fruit then
		return
	end
	lastSteal[thief] = os.clock()
	local seed = Config.Seeds[fruit.s]
	carriers[thief] = {
		fruit = fruit,
		victim = garden.player,
		victimName = garden.player.DisplayName,
		started = os.clock(),
		visual = Visuals.carryVisual(root, seed, fruit.v),
	}
	local name = Formulas.fruitName(fruit.s, fruit.v)
	thief:SetAttribute("Carrying", true)
	thief:SetAttribute("CarryName", name)
	thief:SetAttribute("CarryUntil", os.time() + S.carryTimeout)
	Sync.notify(thief, string.format("🏃 Você pegou %s! Leve até o SEU jardim antes de ser pego!", name), "rare")
	Sync.notify(garden.player, string.format("⚠️ %s está roubando seu(sua) %s! Volte e acerte com a Pá!", thief.DisplayName, name), "error")
	local poison = seed.special and seed.special.poisonFruit
	if poison then
		local humanoid = humanoidOf(thief)
		if humanoid then
			humanoid:TakeDamage(poison.damage)
		end
		setEffect(thief, "slow", poison.slowTime)
		Sync.notify(thief, "☠️ A Maçã Envenenada te envenenou!", "error")
	end
end

-- Dono acerta o ladrao com a Pa
function StealService.bonk(owner: Player): boolean
	local root = rootOf(owner)
	if not root then
		return false
	end
	for thief, carrier in carriers do
		if carrier.victim == owner then
			local thiefRoot = rootOf(thief)
			if thiefRoot and (thiefRoot.Position - root.Position).Magnitude <= S.bonkDistance then
				setEffect(thief, "stun", S.stunTime)
				returnLoot(thief, "pazada do dono")
				return true
			end
		end
	end
	return false
end

-- Atirador de Morango: atordoa e faz soltar o fruto
function StealService.snipe(player: Player, gear, position: Vector3?)
	local root = rootOf(player)
	if not root or not position then
		return
	end
	if not ready("snipe:" .. player.UserId, gear.cooldown) then
		return
	end
	local myGarden = GardenService.getGarden(player)
	local best, bestDistance = nil, 7
	for _, other in Players:GetPlayers() do
		if other ~= player then
			local otherRoot = rootOf(other)
			if otherRoot and (otherRoot.Position - root.Position).Magnitude <= gear.range then
				local distance = (otherRoot.Position - position).Magnitude
				local isThief = carriers[other] ~= nil and carriers[other].victim == player
				local isIntruder = myGarden ~= nil and DayNightService.isNight() and GardenService.isInside(myGarden, otherRoot.Position)
				if (isThief or isIntruder) and distance < bestDistance then
					best, bestDistance = other, distance
				end
			end
		end
	end
	Visuals.projectile(root.Position + Vector3.new(0, 1.5, 0), position, gear.color)
	if best then
		setEffect(best, "stun", S.stunTime)
		Sync.notify(best, "🍓 Você levou um morangaço e ficou atordoado!", "error")
		if carriers[best] then
			returnLoot(best, "Atirador de Morango")
		end
		Sync.notify(player, "🎯 Acertou " .. best.DisplayName .. "!", "success")
	end
end

-- Cogumelos (efeitos temporarios). Retorna true se o item foi usado.
function StealService.consume(player: Player, gear): boolean
	if not rootOf(player) then
		return false
	end
	if gear.effect == "speed" then
		setEffect(player, "speed", gear.duration)
		Sync.notify(player, string.format("🍄 Velocidade por %ds!", gear.duration), "success")
	elseif gear.effect == "jump" then
		setEffect(player, "jump", gear.duration)
		Sync.notify(player, string.format("🍄 Super pulo por %ds!", gear.duration), "success")
	elseif gear.effect == "invisible" then
		setEffect(player, "invisible", gear.duration)
		Sync.notify(player, string.format("👻 Invisível por %ds! Defesas não te veem (cuidado com lanternas).", gear.duration), "success")
	else
		return false
	end
	return true
end

local function setInvisible(player: Player, invisible: boolean)
	local character = player.Character
	if invisible then
		if invisibleParts[player] or not character then
			return
		end
		local saved = {}
		for _, descendant in character:GetDescendants() do
			if descendant:IsA("BasePart") and descendant.Name ~= "HumanoidRootPart" and descendant.Name ~= "FrutoRoubado" then
				saved[descendant] = descendant.Transparency
				descendant.Transparency = 1
			elseif descendant:IsA("Decal") then
				saved[descendant] = descendant.Transparency
				descendant.Transparency = 1
			end
		end
		invisibleParts[player] = saved
		player:SetAttribute("Invisible", true)
	else
		local saved = invisibleParts[player]
		if not saved then
			return
		end
		invisibleParts[player] = nil
		for instance, transparency in saved do
			if instance.Parent then
				(instance :: any).Transparency = transparency
			end
		end
		player:SetAttribute("Invisible", nil)
	end
end

-- Velocidade, pulo e visibilidade de cada jogador
local function updateMovement(player: Player)
	local humanoid = humanoidOf(player)
	if not humanoid then
		return
	end
	local bonuses = GardenService.bonuses(player)
	local speed = Config.BaseWalkSpeed + (if bonuses then bonuses.Speed else 0)
	local jump = Config.BaseJumpHeight + (if bonuses then bonuses.Jump else 0)
	if effectActive(player, "speed") then
		speed += Config.Gear.SpeedMushroom.amount
	end
	if effectActive(player, "jump") then
		jump += Config.Gear.JumpMushroom.amount
	end
	if carriers[player] then
		speed = math.min(speed, S.carryWalkSpeed)
		local weather = WeatherService.getCurrentInfo()
		if weather and weather.thiefSpeedBonus then
			speed += weather.thiefSpeedBonus
		end
	end
	if effectActive(player, "slow") then
		speed = math.min(speed, 8)
	end
	if effectActive(player, "stun") then
		speed = 0
		jump = 0
	end
	speed = math.max(speed, 0)
	if math.abs(humanoid.WalkSpeed - speed) > 0.01 then
		humanoid.WalkSpeed = speed
	end
	-- alguns lugares usam JumpPower, outros JumpHeight
	if humanoid.UseJumpPower then
		local power = if jump <= 0 then 0 else 50 + (jump - Config.BaseJumpHeight) * 4.5
		if math.abs(humanoid.JumpPower - power) > 0.01 then
			humanoid.JumpPower = power
		end
	elseif math.abs(humanoid.JumpHeight - jump) > 0.01 then
		humanoid.JumpHeight = jump
	end
	setInvisible(player, effectActive(player, "invisible"))
end

local function isRevealed(garden, position: Vector3): boolean
	for _, lantern in GardenService.lanterns(garden) do
		if (lantern.position - position).Magnitude <= lantern.radius then
			return true
		end
	end
	return false
end

-- Expulsa o intruso para fora do portao
local function eject(intruder: Player, garden)
	local character = intruder.Character
	if character then
		character:PivotTo(GardenService.outsideCFrame(garden))
	end
end

local function hit(intruder: Player, garden, kind: string, amount: number?, sourceName: string, from: Vector3?)
	local root = rootOf(intruder)
	local humanoid = humanoidOf(intruder)
	if not root or not humanoid then
		return
	end
	if from then
		local color = if kind == "dragon" then Color3.fromRGB(255, 100, 20) elseif kind == "sniper" then Color3.fromRGB(225, 30, 55) else Color3.fromRGB(130, 230, 50)
		Visuals.projectile(from, root.Position, color)
	end
	if amount and amount > 0 then
		humanoid:TakeDamage(amount)
	end
	if kind == "poison" then
		setEffect(intruder, "slow", 3)
	elseif kind == "stun" then
		setEffect(intruder, "stun", S.stunTime)
	elseif kind == "hypno" or kind == "launch" or kind == "eject" then
		setEffect(intruder, "stun", 1.5)
		Visuals.ring(root.Position, Color3.fromRGB(200, 90, 255), 5)
		if carriers[intruder] then
			returnLoot(intruder, sourceName)
		end
		eject(intruder, garden)
	elseif kind == "dragon" then
		if carriers[intruder] then
			returnLoot(intruder, sourceName)
		end
	end
	if not effectActive(intruder, "warned") then
		setEffect(intruder, "warned", 3)
		Sync.notify(intruder, "💥 " .. sourceName .. " te atacou! Saia desse jardim!", "error")
	end
end

local GUARD_KINDS = { GuardStun = "stun", GuardSting = "sting", GuardLaunch = "launch", GuardEject = "eject" }

-- Defesas do jardim contra intrusos (so a noite)
local function defendGarden(garden)
	if not garden.player.Parent then
		return
	end
	local defenses = GardenService.defenses(garden)
	local bonuses = GardenService.bonuses(garden.player)
	for _, intruder in Players:GetPlayers() do
		if intruder ~= garden.player then
			local root = rootOf(intruder)
			if root and GardenService.isInside(garden, root.Position) then
				local hidden = effectActive(intruder, "invisible") and not isRevealed(garden, root.Position)
				if not hidden then
					for _, defense in defenses do
						local info = defense.defense
						local flat = Vector3.new(root.Position.X - defense.position.X, 0, root.Position.Z - defense.position.Z)
						if flat.Magnitude <= info.radius then
							local key = string.format("def:%d:%d", defense.plantId, intruder.UserId)
							if ready(key, info.cooldown) then
								local kind = info.kind
								local from = if kind == "ranged" or kind == "dragon" then defense.position else nil
								hit(intruder, garden, kind, info.damage, defense.seed.name, from)
							end
						end
					end
					if bonuses then
						for _, ability in bonuses.active do
							local kind = GUARD_KINDS[ability.kind]
							if kind then
								local key = string.format("pet:%d:%d", ability.petUid, intruder.UserId)
								if ready(key, ability.cooldown) then
									local damage = if kind == "sting" then ability.value else nil
									hit(intruder, garden, kind, damage, Config.Pets[ability.petId].name, nil)
								end
							end
						end
					end
				end
			end
		end
	end
end

local function tick()
	local night = DayNightService.isNight()
	-- cadeados nas placas
	for _, garden in GardenService.getGardens() do
		local locked = StealService.isLocked(garden)
		if lockedState[garden] ~= locked then
			lockedState[garden] = locked
			garden.plot.model:SetAttribute("Locked", locked)
			garden.plot.signLabel.Text = "Jardim de " .. garden.player.DisplayName .. (if locked then " 🔒" else "")
		end
		if night then
			defendGarden(garden)
		end
	end
	-- ladroes carregando frutos
	for thief, carrier in carriers do
		local root = rootOf(thief)
		local humanoid = humanoidOf(thief)
		local myGarden = GardenService.getGarden(thief)
		if not root or not humanoid or humanoid.Health <= 0 then
			returnLoot(thief, "o ladrão caiu")
		elseif os.clock() - carrier.started > S.carryTimeout then
			returnLoot(thief, "demorou demais")
		elseif myGarden and GardenService.isInside(myGarden, root.Position) then
			secureLoot(thief)
		end
	end
	for _, player in Players:GetPlayers() do
		updateMovement(player)
	end
end

function StealService.start()
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < 0.25 then
			return
		end
		accumulator = 0
		local ok, err = pcall(tick)
		if not ok then
			warn("[Jardim] Erro no sistema de roubo: " .. tostring(err))
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		if carriers[player] then
			returnLoot(player, "o ladrão saiu do jogo")
		end
		carriers[player] = nil
		lastSteal[player] = nil
		effects[player] = nil
		invisibleParts[player] = nil
		for garden in lockedState do
			if garden.player == player then
				lockedState[garden] = nil
			end
		end
	end)
end

return StealService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000012">
				<Properties>
					<string name="Name">Sync</string>
					<ProtectedString name="Source"><![CDATA[-- Sync: envia o estado do jogador para a interface e mostra notificacoes.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Formulas = require(Shared:WaitForChild("Formulas"))
local DataService = require(script.Parent.DataService)
local Inventory = require(script.Parent.Inventory)
local Remotes = require(script.Parent.Remotes)

local Sync = {}

local dirty: { [Player]: boolean } = {}
local extraProviders: { (Player, { [string]: any }) -> () } = {}

-- Permite que outros servicos acrescentem campos ao estado enviado
function Sync.addProvider(provider: (Player, { [string]: any }) -> ())
	table.insert(extraProviders, provider)
end

function Sync.markDirty(player: Player)
	dirty[player] = true
end

function Sync.notify(player: Player, text: string, kind: string?)
	if player.Parent then
		Remotes.Notify:FireClient(player, text, kind or "info")
	end
end

function Sync.notifyAll(text: string, kind: string?)
	Remotes.Notify:FireAllClients(text, kind or "info")
end

local function buildSnapshot(player: Player, data)
	local bonuses = Formulas.petBonuses(data.pets, data.equippedPets)
	local fruits = {}
	for index, fruit in data.fruits do
		table.insert(fruits, {
			i = index,
			s = fruit.s,
			w = fruit.w,
			m = fruit.m,
			v = fruit.v,
			sz = Formulas.sizeClass(fruit.s, fruit.w),
			val = Formulas.fruitValue(fruit.s, fruit.w, fruit.m, bonuses.Sell, fruit.v),
		})
	end
	local pets = {}
	for _, pet in data.pets do
		local info = Config.Pets[pet.p]
		local strength = Formulas.petStrength(pet)
		local level = Formulas.petLevel(pet.xp)
		local abilities = {}
		for _, ability in info.abilities do
			table.insert(abilities, Formulas.abilityText(ability, strength))
		end
		table.insert(pets, {
			id = pet.id,
			p = pet.p,
			v = pet.v or "",
			lvl = level,
			xp = math.floor(pet.xp or 0),
			nextXp = if level < Config.PetMaxLevel then Formulas.petXpForLevel(level + 1) else 0,
			ab = abilities,
			eq = table.find(data.equippedPets, pet.id) ~= nil,
		})
	end
	local snapshot = {
		sheckles = data.sheckles,
		seeds = data.seeds,
		gear = data.gear,
		eggs = data.eggs,
		fruits = fruits,
		capacity = Config.MaxFruitsInInventory + math.max(0, bonuses.Inventory),
		pets = pets,
		bonuses = {
			Growth = bonuses.Growth,
			Sell = bonuses.Sell,
			Luck = bonuses.Luck,
			NightLuck = bonuses.NightLuck,
			Gold = bonuses.Gold,
			Rainbow = bonuses.Rainbow,
			Size = bonuses.Size,
		},
		stock = { seeds = data.stock.seeds, gear = data.stock.gear, eggs = data.stock.eggs },
		restockAt = (data.stock.window + 1) * Config.RestockInterval,
		plantCount = #data.plants,
		stats = data.stats,
	}
	for _, provider in extraProviders do
		provider(player, snapshot)
	end
	return snapshot
end

function Sync.flush(player: Player)
	dirty[player] = nil
	local data = DataService.get(player)
	if not data or not player.Parent then
		return
	end
	Remotes.StateChanged:FireClient(player, buildSnapshot(player, data))
	Inventory.sync(player, data)
	local leaderstats = player:FindFirstChild("leaderstats")
	local sheckles = leaderstats and leaderstats:FindFirstChild("Sheckles")
	if sheckles and sheckles:IsA("IntValue") then
		sheckles.Value = data.sheckles
	end
end

function Sync.start()
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < 0.15 then
			return
		end
		elapsed = 0
		for player in dirty do
			Sync.flush(player)
		end
	end)
	Remotes.RequestState.OnServerEvent:Connect(function(player)
		Sync.markDirty(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		dirty[player] = nil
	end)
end

return Sync
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000013">
				<Properties>
					<string name="Name">Visuals</string>
					<ProtectedString name="Source"><![CDATA[-- Visuals: constroi os modelos 3D de plantas, brotos, frutos, sprinklers, ovos,
-- lanternas, gnomos e os efeitos (raios, meteoros, estrelas, tornado, tiros das defesas).
--
-- Modelos feitos no Blender: importe-os para ReplicatedStorage/Modelos com os nomes
--   Planta_<IdDaSemente>  (ex.: Planta_Carrot)  -> corpo da planta
--   Fruto_<IdDaSemente>   (ex.: Fruto_Apple)    -> fruto de plantas de varias colheitas
--   Sprinkler_<IdDoItem>  (ex.: Sprinkler_CommonSprinkler)
--   Ovo_<IdDoOvo>         (ex.: Ovo_CommonEgg)
--   Gnomo, Lanterna
-- Se o modelo nao existir, o jogo cria um modelo com Parts automaticamente.
-- Partes cujo nome contem "Produto" mudam de cor com as mutacoes e ao amadurecer.

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Formulas = require(Shared:WaitForChild("Formulas"))

local Visuals = {}

local STEM_COLOR = Color3.fromRGB(85, 140, 60)
local WOOD_COLOR = Color3.fromRGB(115, 78, 48)
local WHITE = Color3.fromRGB(255, 255, 255)
local BLACK = Color3.fromRGB(20, 20, 20)
local DIRT = Color3.fromRGB(110, 72, 45)
local RAINBOW = {
	Color3.fromRGB(255, 70, 70),
	Color3.fromRGB(255, 160, 50),
	Color3.fromRGB(255, 230, 60),
	Color3.fromRGB(90, 220, 90),
	Color3.fromRGB(70, 150, 255),
	Color3.fromRGB(170, 90, 255),
}

local function basePart(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, shape: Enum.PartType?): Part
	local part = Instance.new("Part")
	part.Name = name
	if shape then
		part.Shape = shape
	end
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Color = color
	part.Size = size
	part.CFrame = cf
	part.Parent = parent
	return part
end

local function block(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3): Part
	return basePart(parent, name, size, cf, color)
end

-- Elipsoide (bola que pode ser esticada)
local function sphere(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3): Part
	local part = basePart(parent, name, size, cf, color)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = part
	return part
end

-- Cilindro em pe (eixo vertical) centrado em cf
local function cylinder(parent: Instance, name: string, length: number, diameter: number, cf: CFrame, color: Color3): Part
	return basePart(parent, name, Vector3.new(length, diameter, diameter), cf * CFrame.Angles(0, 0, math.pi / 2), color, Enum.PartType.Cylinder)
end

local function markProduce(part: BasePart)
	part:SetAttribute("Produce", true)
	part:SetAttribute("BaseColor", part.Color)
	part:SetAttribute("BaseMaterial", part.Material.Name)
end

local function addLight(part: BasePart, color: Color3, range: number, brightness: number)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Parent = part
	return light
end

-- Petalas caindo da copa (Cerejeira)
local function addPetals(part: BasePart)
	local petals = Instance.new("ParticleEmitter")
	petals.Name = "Petalas"
	petals.Color = ColorSequence.new(Color3.fromRGB(255, 190, 220))
	petals.Size = NumberSequence.new(0.18)
	petals.Lifetime = NumberRange.new(3, 4.5)
	petals.Speed = NumberRange.new(0.5, 1.2)
	petals.SpreadAngle = Vector2.new(180, 180)
	petals.Acceleration = Vector3.new(0.6, -1.4, 0.3)
	petals.Rotation = NumberRange.new(0, 360)
	petals.RotSpeed = NumberRange.new(-60, 60)
	petals.Rate = 5
	petals.Parent = part
	return petals
end

Visuals.block = block
Visuals.sphere = sphere
Visuals.cylinder = cylinder

---------------------------------------------------------------------
-- Modelos importados (Blender)
---------------------------------------------------------------------

local function findLibraryModel(name: string): Instance?
	local library = ReplicatedStorage:FindFirstChild("Modelos")
	if not library then
		return nil
	end
	return library:FindFirstChild(name)
end

local function prepareModel(source: Instance): Model?
	local clone = source:Clone()
	local model: Model
	if clone:IsA("Model") then
		model = clone
	elseif clone:IsA("BasePart") then
		model = Instance.new("Model")
		model.Name = clone.Name
		clone.Parent = model
	else
		clone:Destroy()
		return nil
	end
	local firstPart: BasePart? = nil
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			if not firstPart then
				firstPart = descendant
			end
		elseif descendant:IsA("LuaSourceContainer") then
			descendant:Destroy()
		end
	end
	if not firstPart then
		model:Destroy()
		return nil
	end
	if not model.PrimaryPart then
		model.PrimaryPart = firstPart
	end
	return model
end

-- Ajusta a altura do modelo e coloca o pivot na base (baseAtBottom) ou no centro
local function normalize(model: Model, targetSize: number, useHeight: boolean, baseAtBottom: boolean)
	local _, size = model:GetBoundingBox()
	local current = if useHeight then size.Y else math.max(size.X, size.Y, size.Z)
	if current > 0.001 and targetSize > 0 then
		model:ScaleTo(model:GetScale() * (targetSize / current))
	end
	local cf, newSize = model:GetBoundingBox()
	local pivot = if baseAtBottom then cf.Position - Vector3.new(0, newSize.Y / 2, 0) else cf.Position
	model.WorldPivot = CFrame.new(pivot)
	model:PivotTo(CFrame.new())
end

local function fromLibrary(name: string, targetSize: number, useHeight: boolean, baseAtBottom: boolean): Model?
	local source = findLibraryModel(name)
	if not source then
		return nil
	end
	local model = prepareModel(source)
	if not model then
		return nil
	end
	normalize(model, targetSize, useHeight, baseAtBottom)
	return model
end

-- Marca as partes "Produto" de um modelo importado (se nao houver nenhuma e
-- markAllIfNone for true, o modelo inteiro conta como fruto).
-- A textura do Blender fica guardada no atributo "Texture": ela aparece no fruto maduro
-- e some quando o fruto precisa de outra cor (verde, variante ou mutacao).
local function markLibraryProduce(model: Model, markAllIfNone: boolean, color: Color3)
	local parts = {}
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") and string.find(string.lower(descendant.Name), "produto", 1, true) then
			table.insert(parts, descendant)
		end
	end
	if #parts == 0 and markAllIfNone then
		for _, descendant in model:GetDescendants() do
			if descendant:IsA("BasePart") then
				table.insert(parts, descendant)
			end
		end
	end
	for _, part in parts do
		if part:IsA("MeshPart") and part.TextureID ~= "" then
			part:SetAttribute("Texture", part.TextureID)
		end
		part.Color = color
		markProduce(part)
	end
end

local function showTexture(part: BasePart, visible: boolean)
	local texture = part:GetAttribute("Texture")
	if part:IsA("MeshPart") and type(texture) == "string" then
		part.TextureID = if visible then texture else ""
	end
end

---------------------------------------------------------------------
-- Plantas feitas com Parts
---------------------------------------------------------------------

local builders = {}

function builders.root(model: Model, seed)
	local h, fs = seed.height, seed.fruitSize
	markProduce(sphere(model, "Produto", fs, CFrame.new(0, fs.Y * 0.15, 0), seed.fruitColor))
	for i = 1, 3 do
		local angle = i * (math.pi * 2 / 3)
		local cf = CFrame.new(0, fs.Y * 0.55, 0) * CFrame.Angles(0, angle, 0) * CFrame.Angles(math.rad(18), 0, 0) * CFrame.new(0, h * 0.3, 0)
		block(model, "Folha", Vector3.new(0.15, h * 0.6, 0.4), cf, seed.leafColor)
	end
end

function builders.bush(model: Model, seed)
	local h = seed.height
	local leaf = seed.leafColor
	cylinder(model, "Caule", h * 0.3, 0.25, CFrame.new(0, h * 0.15, 0), STEM_COLOR)
	sphere(model, "Folhagem", Vector3.new(h * 0.85, h * 0.65, h * 0.85), CFrame.new(0, h * 0.5, 0), leaf)
	local tufts = {
		{ Vector3.new(0.2, 0.72, -0.1), Vector3.new(0.5, 0.45, 0.5), 0.08 },
		{ Vector3.new(-0.22, 0.62, 0.15), Vector3.new(0.45, 0.4, 0.45), 0.04 },
		{ Vector3.new(0.05, 0.55, 0.28), Vector3.new(0.42, 0.36, 0.42), -0.06 },
		{ Vector3.new(-0.2, 0.5, -0.25), Vector3.new(0.42, 0.36, 0.42), 0.05 },
		{ Vector3.new(0, 0.84, 0), Vector3.new(0.34, 0.3, 0.34), 0.12 },
	}
	for _, tuft in tufts do
		local color = if tuft[3] >= 0 then leaf:Lerp(WHITE, tuft[3]) else leaf:Lerp(BLACK, -tuft[3])
		sphere(model, "Folhagem", tuft[2] * h, CFrame.new(tuft[1] * h), color)
	end
	local id = seed.id
	if id == "Strawberry" or id == "Blueberry" then -- florzinhas brancas
		for i = 1, 3 do
			local angle = i * 2.1 + 0.6
			local center = Vector3.new(math.cos(angle) * h * 0.36, h * 0.68, math.sin(angle) * h * 0.36)
			sphere(model, "Flor", Vector3.new(0.34, 0.1, 0.34), CFrame.new(center), WHITE)
			sphere(model, "Miolo", Vector3.new(0.12, 0.08, 0.12), CFrame.new(center + Vector3.new(0, 0.05, 0)), Color3.fromRGB(255, 220, 80))
		end
	elseif id == "Tomato" or id == "Pepper" or id == "GhostPepper" or id == "InfernoPepper" then -- estaca de madeira
		local stake = block(model, "Estaca", Vector3.new(0.12, h * 0.95, 0.12), CFrame.new(h * 0.38, h * 0.475, h * 0.12), WOOD_COLOR:Lerp(WHITE, 0.15))
		stake.Material = Enum.Material.Wood
		block(model, "Amarra", Vector3.new(0.18, 0.06, 0.18), CFrame.new(h * 0.38, h * 0.6, h * 0.12), Color3.fromRGB(230, 210, 150))
	end
	if id == "InfernoPepper" then -- brasas
		for i = 1, 3 do
			local ember = sphere(model, "Brasa", Vector3.new(0.14, 0.14, 0.14), CFrame.new(math.cos(i * 2.1) * h * 0.25, h * (0.95 + (i % 2) * 0.05), math.sin(i * 2.1) * h * 0.25), Color3.fromRGB(255, 140, 40))
			ember.Material = Enum.Material.Neon
		end
	end
end

function builders.flower(model: Model, seed)
	local h, fs = seed.height, seed.fruitSize
	cylinder(model, "Caule", h * 0.75, 0.16, CFrame.new(0, h * 0.375, 0), STEM_COLOR)
	for i = 1, 3 do
		local cf = CFrame.new(0, h * 0.1, 0) * CFrame.Angles(0, i * 2.1, 0) * CFrame.Angles(math.rad(22), 0, 0) * CFrame.new(0, h * 0.2, 0)
		sphere(model, "Folha", Vector3.new(0.4, h * 0.45, 0.1), cf, seed.leafColor:Lerp(WHITE, (i % 2) * 0.06))
	end
	local headY = h * 0.75 + fs.Y * 0.4
	if seed.id == "Daffodil" then -- 6 petalas abertas + trombeta
		local head = CFrame.new(0, headY, 0) * CFrame.Angles(math.rad(-30), 0, 0)
		for i = 1, 6 do
			local petal = head * CFrame.Angles(0, 0, i * math.pi / 3) * CFrame.new(0, fs.X * 0.3, 0)
			markProduce(sphere(model, "Produto", Vector3.new(fs.X * 0.34, fs.X * 0.62, 0.08), petal, seed.fruitColor))
		end
		markProduce(cylinder(model, "ProdutoTrombeta", fs.X * 0.35, fs.X * 0.34, head * CFrame.Angles(math.pi / 2, 0, 0) * CFrame.new(0, fs.X * 0.16, 0), seed.fruitColor:Lerp(Color3.fromRGB(255, 150, 30), 0.55)))
	else -- tulipa: taca de 6 petalas
		markProduce(sphere(model, "Produto", fs * 0.55, CFrame.new(0, headY - fs.Y * 0.1, 0), seed.fruitColor))
		for i = 1, 6 do
			local inner = i % 2 == 0
			local cf = CFrame.new(0, headY, 0) * CFrame.Angles(0, i * math.pi / 3, 0) * CFrame.new(0, 0, fs.Z * (if inner then 0.16 else 0.22)) * CFrame.Angles(math.rad(if inner then 9 else 17), 0, 0)
			markProduce(sphere(model, "Produto", Vector3.new(fs.X * 0.56, fs.Y * 0.92, fs.Z * 0.22), cf, if inner then seed.fruitColor else seed.fruitColor:Lerp(BLACK, 0.07)))
		end
	end
end

function builders.tall(model: Model, seed)
	local h = seed.height
	local stalk = seed.leafColor:Lerp(Color3.new(0, 0, 0), 0.15)
	cylinder(model, "Caule", h, 0.35, CFrame.new(0, h / 2, 0), stalk)
	for i = 1, 3 do
		cylinder(model, "No", 0.08, 0.42, CFrame.new(0, h * 0.22 * i, 0), stalk:Lerp(BLACK, 0.12))
	end
	for i = 1, 6 do
		local y = h * (0.15 + 0.11 * i)
		local cf = CFrame.new(0, y, 0) * CFrame.Angles(0, i * 2.4, 0) * CFrame.Angles(math.rad(48), 0, 0) * CFrame.new(0, h * 0.2, 0)
		block(model, "Folha", Vector3.new(0.1, h * 0.42, 0.45), cf, seed.leafColor:Lerp(WHITE, (i % 3) * 0.04))
	end
	for i = 1, 5 do
		local cf = CFrame.new(0, h, 0) * CFrame.Angles(0, i * 1.26, 0) * CFrame.Angles(math.rad(if i == 1 then 0 else 28), 0, 0) * CFrame.new(0, 0.3, 0)
		block(model, "Pendao", Vector3.new(0.08, 0.6, 0.08), cf, Color3.fromRGB(230, 200, 120))
	end
end

function builders.ground(model: Model, seed)
	local fs = seed.fruitSize
	if seed.id == "Pumpkin" then -- abobora com gomos
		markProduce(sphere(model, "Produto", fs * 0.9, CFrame.new(0, fs.Y / 2, 0), seed.fruitColor:Lerp(BLACK, 0.06)))
		for i = 1, 6 do
			local cf = CFrame.new(0, fs.Y / 2, 0) * CFrame.Angles(0, i * math.pi / 3, 0) * CFrame.new(fs.X * 0.2, 0, 0)
			markProduce(sphere(model, "Produto", Vector3.new(fs.X * 0.6, fs.Y, fs.Z * 0.36), cf, seed.fruitColor))
		end
	else
		markProduce(sphere(model, "Produto", fs, CFrame.new(0, fs.Y / 2, 0), seed.fruitColor))
		if seed.id == "Watermelon" then -- listras
			for i = 1, 4 do
				local cf = CFrame.new(0, fs.Y / 2, 0) * CFrame.Angles(i * math.pi / 4, 0, 0)
				markProduce(sphere(model, "ProdutoListra", Vector3.new(fs.X * 1.01, fs.Y * 1.01, fs.Z * 0.12), cf, seed.fruitColor:Lerp(BLACK, 0.4)))
			end
		end
	end
	cylinder(model, "Cabo", 0.5, 0.22, CFrame.new(0, fs.Y + 0.15, 0), Color3.fromRGB(100, 120, 50))
	-- folhas grandes e irregulares no chao
	local leaves = { { 0.3, 1.7 }, { 1.6, 1.35 }, { 2.9, 1.85 }, { 4.1, 1.25 }, { 5.2, 1.55 } }
	for i, leafInfo in leaves do
		local angle, length = leafInfo[1], leafInfo[2]
		local cf = CFrame.Angles(0, angle, 0) * CFrame.new(fs.X * 0.42 + length * 0.35, 0.1, 0) * CFrame.Angles(0, 0, math.rad(4 + (i % 3) * 3))
		local color = seed.leafColor:Lerp(WHITE, (i % 3) * 0.04)
		sphere(model, "Folha", Vector3.new(length, 0.12, length * 0.62), cf, color)
		sphere(model, "Folha", Vector3.new(length * 0.6, 0.11, length * 0.45), cf * CFrame.new(length * 0.08, 0.01, length * 0.2) * CFrame.Angles(0, math.rad(40), 0), color)
	end
end

function builders.tree(model: Model, seed)
	local h = seed.height
	local trunk = cylinder(model, "Tronco", h * 0.55, h * 0.12, CFrame.new(0, h * 0.275, 0), WOOD_COLOR)
	trunk.Material = Enum.Material.Wood
	for i = 1, 3 do -- raizes
		local angle = i * math.pi * 2 / 3 + 0.3
		sphere(model, "Raiz", Vector3.new(h * 0.12, h * 0.06, h * 0.06), CFrame.new(math.cos(angle) * h * 0.06, h * 0.02, math.sin(angle) * h * 0.06) * CFrame.Angles(0, -angle, 0), WOOD_COLOR:Lerp(BLACK, 0.1))
	end
	local leaf = seed.leafColor
	local blobs = {
		{ Vector3.new(0, 0.68, 0), Vector3.new(0.75, 0.55, 0.75), 0 },
		{ Vector3.new(0.22, 0.82, 0), Vector3.new(0.45, 0.4, 0.45), 0.07 },
		{ Vector3.new(-0.2, 0.78, 0.15), Vector3.new(0.42, 0.38, 0.42), 0.03 },
		{ Vector3.new(0.05, 0.8, -0.22), Vector3.new(0.4, 0.36, 0.4), -0.05 },
		{ Vector3.new(-0.14, 0.6, -0.16), Vector3.new(0.4, 0.34, 0.4), -0.08 },
		{ Vector3.new(0, 0.9, 0), Vector3.new(0.36, 0.28, 0.36), 0.1 },
	}
	for _, blob in blobs do
		local color = if blob[3] >= 0 then leaf:Lerp(WHITE, blob[3]) else leaf:Lerp(BLACK, -blob[3])
		sphere(model, "Copa", blob[2] * h, CFrame.new(blob[1] * h), color)
	end
	if seed.id == "GalaxyFruit" then -- estrelinhas brilhando na copa
		for i = 1, 6 do
			local angle = i * 1.05
			local star = sphere(model, "Estrela", Vector3.new(0.22, 0.22, 0.22), CFrame.new(math.cos(angle) * h * 0.38, h * (0.62 + (i % 3) * 0.1), math.sin(angle) * h * 0.38), Color3.fromRGB(255, 250, 200))
			star.Material = Enum.Material.Neon
		end
	end
end

function builders.stalk(model: Model, seed)
	local fs = seed.fruitSize
	local segments = 4
	local segmentHeight = fs.Y / segments
	for i = 1, segments do
		markProduce(cylinder(model, "Produto", segmentHeight * 0.95, fs.X, CFrame.new(0, segmentHeight * (i - 0.5), 0), seed.fruitColor))
		markProduce(cylinder(model, "ProdutoNo", 0.12, fs.X * 1.15, CFrame.new(0, segmentHeight * i, 0), seed.fruitColor:Lerp(Color3.new(0, 0, 0), 0.2)))
	end
	for i = 1, 3 do
		local cf = CFrame.new(0, fs.Y * 0.85, 0) * CFrame.Angles(0, i * 2.1, 0) * CFrame.Angles(math.rad(55), 0, 0) * CFrame.new(0, 0.6, 0)
		block(model, "Folha", Vector3.new(0.08, 1.2, 0.35), cf, seed.leafColor)
	end
end

function builders.palm(model: Model, seed)
	local h = seed.height
	local segments = 6
	local topY = h * 0.85
	local banana = seed.id == "Banana"
	local trunkColor = if banana then WOOD_COLOR:Lerp(seed.leafColor, 0.45) else WOOD_COLOR
	for i = 1, segments do
		local trunk = cylinder(model, "Tronco", topY / segments * 1.02, 0.6 - i * 0.04, CFrame.new(0, topY / segments * (i - 0.5), 0), trunkColor:Lerp(WHITE, (i % 2) * 0.08))
		trunk.Material = Enum.Material.Wood
	end
	sphere(model, "Topo", Vector3.new(0.7, 0.45, 0.7), CFrame.new(0, topY, 0), seed.leafColor:Lerp(BLACK, 0.15))
	local count = if banana then 6 else 7
	local width = if banana then 1.2 else 0.85
	for i = 1, count do -- folhas que sobem e depois caem
		local base = CFrame.new(0, topY, 0) * CFrame.Angles(0, i * math.pi * 2 / count, 0)
		local color = seed.leafColor:Lerp(WHITE, (i % 3) * 0.05)
		block(model, "Folha", Vector3.new(width, h * 0.26, 0.12), base * CFrame.Angles(math.rad(-70), 0, 0) * CFrame.new(0, h * 0.13, 0), color)
		block(model, "Folha", Vector3.new(width * 0.8, h * 0.22, 0.12), base * CFrame.new(0, h * 0.06, -h * 0.24) * CFrame.Angles(math.rad(-120), 0, 0) * CFrame.new(0, h * 0.11, 0), color)
	end
	block(model, "FolhaNova", Vector3.new(0.25, h - topY, 0.12), CFrame.new(0, (topY + h) / 2, 0), seed.leafColor:Lerp(WHITE, 0.08))
	if banana then -- coracao da bananeira
		sphere(model, "Coracao", Vector3.new(0.38, 0.6, 0.38), CFrame.new(0.38, topY - 0.75, 0), Color3.fromRGB(120, 40, 80))
	end
end

function builders.cactus(model: Model, seed)
	local h = seed.height
	local color = seed.leafColor
	cylinder(model, "Corpo", h * 0.75, h * 0.25, CFrame.new(0, h * 0.375, 0), color)
	sphere(model, "Topo", Vector3.new(h * 0.25, h * 0.25, h * 0.25), CFrame.new(0, h * 0.75, 0), color)
	for _, side in { 1, -1 } do
		local armY = if side == 1 then h * 0.4 else h * 0.5
		cylinder(model, "Braco", h * 0.18, h * 0.13, CFrame.new(side * h * 0.17, armY, 0) * CFrame.Angles(0, 0, math.pi / 2), color)
		cylinder(model, "Braco", h * 0.22, h * 0.13, CFrame.new(side * h * 0.25, armY + h * 0.1, 0), color)
		sphere(model, "Braco", Vector3.new(h * 0.13, h * 0.13, h * 0.13), CFrame.new(side * h * 0.25, armY + h * 0.21, 0), color)
	end
	-- espinhos
	for i = 1, 8 do
		local cf = CFrame.new(0, h * (0.15 + 0.07 * i), 0) * CFrame.Angles(0, i * 2.4, 0) * CFrame.new(h * 0.13, 0, 0)
		block(model, "Espinho", Vector3.new(0.18, 0.04, 0.04), cf, Color3.fromRGB(245, 240, 200))
	end
	-- flor no topo
	local flowerColor = seed.fruitColor:Lerp(WHITE, 0.3)
	for i = 1, 5 do
		local cf = CFrame.new(0, h * 0.86, 0) * CFrame.Angles(0, i * math.pi * 2 / 5, 0) * CFrame.Angles(math.rad(55), 0, 0) * CFrame.new(0, h * 0.04, 0)
		sphere(model, "Flor", Vector3.new(h * 0.05, h * 0.09, 0.05), cf, flowerColor)
	end
	sphere(model, "Miolo", Vector3.new(h * 0.05, h * 0.04, h * 0.05), CFrame.new(0, h * 0.86, 0), Color3.fromRGB(255, 220, 90))
end

function builders.mushroom(model: Model, seed)
	local h, fs = seed.height, seed.fruitSize
	cylinder(model, "Caule", h * 0.5, 0.7, CFrame.new(0, h * 0.25, 0), seed.leafColor)
	local capY = h * 0.5 + fs.Y * 0.25
	cylinder(model, "Lamelas", 0.1, fs.X * 0.78, CFrame.new(0, capY - fs.Y * 0.18, 0), seed.leafColor:Lerp(BLACK, 0.12))
	markProduce(sphere(model, "Produto", fs, CFrame.new(0, capY, 0), seed.fruitColor))
	for i = 1, 5 do
		local cf = CFrame.new(0, capY, 0) * CFrame.Angles(0, i * 1.25, 0) * CFrame.Angles(math.rad(35), 0, 0) * CFrame.new(0, fs.Y * 0.46, 0)
		sphere(model, "Pinta", Vector3.new(0.35, 0.12, 0.35), cf, WHITE)
	end
	-- cogumelinhos ao lado
	for _, info in { { 0.75, -0.35, 0.35 }, { -0.6, 0.55, 0.28 } } do
		local x, z, scale = info[1], info[2], info[3]
		local stemHeight = h * 0.32 * scale / 0.35
		cylinder(model, "Caule", stemHeight, 0.25 * scale / 0.35, CFrame.new(x, stemHeight / 2, z), seed.leafColor)
		markProduce(sphere(model, "Produto", Vector3.new(fs.X * scale, fs.Y * scale * 0.8, fs.Z * scale), CFrame.new(x, stemHeight, z), seed.fruitColor))
	end
end

function builders.beanstalk(model: Model, seed)
	local h = seed.height
	local segments = 8
	local segmentHeight = h / segments
	for i = 1, segments do
		local x = math.cos(i * 0.8) * 0.3
		local z = math.sin(i * 0.8) * 0.3
		cylinder(model, "Caule", segmentHeight * 1.1, 0.5, CFrame.new(x, segmentHeight * (i - 0.5), z), seed.leafColor:Lerp(Color3.new(0, 0, 0), 0.1))
		local leafCF = CFrame.new(x, segmentHeight * (i - 0.3), z) * CFrame.Angles(0, i * 1.9, 0) * CFrame.new(0.6, 0, 0)
		sphere(model, "Folha", Vector3.new(1, 0.12, 0.6), leafCF, seed.leafColor)
	end
	for i = 1, 4 do
		local cf = CFrame.new(0, h + 0.4, 0) * CFrame.Angles(0, i * math.pi / 2, 0) * CFrame.new(0.7, 0, 0)
		sphere(model, "Nuvem", Vector3.new(1.4, 0.9, 1.2), cf, WHITE)
	end
	-- castelinho nas nuvens
	local stone, roof = Color3.fromRGB(200, 200, 210), Color3.fromRGB(90, 110, 200)
	block(model, "Castelo", Vector3.new(0.8, 0.4, 0.6), CFrame.new(0, h + 0.85, 0), stone)
	for _, x in { -0.42, 0.42 } do
		cylinder(model, "Torre", 0.6, 0.3, CFrame.new(x, h + 0.95, 0), stone)
		block(model, "Telhado", Vector3.new(0.36, 0.3, 0.36), CFrame.new(x, h + 1.4, 0), roof)
	end
end

-- Trepadeira em trelica de madeira (Uva, Feijao Verde, Hera Venenosa)
function builders.vine(model: Model, seed)
	local h = seed.height
	for _, x in { -0.9, 0.9 } do
		local post = cylinder(model, "Estaca", h, 0.15, CFrame.new(x, h / 2, 0), WOOD_COLOR)
		post.Material = Enum.Material.Wood
	end
	for _, y in { 0.4, 0.7, 0.95 } do
		local bar = block(model, "Trelica", Vector3.new(1.9, 0.08, 0.08), CFrame.new(0, h * y, 0), WOOD_COLOR)
		bar.Material = Enum.Material.Wood
	end
	for i = 1, 3 do
		local cf = CFrame.new(-0.6 + (i - 1) * 0.6, h * 0.45, 0) * CFrame.Angles(0, 0, math.rad(if i % 2 == 0 then 12 else -12))
		cylinder(model, "Ramo", h * 0.9, 0.09, cf, STEM_COLOR)
	end
	for i = 1, 12 do
		local x = -0.8 + ((i * 0.37) % 1) * 1.6
		local y = h * (0.25 + ((i * 0.53) % 1) * 0.7)
		local z = if i % 2 == 0 then 0.12 else -0.12
		sphere(model, "Folha", Vector3.new(0.45, 0.35, 0.12), CFrame.new(x, y, z) * CFrame.Angles(0, 0, i), seed.leafColor:Lerp(WHITE, (i % 3) * 0.05))
	end
end

-- Samambaia (Samambaia de Fogo)
function builders.fern(model: Model, seed)
	local h = seed.height
	sphere(model, "Base", Vector3.new(0.7, 0.3, 0.7), CFrame.new(0, 0.1, 0), seed.leafColor:Lerp(Color3.new(0, 0, 0), 0.3))
	for i = 1, 8 do
		local tilt = if i % 2 == 0 then 35 else 55
		local cf = CFrame.Angles(0, i * math.pi / 4, 0) * CFrame.Angles(math.rad(tilt), 0, 0) * CFrame.new(0, h * 0.35, 0)
		sphere(model, "Fronde", Vector3.new(0.35, h * 0.7, 0.08), cf, seed.leafColor)
		local tip = sphere(model, "Ponta", Vector3.new(0.18, 0.18, 0.18), cf * CFrame.new(0, h * 0.35, 0), seed.fruitColor)
		tip.Material = Enum.Material.Neon
	end
end

-- Dioneia: hastes com "bocas" que mordem ladroes
local TRAP_COUNT = 5
function builders.flytrap(model: Model, seed)
	local h = seed.height
	sphere(model, "Base", Vector3.new(1.2, 0.3, 1.2), CFrame.new(0, 0.12, 0), seed.leafColor:Lerp(Color3.new(0, 0, 0), 0.2))
	for k = 0, TRAP_COUNT - 1 do
		local angle = k * (math.pi * 2 / TRAP_COUNT) + 0.4
		local headPos = Vector3.new(math.cos(angle) * h * 0.36, h * 0.72, math.sin(angle) * h * 0.36)
		local stemMid = headPos / 2
		local stem = block(model, "Haste", Vector3.new(0.12, 0.12, headPos.Magnitude), CFrame.lookAt(stemMid, headPos, Vector3.xAxis), STEM_COLOR)
		stem.Name = "Haste"
		local head = CFrame.lookAt(headPos, headPos + Vector3.new(math.cos(angle), 0.3, math.sin(angle)), Vector3.yAxis)
		for _, side in { 1, -1 } do
			local jaw = head * CFrame.Angles(math.rad(25 * side), 0, 0) * CFrame.new(0, 0.18 * side, -0.2)
			sphere(model, "Mandibula", Vector3.new(0.7, 0.18, 0.6), jaw, seed.leafColor)
			sphere(model, "Boca", Vector3.new(0.6, 0.1, 0.5), jaw * CFrame.new(0, -0.05 * side, 0), Color3.fromRGB(200, 40, 50))
			for t = 1, 4 do
				block(model, "Dente", Vector3.new(0.05, 0.16, 0.05), jaw * CFrame.new(-0.27 + t * 0.11, 0.08 * side, -0.3), WHITE)
			end
		end
	end
end

-- Flor gigante brilhante (Flor da Lua, Flor do Sol, Flor do Eclipse, Flor Hipnotica, Semente Arco-iris)
function builders.bloom(model: Model, seed)
	local h = seed.height
	cylinder(model, "Caule", h * 0.6, 0.3, CFrame.new(0, h * 0.3, 0), STEM_COLOR)
	for i = 1, 3 do
		local cf = CFrame.new(0, h * 0.12, 0) * CFrame.Angles(0, i * 2.1 + 0.5, 0) * CFrame.Angles(math.rad(60), 0, 0) * CFrame.new(0, h * 0.18, 0)
		sphere(model, "Folha", Vector3.new(0.9, h * 0.45, 0.12), cf, seed.leafColor:Lerp(WHITE, (i % 2) * 0.06))
	end
	local headY = h * 0.66
	local special = seed.special or {}
	for layer = 1, 2 do -- duas camadas de petalas
		local tilt = if layer == 1 then 62 else 38
		local length = h * (if layer == 1 then 0.32 else 0.22)
		local width = h * (if layer == 1 then 0.16 else 0.11)
		for i = 1, 8 do
			local petalColor
			if special.rainbowPetals then
				petalColor = RAINBOW[(i - 1) % #RAINBOW + 1]
				if layer == 2 then
					petalColor = petalColor:Lerp(WHITE, 0.3)
				end
			else
				petalColor = if layer == 1 then seed.fruitColor:Lerp(WHITE, 0.25) else seed.fruitColor
			end
			local cf = CFrame.new(0, headY, 0) * CFrame.Angles(0, i * math.pi / 4 + (layer - 1) * math.pi / 8, 0) * CFrame.Angles(math.rad(tilt), 0, 0) * CFrame.new(0, length * 0.5, 0)
			sphere(model, "Petala", Vector3.new(width, length, 0.1), cf, petalColor)
		end
	end
	local center = sphere(model, "Centro", Vector3.new(h * 0.18, h * 0.12, h * 0.18), CFrame.new(0, headY + 0.05, 0), seed.fruitColor)
	center.Material = Enum.Material.Neon
	-- orbe magico flutuando sobre a flor
	local orb = sphere(model, "Orbe", Vector3.new(h * 0.14, h * 0.14, h * 0.14), CFrame.new(0, h * 0.93, 0), if special.rainbowPetals then WHITE else seed.fruitColor:Lerp(WHITE, 0.35))
	orb.Material = Enum.Material.Neon
	if special.glow then
		addLight(orb, seed.fruitColor, 12, 1.5)
	end
end

-- Girassol
function builders.sunflower(model: Model, seed)
	local h = seed.height
	cylinder(model, "Caule", h * 0.85, 0.28, CFrame.new(0, h * 0.425, 0), STEM_COLOR)
	for i = 1, 3 do
		local cf = CFrame.new(0, h * (0.2 + 0.18 * i), 0) * CFrame.Angles(0, i * 2.2, 0) * CFrame.Angles(math.rad(55), 0, 0) * CFrame.new(0, 0.4, 0)
		sphere(model, "Folha", Vector3.new(0.6, 0.9, 0.08), cf, seed.leafColor)
	end
	local head = CFrame.new(0, h * 0.88, 0) * CFrame.Angles(math.rad(-15), 0, 0)
	cylinder(model, "Miolo", 0.25, h * 0.26, head * CFrame.Angles(math.pi / 2, 0, 0), Color3.fromRGB(110, 70, 30))
	for i = 1, 12 do
		local cf = head * CFrame.Angles(0, 0, i * math.pi / 6) * CFrame.new(0, h * 0.2, 0)
		sphere(model, "Petala", Vector3.new(h * 0.08, h * 0.16, 0.08), cf, Color3.fromRGB(255, 205, 40))
	end
end

-- Cuspidor (Cuspidor de Veneno, Sopro do Dragao)
function builders.spitter(model: Model, seed)
	local h = seed.height
	sphere(model, "Corpo", Vector3.new(h * 0.55, h * 0.5, h * 0.55), CFrame.new(0, h * 0.3, 0), seed.leafColor)
	for i = 1, 4 do
		local cf = CFrame.Angles(0, i * math.pi / 2 + 0.4, 0) * CFrame.Angles(math.rad(70), 0, 0) * CFrame.new(0, h * 0.25, 0)
		sphere(model, "Folha", Vector3.new(0.5, h * 0.5, 0.1), cf, seed.leafColor:Lerp(Color3.new(0, 0, 0), 0.15))
	end
	local neck = CFrame.new(0, h * 0.62, -h * 0.08) * CFrame.Angles(math.rad(-35), 0, 0)
	cylinder(model, "Pescoco", h * 0.35, h * 0.16, neck, seed.leafColor)
	local mouth = neck * CFrame.new(0, h * 0.2, 0)
	cylinder(model, "Boca", 0.2, h * 0.22, mouth, seed.leafColor:Lerp(Color3.new(0, 0, 0), 0.25))
	local inside = cylinder(model, "Garganta", 0.05, h * 0.15, mouth * CFrame.new(0, 0.11, 0), seed.fruitColor)
	inside.Material = Enum.Material.Neon
	for i = 1, 6 do
		local cf = CFrame.new(0, h * 0.3, 0) * CFrame.Angles(0, i * 1.05, 0) * CFrame.Angles(0, 0, math.rad(-60)) * CFrame.new(0, h * 0.27, 0)
		block(model, "Espinho", Vector3.new(0.12, 0.35, 0.12), cf, seed.fruitColor:Lerp(WHITE, 0.3))
	end
end

-- Picole Foguete (fruto unico, colhido inteiro)
function builders.popsicle(model: Model, seed)
	local fs = seed.fruitSize
	local stick = block(model, "Palito", Vector3.new(0.16, 0.7, 0.06), CFrame.new(0, 0.35, 0), Color3.fromRGB(220, 190, 130))
	stick.Material = Enum.Material.Wood
	local layer = fs.Y / 3
	local colors = { Color3.fromRGB(60, 110, 230), WHITE, seed.fruitColor }
	for i = 1, 3 do
		local cf = CFrame.new(0, 0.7 + layer * (i - 0.5), 0)
		markProduce(block(model, "Produto", Vector3.new(fs.X, layer, fs.Z), cf, colors[i]))
	end
	for i = 1, 2 do
		local cf = CFrame.Angles(0, i * math.pi, 0) * CFrame.Angles(math.rad(50), 0, 0) * CFrame.new(0, 0.3, 0)
		sphere(model, "Folha", Vector3.new(0.3, 0.6, 0.08), cf, seed.leafColor)
	end
end

-- Abacaxi
function builders.pineapple(model: Model, seed)
	local h = seed.height
	for i = 1, 10 do
		local tilt = if i % 2 == 0 then 30 else 55
		local cf = CFrame.Angles(0, i * math.pi / 5, 0) * CFrame.Angles(math.rad(tilt), 0, 0) * CFrame.new(0, h * 0.25, 0)
		block(model, "Folha", Vector3.new(0.18, h * 0.5, 0.05), cf, seed.leafColor:Lerp(WHITE, (i % 3) * 0.06))
	end
	cylinder(model, "Caule", h * 0.3, 0.3, CFrame.new(0, h * 0.15, 0), seed.leafColor:Lerp(Color3.new(0, 0, 0), 0.2))
end

-- Cogumelos brilhantes
function builders.glowshroom(model: Model, seed)
	local h = seed.height
	local spots = {
		{ Vector3.new(0, 0, 0), 0.5, 1 },
		{ Vector3.new(0.45, 0, 0.2), 0.35, 0.7 },
		{ Vector3.new(-0.35, 0, -0.3), 0.25, 0.55 },
	}
	for index, info in spots do
		local pos, stemHeight, capScale = info[1], h * info[2], info[3]
		cylinder(model, "Caule", stemHeight, 0.22 * capScale + 0.1, CFrame.new(pos.X, stemHeight / 2, pos.Z), seed.leafColor)
		local cap = sphere(model, "Chapeu", Vector3.new(0.9, 0.45, 0.9) * capScale, CFrame.new(pos.X, stemHeight, pos.Z), seed.fruitColor)
		cap.Material = Enum.Material.Neon
		if index == 1 then
			addLight(cap, seed.fruitColor, 10, 1.2)
		end
	end
end

-- Cerejeira (Cherry Blossom): copa rosa com petalas caindo
function builders.blossom(model: Model, seed)
	local h = seed.height
	local trunk1 = cylinder(model, "Tronco", h * 0.35, h * 0.09, CFrame.new(0, h * 0.175, 0) * CFrame.Angles(0, 0, math.rad(6)), Color3.fromRGB(90, 55, 40))
	trunk1.Material = Enum.Material.Wood
	local trunk2 = cylinder(model, "Tronco", h * 0.3, h * 0.07, CFrame.new(-h * 0.04, h * 0.45, 0) * CFrame.Angles(0, 0, math.rad(-10)), Color3.fromRGB(90, 55, 40))
	trunk2.Material = Enum.Material.Wood
	local canopy = sphere(model, "Copa", Vector3.new(h * 0.8, h * 0.5, h * 0.8), CFrame.new(0, h * 0.7, 0), seed.leafColor)
	sphere(model, "Copa", Vector3.new(h * 0.5, h * 0.38, h * 0.5), CFrame.new(h * 0.25, h * 0.8, h * 0.05), seed.leafColor:Lerp(WHITE, 0.15))
	sphere(model, "Copa", Vector3.new(h * 0.45, h * 0.35, h * 0.45), CFrame.new(-h * 0.24, h * 0.76, -h * 0.12), seed.leafColor:Lerp(Color3.fromRGB(255, 120, 170), 0.2))
	local extra = {
		{ Vector3.new(0.05, 0.74, 0.26), Vector3.new(0.45, 0.34, 0.45), 0.1 },
		{ Vector3.new(-0.1, 0.86, 0.2), Vector3.new(0.4, 0.3, 0.4), 0.18 },
		{ Vector3.new(0.18, 0.66, -0.22), Vector3.new(0.42, 0.32, 0.42), -0.06 },
		{ Vector3.new(0, 0.9, 0), Vector3.new(0.4, 0.22, 0.4), 0.22 },
	}
	for _, blob in extra do
		local color = if blob[3] >= 0 then seed.leafColor:Lerp(WHITE, blob[3]) else seed.leafColor:Lerp(Color3.fromRGB(255, 120, 170), -blob[3] * 3)
		sphere(model, "Copa", blob[2] * h, CFrame.new(blob[1] * h), color)
	end
	for i = 1, 6 do -- petalas caidas no chao
		local angle = i * 2.4
		local radius = h * (0.14 + (i % 3) * 0.05)
		sphere(model, "PetalaChao", Vector3.new(0.18, 0.03, 0.12), CFrame.new(math.cos(angle) * radius, 0.03, math.sin(angle) * radius) * CFrame.Angles(0, i, 0), seed.leafColor:Lerp(WHITE, (i % 2) * 0.2))
	end
	addPetals(canopy)
end

-- Broto que aparece no inicio do crescimento
function Visuals.buildSprout(seed): Model
	local model = Instance.new("Model")
	model.Name = "Broto"
	sphere(model, "Monte", Vector3.new(0.9, 0.28, 0.9), CFrame.new(0, 0.05, 0), DIRT)
	cylinder(model, "Caule", 0.4, 0.07, CFrame.new(0, 0.25, 0), STEM_COLOR)
	for _, side in { 1, -1 } do
		local cf = CFrame.new(0, 0.42, 0) * CFrame.Angles(0, 0, math.rad(35 * side)) * CFrame.new(0.14 * side, 0, 0)
		sphere(model, "Folhinha", Vector3.new(0.3, 0.08, 0.18), cf, seed.leafColor)
	end
	model.WorldPivot = CFrame.new()
	return model
end

local function decorate(model: Model, seed)
	local special = seed.special or {}
	if special.ghostly then
		for _, part in Visuals.produceParts(model) do
			part.Transparency = 0.35
		end
	end
end

-- Modelos do Blender: a parte "Brilho" ganha luz e a "Copa" da Cerejeira solta petalas
local function decorateLibrary(model: Model, seed)
	local glow, canopy = nil, nil
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			local name = string.lower(descendant.Name)
			if not glow and string.find(name, "brilho", 1, true) then
				glow = descendant
			elseif not canopy and string.find(name, "copa", 1, true) then
				canopy = descendant
			end
		end
	end
	if glow then
		addLight(glow, seed.fruitColor, 12, 1.5)
	end
	if canopy and (seed.special or {}).petals then
		addPetals(canopy)
	end
end

-- Constroi o corpo de uma planta (pivot na base)
function Visuals.buildPlant(seed): Model
	local model = fromLibrary("Planta_" .. seed.id, seed.height, true, true)
	if model then
		model.Name = "Corpo"
		markLibraryProduce(model, not seed.multiHarvest, seed.fruitColor)
		decorateLibrary(model, seed)
		decorate(model, seed)
		return model
	end
	model = Instance.new("Model")
	model.Name = "Corpo"
	local builder = builders[seed.plantType] or builders.bush
	builder(model, seed)
	decorate(model, seed)
	model.WorldPivot = CFrame.new()
	return model
end

-- Constroi um fruto (pivot no centro)
function Visuals.buildFruit(seed): Model
	local fs = seed.fruitSize
	local model = fromLibrary("Fruto_" .. seed.id, math.max(fs.X, fs.Y, fs.Z), false, false)
	if model then
		model.Name = "Fruto"
		markLibraryProduce(model, true, seed.fruitColor)
		decorate(model, seed)
		return model
	end
	model = Instance.new("Model")
	model.Name = "Fruto"
	local main
	if seed.id == "Grape" then
		-- cacho de uvas
		main = sphere(model, "Produto", fs * 0.55, CFrame.new(0, fs.Y * 0.15, 0), seed.fruitColor)
		for i = 1, 5 do
			local cf = CFrame.Angles(0, i * 1.26, 0) * CFrame.new(fs.X * 0.25, -fs.Y * 0.12 - (i % 2) * fs.Y * 0.12, 0)
			markProduce(sphere(model, "Produto", fs * 0.4, cf, seed.fruitColor))
		end
	else
		main = sphere(model, "Produto", fs, CFrame.new(), seed.fruitColor)
	end
	markProduce(main)
	block(model, "Cabo", Vector3.new(0.1, 0.25, 0.1), CFrame.new(0, fs.Y / 2 + 0.08, 0), STEM_COLOR)
	local special = seed.special or {}
	if special.ghostly then
		for _, part in Visuals.produceParts(model) do
			part.Transparency = 0.35
		end
	end
	if special.glow then
		main.Material = Enum.Material.Neon
		main:SetAttribute("BaseMaterial", "Neon")
	end
	model.PrimaryPart = main
	model.WorldPivot = CFrame.new()
	return model
end

-- Posicoes dos frutos em relacao a base da planta adulta
function Visuals.fruitOffsets(seed): { Vector3 }
	local h = seed.height
	local count = seed.maxFruits or 1
	local offsets = {}
	for i = 1, count do
		local angle = (i - 1) / count * math.pi * 2 + 0.4
		local radius, y
		local t = seed.plantType
		if t == "bush" then
			radius = h * 0.42
			y = h * (if i % 2 == 0 then 0.68 else 0.42)
		elseif t == "tree" or t == "blossom" then
			radius = h * 0.37
			y = h * (0.52 + 0.06 * (i % 3))
		elseif t == "palm" then
			radius = 0.6
			y = h * 0.8
		elseif t == "tall" then
			radius = 0.35
			y = h * (0.4 + 0.12 * (i - 1))
		elseif t == "cactus" then
			radius = h * 0.15
			y = h * (0.45 + 0.08 * (i - 1))
		elseif t == "beanstalk" then
			radius = 0.85
			y = h * (0.2 + 0.7 * (i - 1) / math.max(count - 1, 1))
		elseif t == "vine" then
			local x = -0.6 + 1.2 * (i - 1) / math.max(count - 1, 1)
			offsets[i] = Vector3.new(x, h * (0.35 + ((i * 0.37) % 1) * 0.45), if i % 2 == 0 then 0.32 else -0.32)
			continue
		elseif t == "fern" then
			radius = h * 0.38
			y = h * (0.45 + 0.12 * (i % 2))
		elseif t == "flytrap" then
			-- dentro das bocas
			angle = (i - 1) * (math.pi * 2 / TRAP_COUNT) + 0.4
			radius = h * 0.36
			y = h * 0.72
		elseif t == "bloom" then
			radius = h * 0.36
			y = h * (0.66 + 0.08 * (i % 2))
		elseif t == "sunflower" then
			radius = 0.5
			y = h * (0.55 + 0.1 * (i % 2))
		elseif t == "spitter" then
			radius = h * 0.32
			y = h * 0.32
		elseif t == "pineapple" then
			radius = 0.3
			y = h * 0.42
		elseif t == "glowshroom" then
			radius = h * 0.42
			y = h * (0.25 + 0.15 * (i % 3))
		else
			radius = h * 0.4
			y = h * 0.5
		end
		offsets[i] = Vector3.new(math.cos(angle) * radius, y, math.sin(angle) * radius)
	end
	return offsets
end

function Visuals.produceParts(root: Instance): { BasePart }
	local parts = {}
	for _, descendant in root:GetDescendants() do
		if descendant:IsA("BasePart") and descendant:GetAttribute("Produce") then
			table.insert(parts, descendant)
		end
	end
	return parts
end

-- Variante de cor (ex.: Morango Branco) ou de Cristal
function Visuals.applyVariant(parts: { BasePart }, seed, variantId: string?)
	local variant = Formulas.variantInfo(seed, variantId)
	if not variant then
		return
	end
	for _, part in parts do
		part:SetAttribute("BaseColor", variant.color)
		part:SetAttribute("Variant", variant.id)
		part.Color = variant.color
		showTexture(part, false)
		if variant.id == Config.CrystalVariant.id then
			part.Material = Enum.Material.Glass
			part.Transparency = 0.25
			part:SetAttribute("BaseMaterial", "Glass")
		end
	end
end

-- Frutos nascem verdes e mudam para a cor final conforme amadurecem
function Visuals.setRipeness(parts: { BasePart }, alpha: number)
	alpha = math.clamp(alpha, 0, 1)
	for _, part in parts do
		if not part:GetAttribute("Mutated") then
			local base = part:GetAttribute("BaseColor")
			if typeof(base) == "Color3" then
				part.Color = Config.Growth.unripeColor:Lerp(base, alpha)
			end
			showTexture(part, alpha >= 1 and part:GetAttribute("Variant") == nil)
		end
	end
end

-- Muda a aparencia das partes do fruto conforme as mutacoes
function Visuals.applyMutations(parts: { BasePart }, mutations: { string })
	local top = Formulas.topMutation(mutations)
	local hasRainbow = table.find(mutations, "Rainbow") ~= nil
	for _, part in parts do
		local old = part:FindFirstChild("EfeitoMutacao")
		while old do
			old:Destroy()
			old = part:FindFirstChild("EfeitoMutacao")
		end
		CollectionService:RemoveTag(part, "RainbowFruit")
		local baseColor = part:GetAttribute("BaseColor")
		if typeof(baseColor) ~= "Color3" then
			baseColor = part.Color
		end
		if top then
			local mutation = Config.Mutations[top]
			part:SetAttribute("Mutated", true)
			showTexture(part, false)
			local appearance = part:FindFirstChildOfClass("SurfaceAppearance")
			if appearance then
				appearance:Destroy()
			end
			part.Color = if mutation.blend then baseColor:Lerp(mutation.color, mutation.blend) else mutation.color
			part.Material = Enum.Material[mutation.material]
			if hasRainbow and (top == "Rainbow" or Config.Mutations[top].kind == "growth") then
				CollectionService:AddTag(part, "RainbowFruit")
			end
			if mutation.effect == "sparkles" then
				local sparkles = Instance.new("Sparkles")
				sparkles.Name = "EfeitoMutacao"
				sparkles.SparkleColor = mutation.color
				sparkles.Parent = part
			elseif mutation.effect == "fire" then
				local fire = Instance.new("Fire")
				fire.Name = "EfeitoMutacao"
				fire.Color = mutation.color
				fire.SecondaryColor = mutation.color:Lerp(WHITE, 0.4)
				fire.Size = 2
				fire.Heat = 4
				fire.Parent = part
			elseif mutation.effect == "smoke" then
				local smoke = Instance.new("Smoke")
				smoke.Name = "EfeitoMutacao"
				smoke.Color = mutation.color
				smoke.Opacity = 0.08
				smoke.RiseVelocity = 1
				smoke.Size = 0.6
				smoke.Parent = part
			end
		else
			part:SetAttribute("Mutated", nil)
			part.Color = baseColor
			local materialName = part:GetAttribute("BaseMaterial")
			if type(materialName) == "string" then
				local ok, material = pcall(function()
					return Enum.Material[materialName]
				end)
				if ok and material then
					part.Material = material
				end
			end
		end
	end
end

---------------------------------------------------------------------
-- Sprinklers, ovos, lanternas e gnomos
---------------------------------------------------------------------

function Visuals.buildSprinkler(gear): Model
	local model = fromLibrary("Sprinkler_" .. gear.id, 2.4, true, true)
	if not model then
		model = Instance.new("Model")
		cylinder(model, "Base", 0.4, 1.4, CFrame.new(0, 0.2, 0), Color3.fromRGB(90, 90, 100))
		cylinder(model, "Cano", 1.6, 0.3, CFrame.new(0, 1, 0), Color3.fromRGB(150, 150, 160))
		local head = sphere(model, "Cabeca", Vector3.new(0.8, 0.8, 0.8), CFrame.new(0, 1.9, 0), gear.color)
		for i = 1, 4 do
			block(model, "Bico", Vector3.new(0.35, 0.12, 0.12), CFrame.new(0, 1.95, 0) * CFrame.Angles(0, i * math.pi / 2, 0) * CFrame.new(0.45, 0, 0), gear.color)
		end
		model.PrimaryPart = head
		model.WorldPivot = CFrame.new()
	end
	model.Name = gear.name
	local ring = cylinder(model, "Alcance", 0.05, gear.radius * 2, CFrame.new(0, 0.03, 0), Color3.fromRGB(100, 180, 255))
	ring.Transparency = 0.85
	ring.CanQuery = false
	-- a agua sai da "Cabeca" (no modelo do Blender: Cabeca_<IdDoItem>)
	local emitterPart: BasePart = model.PrimaryPart or ring
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") and string.find(string.lower(descendant.Name), "cabeca", 1, true) then
			emitterPart = descendant
			break
		end
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Agua"
	emitter.Color = ColorSequence.new(Color3.fromRGB(120, 190, 255))
	emitter.LightEmission = 0.2
	emitter.Rate = 25
	emitter.Lifetime = NumberRange.new(0.8, 1.2)
	emitter.Speed = NumberRange.new(6, 9)
	emitter.SpreadAngle = Vector2.new(70, 70)
	emitter.Acceleration = Vector3.new(0, -25, 0)
	emitter.Size = NumberSequence.new(0.25)
	emitter.Transparency = NumberSequence.new(0.3)
	emitter.Parent = emitterPart
	return model
end

local function infoLabel(model: Model, text: string, height: number): TextLabel
	local gui = Instance.new("BillboardGui")
	gui.Name = "Info"
	gui.Size = UDim2.fromOffset(170, 50)
	gui.StudsOffset = Vector3.new(0, height, 0)
	gui.MaxDistance = 70
	gui.Adornee = model.PrimaryPart
	local label = Instance.new("TextLabel")
	label.Name = "Texto"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = WHITE
	label.TextStrokeTransparency = 0.3
	label.Text = text
	label.Parent = gui
	gui.Parent = model
	return label
end

function Visuals.buildEgg(egg): (Model, TextLabel)
	local model = fromLibrary("Ovo_" .. egg.id, 2, true, true)
	if not model then
		model = Instance.new("Model")
		local shell = sphere(model, "Casca", Vector3.new(1.6, 2, 1.6), CFrame.new(0, 1, 0), egg.color)
		for i = 1, 4 do
			local cf = CFrame.new(0, 1, 0) * CFrame.Angles(0, i * math.pi / 2, 0) * CFrame.Angles(math.rad(20 * (i % 2)), 0, 0) * CFrame.new(0, 0.1, 0.72)
			sphere(model, "Pinta", Vector3.new(0.4, 0.4, 0.15), cf, egg.color:Lerp(Color3.new(0, 0, 0), 0.25))
		end
		model.PrimaryPart = shell
		model.WorldPivot = CFrame.new()
	end
	model.Name = egg.name
	return model, infoLabel(model, egg.name, 3)
end

function Visuals.buildLantern(gear): Model
	local model = fromLibrary("Lanterna", 3.4, true, true)
	local glass: BasePart
	if model then
		-- a luz fica no vidro (no modelo do Blender: Vidro_Lanterna)
		glass = model.PrimaryPart :: BasePart
		for _, descendant in model:GetDescendants() do
			if descendant:IsA("BasePart") and string.find(string.lower(descendant.Name), "vidro", 1, true) then
				glass = descendant
				break
			end
		end
	else
		model = Instance.new("Model")
		local post = cylinder(model, "Poste", 3, 0.2, CFrame.new(0, 1.5, 0), Color3.fromRGB(60, 60, 70))
		post.Material = Enum.Material.Metal
		block(model, "Braco", Vector3.new(0.8, 0.12, 0.12), CFrame.new(0.35, 3, 0), Color3.fromRGB(60, 60, 70))
		glass = block(model, "Vidro", Vector3.new(0.5, 0.65, 0.5), CFrame.new(0.65, 2.6, 0), gear.color)
		glass.Material = Enum.Material.Neon
		block(model, "Tampa", Vector3.new(0.6, 0.12, 0.6), CFrame.new(0.65, 2.98, 0), Color3.fromRGB(60, 60, 70))
		model.PrimaryPart = glass
		model.WorldPivot = CFrame.new()
	end
	model.Name = gear.name
	addLight(glass, Color3.fromRGB(255, 210, 140), gear.radius, 2)
	return model
end

function Visuals.buildGnome(gear): (Model, TextLabel)
	local model = fromLibrary("Gnomo", 2.4, true, true)
	if not model then
		model = Instance.new("Model")
		local body = cylinder(model, "Corpo", 0.9, 0.9, CFrame.new(0, 0.45, 0), Color3.fromRGB(60, 100, 200))
		sphere(model, "Cabeca", Vector3.new(0.6, 0.6, 0.6), CFrame.new(0, 1.15, 0), Color3.fromRGB(255, 205, 170))
		sphere(model, "Barba", Vector3.new(0.6, 0.55, 0.35), CFrame.new(0, 0.95, -0.15), WHITE)
		sphere(model, "Nariz", Vector3.new(0.18, 0.18, 0.18), CFrame.new(0, 1.15, -0.3), Color3.fromRGB(255, 160, 140))
		for i = 1, 4 do
			local size = 0.75 - i * 0.16
			cylinder(model, "Chapeu", 0.22, size, CFrame.new(0, 1.35 + i * 0.2, 0), gear.color)
		end
		model.PrimaryPart = body
		model.WorldPivot = CFrame.new()
	end
	model.Name = gear.name
	return model, infoLabel(model, gear.name, 3)
end

---------------------------------------------------------------------
-- Efeitos
---------------------------------------------------------------------

function Visuals.splash(position: Vector3, radius: number)
	local ball = sphere(workspace, "Respingo", Vector3.new(1, 1, 1), CFrame.new(position), Color3.fromRGB(90, 170, 255))
	ball.Transparency = 0.4
	ball.CanQuery = false
	local tween = TweenService:Create(ball, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(radius * 2, 1, radius * 2),
		Transparency = 1,
	})
	tween:Play()
	Debris:AddItem(ball, 0.8)
end

function Visuals.lightning(target: Vector3)
	local model = Instance.new("Model")
	model.Name = "Raio"
	local points = {}
	local steps = 7
	for i = 0, steps do
		local alpha = i / steps
		local offset = if i == 0 or i == steps then Vector3.zero else Vector3.new(math.random(-30, 30) / 10, 0, math.random(-30, 30) / 10)
		table.insert(points, target + Vector3.new(0, 120 * (1 - alpha), 0) + offset)
	end
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		local length = (b - a).Magnitude
		local segment = block(model, "Segmento", Vector3.new(0.5, 0.5, length), CFrame.lookAt((a + b) / 2, b, Vector3.xAxis), Color3.fromRGB(170, 230, 255))
		segment.Material = Enum.Material.Neon
		segment.CanQuery = false
	end
	local flash = Instance.new("PointLight")
	flash.Brightness = 8
	flash.Range = 40
	flash.Color = Color3.fromRGB(170, 230, 255)
	flash.Parent = model:FindFirstChildWhichIsA("BasePart")
	model.Parent = workspace
	Debris:AddItem(model, 0.4)
end

-- Algo que cai do ceu ate o alvo (meteoro ou estrela)
local function fallingObject(target: Vector3, size: number, color: Color3, time: number, withFire: boolean)
	local start = target + Vector3.new(25, 90, 15)
	local ball = sphere(workspace, if withFire then "Meteoro" else "Estrela", Vector3.new(size, size, size), CFrame.new(start), color)
	ball.Material = Enum.Material.Neon
	ball.CanQuery = false
	if withFire then
		local fire = Instance.new("Fire")
		fire.Size = size * 2
		fire.Color = Color3.fromRGB(255, 140, 40)
		fire.SecondaryColor = Color3.fromRGB(255, 60, 20)
		fire.Parent = ball
	else
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = color
		sparkles.Parent = ball
	end
	addLight(ball, color, 20, 3)
	TweenService:Create(ball, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = CFrame.new(target) }):Play()
	Debris:AddItem(ball, time + 0.4)
end

function Visuals.meteor(target: Vector3)
	fallingObject(target, 2.2, Color3.fromRGB(255, 150, 80), 0.9, true)
end

function Visuals.star(target: Vector3)
	fallingObject(target, 0.9, Color3.fromRGB(255, 240, 150), 0.8, false)
end

function Visuals.tornado(target: Vector3)
	local model = Instance.new("Model")
	model.Name = "Tornado"
	for i = 1, 7 do
		local ring = cylinder(model, "Funil", 2.2, 1.2 + i * 1.1, CFrame.new(target + Vector3.new(0, i * 2.1, 0)), Color3.fromRGB(170, 170, 165))
		ring.Transparency = 0.45
		ring.CanQuery = false
	end
	model.Parent = workspace
	Debris:AddItem(model, 2)
end

-- Tiro das plantas de defesa (veneno, fogo, morango)
function Visuals.projectile(from: Vector3, to: Vector3, color: Color3)
	local ball = sphere(workspace, "Tiro", Vector3.new(0.6, 0.6, 0.6), CFrame.new(from), color)
	ball.Material = Enum.Material.Neon
	ball.CanQuery = false
	TweenService:Create(ball, TweenInfo.new(0.3, Enum.EasingStyle.Linear), { CFrame = CFrame.new(to) }):Play()
	Debris:AddItem(ball, 0.4)
end

function Visuals.ring(position: Vector3, color: Color3, radius: number)
	local ring = cylinder(workspace, "Anel", 0.1, 1, CFrame.new(position), color)
	ring.Material = Enum.Material.Neon
	ring.Transparency = 0.3
	ring.CanQuery = false
	TweenService:Create(ring, TweenInfo.new(0.5, Enum.EasingStyle.Quad), {
		Size = Vector3.new(0.1, radius * 2, radius * 2),
		Transparency = 1,
	}):Play()
	Debris:AddItem(ring, 0.6)
end

-- Fruto roubado flutuando em cima da cabeca do ladrao
function Visuals.carryVisual(root: BasePart, seed, variantId: string?): BasePart
	local variant = Formulas.variantInfo(seed, variantId)
	local color = if variant then variant.color else seed.fruitColor
	local ball = Instance.new("Part")
	ball.Name = "FrutoRoubado"
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(1.3, 1.3, 1.3)
	ball.Color = color
	ball.Material = Enum.Material.Neon
	ball.Anchored = false
	ball.CanCollide = false
	ball.CanTouch = false
	ball.CanQuery = false
	ball.Massless = true
	ball.CFrame = root.CFrame * CFrame.new(0, 3.6, 0)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = ball
	weld.Parent = ball
	local sparkles = Instance.new("Sparkles")
	sparkles.SparkleColor = color
	sparkles.Parent = ball
	ball.Parent = root.Parent
	return ball
end

return Visuals
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000014">
				<Properties>
					<string name="Name">WeatherService</string>
					<ProtectedString name="Source"><![CDATA[-- WeatherService: eventos de clima.
--   De dia: Chuva, Tempestade, Geada, Nevasca, Areia, Calor, Tornado, Arco-iris, Explosao Solar, Chocolate.
--   De noite (luas): Sangue, Dourada, Arco-iris, Gigante, Meteoros, Aurora, Estrelas.
--   Especial: Eclipse (ao colher uma Flor do Eclipse).
-- Cada evento muda o ceu, acelera plantas e aplica mutacoes nos frutos.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Formulas = require(Shared:WaitForChild("Formulas"))
local DayNightService = require(script.Parent.DayNightService)
local GardenService = require(script.Parent.GardenService)
local Sync = require(script.Parent.Sync)
local Visuals = require(script.Parent.Visuals)

local WeatherService = {}

local rng = Random.new()
local current = nil
local nextDayEventAt: number? = nil
local lastSpecial: { [string]: number } = {}

local CLEAR = { brightness = 2, density = 0.3, color = Color3.fromRGB(200, 220, 255) }

local function setSky(sky)
	local info = TweenInfo.new(4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	TweenService:Create(Lighting, info, { Brightness = sky.brightness }):Play()
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		TweenService:Create(atmosphere, info, { Density = sky.density, Color = sky.color }):Play()
	end
end

local function listFor(period: string)
	local list = {}
	for _, weather in Config.WeatherList do
		if weather.period == period and weather.weight > 0 then
			table.insert(list, weather)
		end
	end
	return list
end

function WeatherService.getCurrent(): string?
	return if current then current.weather.id else nil
end

function WeatherService.getCurrentInfo()
	return if current then current.weather else nil
end

local function applyEffects()
	local weather = if current then current.weather else nil
	GardenService.setWeatherEffects({
		growthBonus = if weather then weather.growthBonus or 0 else 0,
		goldBoost = if weather then weather.goldBoost or 1 else 1,
		rainbowBoost = if weather then weather.rainbowBoost or 1 else 1,
		sizeBoost = if weather then weather.sizeBoost or 0 else 0,
	})
end

function WeatherService.stopEvent(silent: boolean?)
	if not current then
		return
	end
	current = nil
	workspace:SetAttribute("Weather", "")
	workspace:SetAttribute("WeatherEnds", 0)
	applyEffects()
	setSky(CLEAR)
	if not silent then
		Sync.notifyAll("O clima voltou ao normal.", "info")
	end
end

function WeatherService.startEvent(weatherId: string, duration: number?): boolean
	local weather = Config.Weather[weatherId]
	if not weather then
		return false
	end
	if current then
		WeatherService.stopEvent(true)
	end
	local length = duration or weather.duration
	current = {
		weather = weather,
		endsAt = os.time() + length,
		nextStrike = os.clock() + (if weather.strike then weather.strike.interval else 0),
	}
	if weather.period == "special" then
		lastSpecial[weather.id] = os.time()
	end
	-- um clima por dia: cancela o clima natural que estava agendado
	nextDayEventAt = nil
	workspace:SetAttribute("Weather", weather.id)
	workspace:SetAttribute("WeatherEnds", current.endsAt)
	applyEffects()
	setSky(weather.sky or CLEAR)
	Sync.notifyAll(string.format("%s %s! %s", weather.emoji, weather.name, weather.description), "rare")
	return true
end

-- Eventos especiais (Eclipse) disparados por plantas
function WeatherService.trigger(weatherId: string): boolean
	local weather = Config.Weather[weatherId]
	if not weather then
		return false
	end
	local last = lastSpecial[weatherId]
	if last and os.time() - last < (weather.cooldown or 600) then
		return false
	end
	return WeatherService.startEvent(weatherId)
end

local function strikeVisual(kind: string, position: Vector3)
	if kind == "lightning" then
		Visuals.lightning(position)
	elseif kind == "meteor" then
		Visuals.meteor(position)
	elseif kind == "star" then
		Visuals.star(position)
	elseif kind == "tornado" then
		Visuals.tornado(position)
	end
end

local function onPhaseChanged(phase: string, _index: number)
	if phase == "Night" then
		-- a noite encerra os climas de dia; pode surgir uma lua especial
		if current and current.weather.period == "day" then
			WeatherService.stopEvent(true)
		end
		if not current and rng:NextNumber() < Config.DayNight.nightEventChance then
			local pick = Formulas.weightedPick(listFor("night"), rng)
			local _, remaining = DayNightService.getPhase()
			WeatherService.startEvent(pick.id, math.min(pick.duration, math.floor(remaining)))
		end
	elseif phase == "Day" then
		if current and current.weather.period == "night" then
			WeatherService.stopEvent(true)
		end
		nextDayEventAt = nil
		if rng:NextNumber() < Config.DayNight.dayEventChance then
			nextDayEventAt = os.time() + rng:NextInteger(Config.DayNight.dayEventDelayMin, Config.DayNight.dayEventDelayMax)
		end
	end
end

local function step()
	local now = os.time()
	if current then
		local weather = current.weather
		if now >= current.endsAt then
			WeatherService.stopEvent()
			return
		end
		for mutationId, chance in weather.mutations do
			GardenService.applyWeatherMutation(mutationId, chance)
		end
		local strike = weather.strike
		if strike and os.clock() >= current.nextStrike then
			current.nextStrike = os.clock() + strike.interval
			for _ = 1, strike.count or 1 do
				local position = GardenService.strikeRandomFruit(strike.mutation)
				if position then
					strikeVisual(strike.visual, position)
				end
			end
		end
	elseif nextDayEventAt and now >= nextDayEventAt and DayNightService.getPhase() == "Day" then
		nextDayEventAt = nil
		local pick = Formulas.weightedPick(listFor("day"), rng)
		WeatherService.startEvent(pick.id)
	end
end

function WeatherService.start()
	workspace:SetAttribute("Weather", "")
	workspace:SetAttribute("WeatherEnds", 0)
	applyEffects()
	DayNightService.onPhaseChanged(onPhaseChanged)
	onPhaseChanged((DayNightService.getPhase()), 0)
	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(step)
			if not ok then
				warn("[Jardim] Erro no clima: " .. tostring(err))
			end
		end
	end)
end

return WeatherService
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="StarterPlayer" referent="RBX00000015">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX00000016">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="LocalScript" referent="RBX00000017">
				<Properties>
					<string name="Name">GardenClient</string>
					<ProtectedString name="Source"><![CDATA[-- GardenClient: script principal do jogador.
-- Liga a interface, os efeitos e o uso das ferramentas (sementes, regador, espatula,
-- cogumelos, atirador de morango etc).

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")

local remotes = {
	Notify = remotesFolder:WaitForChild("Notify") :: RemoteEvent,
	StateChanged = remotesFolder:WaitForChild("StateChanged") :: RemoteEvent,
	UseItem = remotesFolder:WaitForChild("UseItem") :: RemoteEvent,
	Teleport = remotesFolder:WaitForChild("Teleport") :: RemoteEvent,
	RequestState = remotesFolder:WaitForChild("RequestState") :: RemoteEvent,
	Buy = remotesFolder:WaitForChild("Buy") :: RemoteFunction,
	Sell = remotesFolder:WaitForChild("Sell") :: RemoteFunction,
	PetAction = remotesFolder:WaitForChild("PetAction") :: RemoteFunction,
	QuestAction = remotesFolder:WaitForChild("QuestAction") :: RemoteFunction,
}

local Interface = require(script:WaitForChild("Interface"))
local Effects = require(script:WaitForChild("Effects"))

local ui = Interface.create(remotes)
Effects.start(ui)

remotes.StateChanged.OnClientEvent:Connect(function(state)
	if type(state) == "table" then
		ui.setState(state)
	end
end)

remotes.Notify.OnClientEvent:Connect(function(message, kind)
	if type(message) == "string" then
		ui.notify(message, kind)
	end
end)

-- abrir lojas ao falar com os vendedores
ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
	if who ~= player then
		return
	end
	local shop = prompt:GetAttribute("Shop")
	if type(shop) == "string" then
		ui.openShop(shop)
	end
end)

---------------------------------------------------------------------
-- Ferramentas: ao clicar com uma semente/item, envia a posicao para o servidor
---------------------------------------------------------------------

local mouse = player:GetMouse()
local hooked: { [Tool]: boolean } = setmetatable({}, { __mode = "k" }) :: any

local function hookTool(tool: Tool)
	if hooked[tool] then
		return
	end
	hooked[tool] = true
	tool.Activated:Connect(function()
		local kind = tool:GetAttribute("ItemKind")
		local id = tool:GetAttribute("ItemId")
		if type(kind) == "string" and type(id) == "string" then
			remotes.UseItem:FireServer(kind, id, mouse.Hit.Position)
		end
	end)
end

local function watchCharacter(character: Model)
	mouse.TargetFilter = character
	for _, child in character:GetChildren() do
		if child:IsA("Tool") then
			hookTool(child)
		end
	end
	character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			hookTool(child)
		end
	end)
end

player.CharacterAdded:Connect(watchCharacter)
if player.Character then
	watchCharacter(player.Character)
end

remotes.RequestState:FireServer()
]]></ProtectedString>
				</Properties>
				<Item class="ModuleScript" referent="RBX00000018">
					<Properties>
						<string name="Name">Effects</string>
						<ProtectedString name="Source"><![CDATA[-- Effects: efeitos visuais so do cliente.
--  * frutos e pets Arco-iris trocando de cor
--  * chuva, neve, areia, chocolate, raios
--  * luas, aurora, arco-iris e eclipse no ceu
--  * botoes "Colher" (seu jardim) e "Roubar" (jardins alheios, a noite)
--  * pets seguindo os jogadores
--  * NPCs das lojas animados e falando
--  * dica ao passar o mouse nas plantas

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Formulas = require(Shared:WaitForChild("Formulas"))

local Effects = {}

local player = Players.LocalPlayer
local FONT = Enum.Font.FredokaOne

local function localPart(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, sphere: boolean): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Material = Enum.Material.SmoothPlastic
	part.Color = color
	part.Size = size
	part.CFrame = cf
	if sphere then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = part
	end
	part.Parent = parent
	return part
end

---------------------------------------------------------------------
-- Arco-iris
---------------------------------------------------------------------

local function startRainbow()
	RunService.Heartbeat:Connect(function()
		local hue = (os.clock() * 0.25) % 1
		for index, part in CollectionService:GetTagged("RainbowFruit") do
			if part:IsA("BasePart") then
				part.Color = Color3.fromHSV((hue + index * 0.07) % 1, 0.75, 1)
			end
		end
	end)
end

---------------------------------------------------------------------
-- Clima: particulas e objetos no ceu
---------------------------------------------------------------------

local function emitter(parent: Instance, name: string, props: { [string]: any }): ParticleEmitter
	local particles = Instance.new("ParticleEmitter")
	particles.Name = name
	particles.Enabled = false
	for key, value in props do
		(particles :: any)[key] = value
	end
	particles.Parent = parent
	return particles
end

local SKY_POSITION = Vector3.new(160, 230, 320)

local function buildSkyObject(kind: string, folder: Folder)
	if kind == "bloodmoon" or kind == "goldmoon" or kind == "rainbowmoon" or kind == "megamoon" then
		local colors = {
			bloodmoon = Color3.fromRGB(220, 40, 40),
			goldmoon = Color3.fromRGB(255, 210, 80),
			rainbowmoon = Color3.fromRGB(255, 150, 255),
			megamoon = Color3.fromRGB(240, 240, 255),
		}
		local size = if kind == "megamoon" then 150 else 70
		local moon = localPart(folder, "Lua", Vector3.new(size, size, size), CFrame.new(SKY_POSITION), colors[kind], true)
		moon.Material = Enum.Material.Neon
		if kind == "rainbowmoon" then
			CollectionService:AddTag(moon, "RainbowFruit")
		end
	elseif kind == "eclipse" then
		local glow = localPart(folder, "Coroa", Vector3.new(1, 100, 100), CFrame.new(SKY_POSITION + Vector3.new(0, 0, 4)) * CFrame.Angles(0, math.pi / 2, 0), Color3.fromRGB(255, 160, 60), false)
		glow.Shape = Enum.PartType.Cylinder
		glow.Material = Enum.Material.Neon
		glow.Transparency = 0.2
		localPart(folder, "Sol", Vector3.new(80, 80, 80), CFrame.new(SKY_POSITION), Color3.fromRGB(10, 10, 15), true)
	elseif kind == "aurora" then
		for i = 1, 6 do
			local band = localPart(folder, "Aurora", Vector3.new(160, 30, 2), CFrame.new(-200 + i * 60, 170 + (i % 2) * 12, 260 - i * 10) * CFrame.Angles(0, math.rad(15 * i), math.rad(8)), if i % 2 == 0 then Color3.fromRGB(90, 255, 170) else Color3.fromRGB(160, 110, 255), false)
			band.Material = Enum.Material.Neon
			band.Transparency = 0.6
			CollectionService:AddTag(band, "AuroraBand")
		end
	elseif kind == "rainbow" then
		local colors = { Color3.fromRGB(255, 70, 70), Color3.fromRGB(255, 160, 50), Color3.fromRGB(255, 230, 60), Color3.fromRGB(90, 220, 90), Color3.fromRGB(70, 150, 255), Color3.fromRGB(170, 90, 255) }
		for band, color in colors do
			local radius = 220 - band * 9
			for step = 0, 18 do
				local angle = math.pi * step / 18
				local position = Vector3.new(math.cos(angle) * radius, math.sin(angle) * radius - 20, 330)
				local piece = localPart(folder, "ArcoIris", Vector3.new(9, 40, 2), CFrame.new(position) * CFrame.Angles(0, 0, angle), color, false)
				piece.Material = Enum.Material.Neon
				piece.Transparency = 0.35
			end
		end
	end
end

local function startWeather()
	local holder = localPart(workspace, "ClimaLocal", Vector3.new(120, 1, 120), CFrame.new(0, 100, 0), Color3.new(1, 1, 1), false)
	holder.Transparency = 1
	local skyFolder = Instance.new("Folder")
	skyFolder.Name = "CeuLocal"
	skyFolder.Parent = workspace

	local particles = {
		rain = emitter(holder, "Chuva", {
			Rate = 500, Lifetime = NumberRange.new(1, 1.3), Speed = NumberRange.new(60, 70),
			EmissionDirection = Enum.NormalId.Bottom, Orientation = Enum.ParticleOrientation.VelocityParallel,
			Size = NumberSequence.new(0.18), Squash = NumberSequence.new(2.5), Transparency = NumberSequence.new(0.25),
			Color = ColorSequence.new(Color3.fromRGB(175, 205, 255)), LightEmission = 0.3,
		}),
		snow = emitter(holder, "Neve", {
			Rate = 160, Lifetime = NumberRange.new(6, 8), Speed = NumberRange.new(5, 9),
			EmissionDirection = Enum.NormalId.Bottom, SpreadAngle = Vector2.new(25, 25), Acceleration = Vector3.new(1, -1, 0),
			Size = NumberSequence.new(0.35), Color = ColorSequence.new(Color3.fromRGB(255, 255, 255)), LightEmission = 0.5,
			RotSpeed = NumberRange.new(-90, 90),
		}),
		heavysnow = emitter(holder, "Nevasca", {
			Rate = 450, Lifetime = NumberRange.new(4, 6), Speed = NumberRange.new(10, 16),
			EmissionDirection = Enum.NormalId.Bottom, SpreadAngle = Vector2.new(35, 35), Acceleration = Vector3.new(6, -2, 0),
			Size = NumberSequence.new(0.45), Color = ColorSequence.new(Color3.fromRGB(255, 255, 255)), LightEmission = 0.5,
		}),
		sand = emitter(holder, "Areia", {
			Rate = 350, Lifetime = NumberRange.new(3, 4), Speed = NumberRange.new(20, 30),
			EmissionDirection = Enum.NormalId.Bottom, SpreadAngle = Vector2.new(60, 60), Acceleration = Vector3.new(25, -5, 0),
			Size = NumberSequence.new(0.3), Color = ColorSequence.new(Color3.fromRGB(230, 200, 140)), Transparency = NumberSequence.new(0.3),
		}),
		chocolate = emitter(holder, "Chocolate", {
			Rate = 300, Lifetime = NumberRange.new(1.4, 1.8), Speed = NumberRange.new(45, 55),
			EmissionDirection = Enum.NormalId.Bottom, Orientation = Enum.ParticleOrientation.VelocityParallel,
			Size = NumberSequence.new(0.3), Squash = NumberSequence.new(1.5),
			Color = ColorSequence.new(Color3.fromRGB(110, 60, 30)),
		}),
	}

	local function apply()
		local weatherId = workspace:GetAttribute("Weather")
		local weather = if type(weatherId) == "string" then Config.Weather[weatherId] else nil
		for name, particle in particles do
			particle.Enabled = weather ~= nil and weather.particle == name
		end
		skyFolder:ClearAllChildren()
		if weather and weather.skyObject then
			buildSkyObject(weather.skyObject, skyFolder)
		end
	end
	workspace:GetAttributeChangedSignal("Weather"):Connect(apply)
	apply()

	RunService.RenderStepped:Connect(function()
		local camera = workspace.CurrentCamera
		if camera then
			holder.CFrame = CFrame.new(camera.CFrame.Position + Vector3.new(0, 35, 0))
		end
		local t = os.clock()
		for index, band in CollectionService:GetTagged("AuroraBand") do
			if band:IsA("BasePart") then
				band.Transparency = 0.55 + math.sin(t * 1.5 + index) * 0.2
			end
		end
	end)

	-- clarao quando cai um raio ou meteoro
	local flash = Instance.new("ColorCorrectionEffect")
	flash.Name = "ClaraoLocal"
	flash.Brightness = 0
	flash.Parent = Lighting
	workspace.ChildAdded:Connect(function(child)
		if child.Name == "Raio" or child.Name == "Meteoro" then
			flash.Brightness = 0.45
			TweenService:Create(flash, TweenInfo.new(0.4), { Brightness = 0 }):Play()
		end
	end)
end

---------------------------------------------------------------------
-- Pets
---------------------------------------------------------------------

local PET_OFFSETS = {
	Vector3.new(-2.8, 0, 3),
	Vector3.new(2.8, 0, 3),
	Vector3.new(0, 0, 5),
}

-- Detalhes de cada bicho (orelhas, focinho, asas, rabo...)
local PET_LOOKS = {
	Frog = { eyes = "top", ears = "none", nose = "none", mouth = true, tail = "none" },
	Bunny = { ears = "long", tail = "puff", cheeks = true },
	Cat = { ears = "pointy", tail = "thin", cheeks = true, whiskers = true },
	Owl = { eyes = "big", ears = "tufts", nose = "beak", tail = "feather", wings = "folded", feet = "bird" },
	Dog = { ears = "floppy", nose = "muzzle", tail = "wag", cheeks = true },
	Chicken = { ears = "none", nose = "beak", comb = true, tail = "feather", wings = "folded", feet = "bird" },
	Deer = { ears = "small", antlers = true, tail = "puff", spots = true },
	Turtle = { ears = "none", shell = true, tail = "small" },
	Pig = { ears = "small", nose = "snout", tail = "curly", cheeks = true },
	Robin = { ears = "none", nose = "beak", tail = "feather", wings = "folded", chest = true, feet = "bird" },
	Bee = { ears = "none", nose = "none", stripes = true, antennae = true, wings = "insect", tail = "stinger", feet = "none" },
	Butterfly = { ears = "none", nose = "none", antennae = true, wings = "butterfly", tail = "none", slim = true, feet = "none" },
	Monkey = { ears = "side", face = true, tail = "curly", cheeks = true },
	Bear = { ears = "round", nose = "muzzle", tail = "puff" },
	Unicorn = { ears = "pointy", horn = true, mane = true, tail = "mane" },
	GoldenDragonfly = { ears = "none", nose = "none", eyes = "big", wings = "dragonfly", tail = "long", slim = true, feet = "none" },
	Firefly = { ears = "none", nose = "none", antennae = true, wings = "insect", glow = true, tail = "none", feet = "none" },
	BaldEagle = { ears = "none", nose = "beak", wings = "folded", tail = "feather", whiteHead = true, feet = "bird" },
	Dragon = { ears = "none", horns = true, spikes = true, wings = "bat", tail = "dragon" },
	Phoenix = { ears = "none", nose = "beak", crest = true, wings = "flame", tail = "flame", feet = "bird" },
	Raccoon = { ears = "pointy", mask = true, tail = "striped", cheeks = true },
	Kitsune = { ears = "pointy", tail = "kitsune", cheeks = true },
}

local function buildPet(info, variant, level: number): Model
	local model = Instance.new("Model")
	model.Name = info.name
	local s = info.size * variant.scale
	local look = PET_LOOKS[info.id] or {}
	local color, accent = info.color, info.accent
	local light = color:Lerp(Color3.new(1, 1, 1), 0.45)
	local dark = Color3.fromRGB(25, 25, 30)
	local white = Color3.new(1, 1, 1)
	local orange = Color3.fromRGB(255, 175, 40)
	local function add(name: string, size: Vector3, x: number, y: number, z: number, partColor: Color3, sphere: boolean, rotation: CFrame?): Part
		local cf = CFrame.new(x * s, y * s, z * s)
		if rotation then
			cf *= rotation
		end
		return localPart(model, name, size * s, cf, partColor, sphere)
	end
	local function neon(piece: Part): Part
		piece.Material = Enum.Material.Neon
		return piece
	end

	-- corpo e cabeca
	local body = add("Corpo", if look.slim then Vector3.new(0.7, 0.7, 1.5) else Vector3.new(1.4, 1.1, 1.6), 0, 0, 0, color, true)
	if not look.slim then
		add("Barriga", Vector3.new(1, 0.75, 1.1), 0, -0.2, -0.15, if look.chest then accent else light, true)
	end
	local head = add("Cabeca", Vector3.new(1.15, 1.1, 1.1), 0, 0.6, -0.85, if look.whiteHead then white else color, true)

	-- olhos (branco + pupila + brilho)
	local eyeScale = if look.eyes == "big" then 1.45 else 1
	local eyeY, eyeZ, eyeX = 0.72, -1.33, 0.24
	if look.eyes == "top" then
		eyeY, eyeZ, eyeX = 1.12, -1.0, 0.3
	end
	for _, side in { -1, 1 } do
		local x = side * eyeX
		if look.eyes == "big" and look.nose == "beak" then
			add("Aro", Vector3.new(0.5, 0.52, 0.08), x, eyeY, eyeZ + 0.04, accent, true)
		end
		add("Olho", Vector3.new(0.3, 0.34, 0.14) * eyeScale, x, eyeY, eyeZ, white, true)
		add("Pupila", Vector3.new(0.17, 0.22, 0.08) * eyeScale, x, eyeY - 0.02, eyeZ - 0.06 * eyeScale, dark, true)
		add("BrilhoOlho", Vector3.new(0.06, 0.07, 0.04) * eyeScale, x + 0.04, eyeY + 0.05, eyeZ - 0.1 * eyeScale, white, true)
		if look.cheeks then
			add("Bochecha", Vector3.new(0.2, 0.11, 0.06), side * 0.38, 0.5, -1.28, Color3.fromRGB(255, 150, 160), true)
		end
	end

	-- nariz, bico ou focinho
	if look.nose == "beak" then
		add("Bico", Vector3.new(0.26, 0.2, 0.44), 0, 0.52, -1.48, orange, true)
	elseif look.nose == "snout" then
		add("Focinho", Vector3.new(0.5, 0.38, 0.3), 0, 0.5, -1.42, light, true)
		for _, side in { -1, 1 } do
			add("Narina", Vector3.new(0.08, 0.12, 0.05), side * 0.1, 0.5, -1.57, dark, true)
		end
	elseif look.nose == "muzzle" then
		add("Focinho", Vector3.new(0.55, 0.4, 0.4), 0, 0.46, -1.36, light, true)
		add("Nariz", Vector3.new(0.22, 0.16, 0.12), 0, 0.55, -1.55, dark, true)
	elseif look.nose ~= "none" then
		add("Nariz", Vector3.new(0.2, 0.15, 0.1), 0, 0.53, -1.42, accent, true)
	end
	if look.mouth then
		add("Boca", Vector3.new(0.6, 0.05, 0.05), 0, 0.42, -1.38, dark, false)
	end
	if look.whiskers then
		for _, side in { -1, 1 } do
			for i = 0, 1 do
				add("Bigode", Vector3.new(0.4, 0.03, 0.03), side * 0.42, 0.5 - i * 0.08, -1.3, white, false, CFrame.Angles(0, 0, math.rad(side * (8 - i * 16))))
			end
		end
	end

	-- orelhas
	local ears = look.ears or "pointy"
	for _, side in { -1, 1 } do
		local tilt = CFrame.Angles(0, 0, math.rad(-side * 18))
		if ears == "long" then
			local lean = CFrame.Angles(0, 0, math.rad(-side * 8))
			add("Orelha", Vector3.new(0.24, 0.95, 0.16), side * 0.24, 1.45, -0.78, color, false, lean)
			add("OrelhaDentro", Vector3.new(0.12, 0.7, 0.04), side * 0.24, 1.45, -0.87, Color3.fromRGB(255, 170, 190), false, lean)
		elseif ears == "pointy" then
			add("Orelha", Vector3.new(0.34, 0.42, 0.14), side * 0.33, 1.15, -0.8, color, false, tilt)
			add("OrelhaDentro", Vector3.new(0.18, 0.26, 0.04), side * 0.33, 1.13, -0.88, accent, false, tilt)
		elseif ears == "round" then
			add("Orelha", Vector3.new(0.4, 0.4, 0.16), side * 0.44, 1.08, -0.82, color, true)
			add("OrelhaDentro", Vector3.new(0.22, 0.22, 0.06), side * 0.44, 1.08, -0.9, light, true)
		elseif ears == "side" then
			add("Orelha", Vector3.new(0.16, 0.42, 0.42), side * 0.6, 0.66, -0.85, light, true)
		elseif ears == "floppy" then
			add("Orelha", Vector3.new(0.3, 0.62, 0.18), side * 0.58, 0.62, -0.82, accent, true, CFrame.Angles(0, 0, math.rad(side * 18)))
		elseif ears == "small" then
			add("Orelha", Vector3.new(0.24, 0.3, 0.12), side * 0.36, 1.1, -0.78, color, false, CFrame.Angles(0, 0, math.rad(-side * 25)))
		elseif ears == "tufts" then
			add("Tufo", Vector3.new(0.18, 0.4, 0.12), side * 0.36, 1.2, -0.8, accent, false, CFrame.Angles(0, 0, math.rad(-side * 20)))
		end
	end

	-- enfeites de cada bicho
	if look.antlers then
		local antler = Color3.fromRGB(205, 165, 110)
		for _, side in { -1, 1 } do
			add("Galhada", Vector3.new(0.09, 0.62, 0.09), side * 0.3, 1.45, -0.8, antler, false, CFrame.Angles(0, 0, math.rad(-side * 22)))
			add("Galho", Vector3.new(0.07, 0.32, 0.07), side * 0.5, 1.55, -0.8, antler, false, CFrame.Angles(0, 0, math.rad(-side * 60)))
		end
	end
	if look.horn then
		neon(add("Chifre", Vector3.new(0.15, 0.7, 0.15), 0, 1.3, -1.05, Color3.fromRGB(255, 220, 90), false, CFrame.Angles(math.rad(-25), 0, 0)))
	end
	if look.horns then
		for _, side in { -1, 1 } do
			add("Chifre", Vector3.new(0.12, 0.42, 0.12), side * 0.25, 1.2, -0.66, Color3.fromRGB(245, 235, 210), false, CFrame.Angles(math.rad(30), 0, math.rad(-side * 12)))
		end
	end
	if look.mane then
		local rainbow = { Color3.fromRGB(255, 120, 180), Color3.fromRGB(170, 120, 255), Color3.fromRGB(110, 190, 255), Color3.fromRGB(255, 210, 90) }
		for i = 0, 3 do
			add("Crina", Vector3.new(0.3, 0.32, 0.36), 0, 1.08 - i * 0.22, -0.55 + i * 0.25, rainbow[i + 1], true)
		end
	end
	if look.comb then
		for i = -1, 1 do
			add("Crista", Vector3.new(0.16, 0.22, 0.16), 0, 1.2 + (if i == 0 then 0.06 else 0), -0.85 + i * 0.16, Color3.fromRGB(230, 40, 40), true)
		end
		add("Barbela", Vector3.new(0.14, 0.22, 0.12), 0, 0.36, -1.44, Color3.fromRGB(230, 40, 40), true)
	end
	if look.crest then
		for i = -1, 1 do
			neon(add("Pena", Vector3.new(0.1, 0.5, 0.14), i * 0.12, 1.3, -0.75, Color3.fromRGB(255, 200, 60), false, CFrame.Angles(math.rad(-20), 0, math.rad(i * 18))))
		end
	end
	if look.mask then
		add("Mascara", Vector3.new(1.02, 0.26, 0.12), 0, 0.72, -1.25, Color3.fromRGB(45, 45, 50), false)
	end
	if look.face then
		add("Rosto", Vector3.new(0.8, 0.7, 0.2), 0, 0.56, -1.28, light, true)
	end
	if look.shell then
		local shellColor = accent
		add("Casco", Vector3.new(1.6, 0.95, 1.8), 0, 0.28, 0.05, shellColor, true)
		add("BordaCasco", Vector3.new(1.72, 0.22, 1.92), 0, -0.02, 0.05, shellColor:Lerp(white, 0.25), true)
		for i = 0, 3 do
			local angle = i * math.pi / 2 + math.pi / 4
			add("Placa", Vector3.new(0.45, 0.2, 0.45), math.cos(angle) * 0.4, 0.68, 0.05 + math.sin(angle) * 0.42, shellColor:Lerp(dark, 0.25), true)
		end
	end
	if look.stripes then
		for _, z in { -0.15, 0.32 } do
			add("Listra", Vector3.new(1.44, 1.14, 0.24), 0, 0, z, dark, true)
		end
	end
	if look.spots then
		for i = 1, 4 do
			add("Pinta", Vector3.new(0.18, 0.08, 0.18), (i % 2 == 0 and 0.3 or -0.3), 0.5, -0.3 + i * 0.18, white, true)
		end
	end
	if look.spikes then
		for i = 0, 3 do
			add("Espinho", Vector3.new(0.26, 0.26, 0.26), 0, 0.62 - i * 0.04, -0.35 + i * 0.32, accent, false, CFrame.Angles(math.rad(45), 0, 0))
		end
	end
	if look.antennae then
		for _, side in { -1, 1 } do
			add("Antena", Vector3.new(0.05, 0.55, 0.05), side * 0.2, 1.3, -0.92, dark, false, CFrame.Angles(math.rad(-20), 0, math.rad(-side * 20)))
			add("PontaAntena", Vector3.new(0.13, 0.13, 0.13), side * 0.31, 1.55, -1.02, if look.glow then accent else dark, true)
		end
	end
	if look.glow then
		neon(add("Luz", Vector3.new(0.6, 0.6, 0.6), 0, 0, 0.9, accent, true))
	end

	-- asas
	local wings = look.wings
	for _, side in { -1, 1 } do
		if wings == "folded" then
			add("Asa", Vector3.new(0.25, 0.75, 1.15), side * 0.72, 0.1, 0.05, color:Lerp(dark, 0.18), true, CFrame.Angles(math.rad(10), 0, math.rad(side * 8)))
		elseif wings == "insect" then
			local wing = add("Asa", Vector3.new(0.9, 0.08, 0.55), side * 0.75, 0.62, 0, white, true, CFrame.Angles(0, 0, math.rad(side * 25)))
			wing.Transparency = 0.35
		elseif wings == "butterfly" then
			add("Asa", Vector3.new(1.3, 0.06, 1.0), side * 0.95, 0.35, -0.2, accent, true, CFrame.Angles(0, 0, math.rad(side * 30)))
			add("Asa", Vector3.new(0.9, 0.06, 0.8), side * 0.75, 0.12, 0.45, color, true, CFrame.Angles(0, 0, math.rad(side * 20)))
			add("Pinta", Vector3.new(0.3, 0.08, 0.3), side * 1.05, 0.44, -0.25, white, true, CFrame.Angles(0, 0, math.rad(side * 30)))
		elseif wings == "dragonfly" then
			for k = 0, 1 do
				local wing = add("Asa", Vector3.new(1.4, 0.04, 0.32), side * 0.85, 0.42, -0.25 + k * 0.4, Color3.fromRGB(230, 245, 255), true, CFrame.Angles(0, math.rad(side * (k == 0 and -8 or 8)), 0))
				wing.Transparency = 0.3
			end
		elseif wings == "bat" then
			add("Asa", Vector3.new(1.3, 0.08, 1.0), side * 1.0, 0.55, 0.1, accent, true, CFrame.Angles(0, 0, math.rad(side * 30)))
			add("Osso", Vector3.new(1.2, 0.1, 0.1), side * 1.0, 0.85, -0.25, color, false, CFrame.Angles(0, 0, math.rad(side * 30)))
		elseif wings == "flame" then
			neon(add("Asa", Vector3.new(1.2, 0.1, 0.8), side * 0.95, 0.4, 0.05, accent, true, CFrame.Angles(0, 0, math.rad(side * 25))))
			neon(add("PontaAsa", Vector3.new(0.6, 0.08, 0.45), side * 1.45, 0.62, 0.1, Color3.fromRGB(255, 230, 120), true, CFrame.Angles(0, 0, math.rad(side * 25))))
		end
	end

	-- rabo
	local tail = look.tail or "puff"
	if tail == "puff" then
		add("Rabo", Vector3.new(0.42, 0.42, 0.42), 0, 0.15, 0.85, light, true)
	elseif tail == "thin" then
		add("Rabo", Vector3.new(0.14, 0.75, 0.14), 0, 0.5, 0.95, color, false, CFrame.Angles(math.rad(-30), 0, 0))
		add("PontaRabo", Vector3.new(0.2, 0.2, 0.2), 0, 0.85, 1.12, accent, true)
	elseif tail == "wag" then
		add("Rabo", Vector3.new(0.22, 0.6, 0.22), 0, 0.42, 0.92, accent, true, CFrame.Angles(math.rad(-35), 0, 0))
	elseif tail == "curly" then
		for i = 0, 2 do
			local angle = i * 2
			add("Rabo", Vector3.new(0.16, 0.16, 0.16), math.cos(angle) * 0.12, 0.25 + math.sin(angle) * 0.12, 0.85 + i * 0.06, color:Lerp(dark, 0.1), true)
		end
	elseif tail == "feather" then
		add("Rabo", Vector3.new(0.6, 0.12, 0.65), 0, 0.22, 0.95, color:Lerp(dark, 0.2), true, CFrame.Angles(math.rad(20), 0, 0))
	elseif tail == "striped" then
		for i = 0, 3 do
			add("Rabo", Vector3.new(0.34, 0.34, 0.34), 0, 0.15 + i * 0.18, 0.85 + i * 0.12, if i % 2 == 0 then color else Color3.fromRGB(45, 45, 50), true)
		end
	elseif tail == "kitsune" then
		for i = -1, 1 do
			local turn = CFrame.Angles(math.rad(-40), math.rad(i * 30), 0)
			add("Rabo", Vector3.new(0.38, 0.38, 0.9), i * 0.32, 0.45, 1.05, color, true, turn)
			neon(add("PontaRabo", Vector3.new(0.3, 0.3, 0.3), i * 0.5, 0.82, 1.4, white, true))
		end
	elseif tail == "dragon" then
		for i = 0, 2 do
			local size = 0.42 - i * 0.1
			add("Rabo", Vector3.new(size, size, 0.6), 0, 0.05 - i * 0.05, 0.9 + i * 0.45, color, true)
		end
		add("PontaRabo", Vector3.new(0.4, 0.08, 0.34), 0, -0.08, 2.0, accent, false, CFrame.Angles(0, math.rad(45), 0))
	elseif tail == "flame" then
		local flames = { accent, Color3.fromRGB(255, 140, 40), Color3.fromRGB(255, 220, 90) }
		for i = 1, 3 do
			neon(add("Chama", Vector3.new(0.3, 0.2, 0.9), (i - 2) * 0.28, 0.2, 1.1, flames[i], true, CFrame.Angles(math.rad(-15), math.rad((i - 2) * 22), 0)))
		end
	elseif tail == "stinger" then
		add("Ferrao", Vector3.new(0.12, 0.12, 0.32), 0, 0, 0.9, dark, true)
	elseif tail == "long" then
		for i = 0, 2 do
			add("Rabo", Vector3.new(0.22, 0.22, 0.5), 0, 0, 0.9 + i * 0.42, color, true)
		end
	elseif tail == "mane" then
		add("Rabo", Vector3.new(0.34, 0.6, 0.34), 0, 0.2, 0.9, Color3.fromRGB(255, 120, 180), true, CFrame.Angles(math.rad(25), 0, 0))
		add("Rabo", Vector3.new(0.28, 0.5, 0.28), 0, -0.05, 1.05, Color3.fromRGB(110, 190, 255), true, CFrame.Angles(math.rad(35), 0, 0))
	elseif tail == "small" then
		add("Rabo", Vector3.new(0.2, 0.2, 0.25), 0, -0.1, 0.92, color, true)
	end

	-- patas
	local feet = look.feet or "paws"
	if feet == "paws" then
		for _, x in { -0.42, 0.42 } do
			for _, z in { -0.45, 0.45 } do
				add("Pata", Vector3.new(0.34, 0.34, 0.36), x, -0.5, z, color:Lerp(dark, 0.08), true)
			end
		end
	elseif feet == "bird" then
		for _, x in { -0.25, 0.25 } do
			add("Pe", Vector3.new(0.22, 0.12, 0.3), x, -0.55, -0.1, orange, true)
		end
	end

	if variant.id == "Rainbow" then
		CollectionService:AddTag(body, "RainbowFruit")
		CollectionService:AddTag(head, "RainbowFruit")
	end
	model.PrimaryPart = body
	model.WorldPivot = CFrame.new()

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(140, 28)
	gui.StudsOffset = Vector3.new(0, 1.6 * s, 0)
	gui.MaxDistance = 50
	gui.Adornee = body
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = FONT
	label.TextScaled = true
	label.TextColor3 = Config.Rarities[info.rarity].color
	label.TextStrokeTransparency = 0.3
	label.Text = string.format("%s%s • Nv %d", info.name, if variant.name ~= "" then " " .. variant.name else "", level)
	label.Parent = gui
	gui.Parent = model
	return model
end

local function startPets()
	local folder = Instance.new("Folder")
	folder.Name = "PetsLocais"
	folder.Parent = workspace
	local followers: { [Player]: { key: string, models: { Model }, current: { CFrame } } } = {}

	local function rebuild(owner: Player)
		local old = followers[owner]
		if old then
			for _, model in old.models do
				model:Destroy()
			end
			followers[owner] = nil
		end
		local key = owner:GetAttribute("EquippedPets")
		if type(key) ~= "string" or key == "" then
			return
		end
		local entry = { key = key, models = {}, current = {} }
		for _, item in string.split(key, ",") do
			local parts = string.split(item, ":")
			local info = Config.Pets[parts[1]]
			if info and #entry.models < #PET_OFFSETS then
				local variant = Formulas.petVariant(if parts[2] and parts[2] ~= "" then parts[2] else nil)
				local model = buildPet(info, variant, tonumber(parts[3]) or 1)
				model.Parent = folder
				table.insert(entry.models, model)
			end
		end
		followers[owner] = entry
	end

	local function watch(owner: Player)
		owner:GetAttributeChangedSignal("EquippedPets"):Connect(function()
			rebuild(owner)
		end)
		rebuild(owner)
	end

	for _, owner in Players:GetPlayers() do
		watch(owner)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(function(owner)
		local entry = followers[owner]
		if entry then
			for _, model in entry.models do
				model:Destroy()
			end
			followers[owner] = nil
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		local t = os.clock()
		for owner, entry in followers do
			local character = owner.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") then
				local rootCF = root.CFrame
				local flat = CFrame.lookAt(rootCF.Position, rootCF.Position + Vector3.new(rootCF.LookVector.X, 0, rootCF.LookVector.Z + 1e-4))
				for index, model in entry.models do
					local offset = PET_OFFSETS[index]
					local bob = math.sin(t * 5 + index) * 0.2
					local target = flat * CFrame.new(offset.X, -2.3 + bob, offset.Z)
					local current = entry.current[index] or target
					current = current:Lerp(target, math.min(1, dt * 7))
					entry.current[index] = current
					model:PivotTo(current)
				end
			end
		end
	end)
end

---------------------------------------------------------------------
-- Botoes "Colher" e "Roubar"
---------------------------------------------------------------------

local function plotOf(instance: Instance): Instance?
	local node = instance.Parent
	while node and node ~= workspace do
		if node:GetAttribute("PlotIndex") ~= nil then
			return node
		end
		node = node.Parent
	end
	return nil
end

local function startPromptFilter()
	local prompts: { [ProximityPrompt]: boolean } = setmetatable({}, { __mode = "k" }) :: any
	local watchedPlots: { [Instance]: boolean } = {}

	local function evaluate(prompt: ProximityPrompt)
		local owner = prompt:GetAttribute("OwnerUserId")
		if type(owner) ~= "number" or owner == 0 then
			return
		end
		if owner == player.UserId then
			prompt.Enabled = true
			if prompt:GetAttribute("Kind") == "Harvest" then
				prompt.ActionText = "Colher"
				prompt.HoldDuration = 0
			end
			return
		end
		local canSteal = prompt:GetAttribute("Kind") == "Harvest"
			and workspace:GetAttribute("StealingEnabled") == true
			and workspace:GetAttribute("Phase") == "Night"
			and player:GetAttribute("Carrying") ~= true
		local plot = plotOf(prompt)
		if plot and plot:GetAttribute("Locked") == true then
			canSteal = false
		end
		prompt.Enabled = canSteal
		if canSteal then
			prompt.ActionText = "Roubar"
			prompt.HoldDuration = Config.Stealing.holdDuration
		end
	end

	local function evaluateAll()
		for prompt in prompts do
			if prompt.Parent then
				evaluate(prompt)
			end
		end
	end

	local function track(instance: Instance)
		if instance:IsA("ProximityPrompt") and instance:GetAttribute("OwnerUserId") ~= nil then
			prompts[instance] = true
			local plot = plotOf(instance)
			if plot and not watchedPlots[plot] then
				watchedPlots[plot] = true
				plot:GetAttributeChangedSignal("Locked"):Connect(evaluateAll)
			end
			evaluate(instance)
		end
	end

	workspace.DescendantAdded:Connect(track)
	for _, descendant in workspace:GetDescendants() do
		track(descendant)
	end
	workspace:GetAttributeChangedSignal("Phase"):Connect(evaluateAll)
	player:GetAttributeChangedSignal("Carrying"):Connect(evaluateAll)
end

