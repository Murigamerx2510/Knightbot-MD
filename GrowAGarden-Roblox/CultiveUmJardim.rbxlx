	{ requires = { "Shocked", "Ignited" }, result = "Plasma" },
	{ requires = { "Eclipsed", "Bloodlit" }, result = "Abyssal" },
	{ requires = { "Celestial", "Starstruck" }, result = "Cosmic" },
}

